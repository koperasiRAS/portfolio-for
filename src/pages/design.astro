---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getDesigns } from '../utils/content.js';

const designs = getDesigns();
---

<BaseLayout
  title="Brand Design Portfolio | Frame Of Rangga"
  description="Portofolio brand design Rangga Danuarta brand identity, social media content, poster, dan visual branding yang memorable dan elegan."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-design.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/design"
  hasGlightbox={true}
>
  <Navbar slot="navbar" activePage="design" />

  <!-- PAGE HERO Centered -->
  <section class="page-hero stitch-hero" transition:animate="fade">
    <div class="page-hero-bg-glow" aria-hidden="true"></div>
    <div class="stitch-hero-centered">
      <h1 class="stitch-hero-title">
        Visual <span class="stitch-hero-accent">Synthesis</span><br />
        &amp; Brand Narrative
      </h1>
      <p class="stitch-hero-desc">
        Curated collection of identity systems, editorial layouts, poster design, and digital experiences defined by structural precision and creative intentionality.
      </p>
    </div>
  </section>

  <!-- DESIGN GALLERY Stitch Editorial Bento Grid -->
  <section class="gallery-section" transition:animate="fade">

    <!-- Filter Bar -->
    <div class="filter-bar fx-layer fade-up" aria-label="Filter by category">
      <button class="filter-btn fx-chip active" data-filter="all">Semua</button>
      <button class="filter-btn fx-chip" data-filter="brand">Brand Identity</button>
      <button class="filter-btn fx-chip" data-filter="social">Social Media</button>
      <button class="filter-btn fx-chip" data-filter="poster">Poster</button>
      <button class="filter-btn fx-chip" data-filter="advertising">Advertising</button>
    </div>

    <!-- Bento Grid 12-col, editorial layout -->
    <div class="stitch-design-grid fade-up">
      {designs.map((item) => {
        const imgSrc = item.image || item.imagePath;
        const cat = item.category ? item.category.toLowerCase() : 'all';
        const badgeLabel = 
          cat.includes('brand') ? 'Branding' :
          cat.includes('social') ? 'Social Media' :
          cat.includes('poster') ? 'Poster' : 'Advertising';

        return (
          <a class="stitch-design-card glightbox"
             href={imgSrc}
             data-gallery="design-gallery"
             data-title={item.title}
             data-description={item.description || ''}
             data-category={cat}>
            <div class="stitch-design-img-wrap">
              <img
                src={imgSrc}
                alt={item.title}
                loading="lazy"
              />
            </div>
            <div class="stitch-design-card-overlay">
              <div class="stitch-design-card-badges">
                <span class={`stitch-badge-pill stitch-badge-${cat}`}>{badgeLabel}</span>
                <span class="stitch-badge-pill">2024</span>
              </div>
              <h3 class="stitch-design-card-title">{item.title}</h3>
              {item.description && (
                <p class="stitch-design-card-desc">{item.description}</p>
              )}
            </div>
          </a>
        );
      })}
    </div>

  </section>

  <Footer slot="footer" variant="minimal" />
</BaseLayout>

<style>
  /* =============================================
     STITCH DESIGN PAGE Scoped styles
     ============================================= */

  /* Hero Centered single column */
  .stitch-hero {
    padding: 140px 48px 80px;
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
  }

  .stitch-hero-centered {
    max-width: 720px;
    margin: 0 auto;
  }

  .stitch-hero-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.05;
    color: var(--text-primary);
    text-shadow: 0 0 30px rgba(163, 166, 255, 0.2);
    margin-bottom: 20px;
  }

  .stitch-hero-accent {
    color: var(--accent-primary);
  }

  .stitch-hero-desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
  }

  /* Filter Bar */
  .filter-bar {
    padding: 0 48px;
    margin-bottom: 48px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.08);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 22px;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: var(--surface-bright);
    color: var(--accent-primary);
    border-color: rgba(163, 166, 255, 0.15);
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: var(--accent-secondary-container);
    border-color: rgba(193, 128, 255, 0.3);
    color: #e9cdff;
  }

  /* Gallery Section */
  .gallery-section {
    padding: 0 48px 80px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .stitch-design-grid {
    column-count: 3;
    column-gap: 24px;
  }

  /* Card base */
  .stitch-design-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.06);
    cursor: pointer;
    display: inline-block;
    width: 100%;
    margin-bottom: 24px;
    break-inside: avoid;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease,
                opacity 0.3s ease;
  }

  .stitch-design-card:hover {
    transform: translateY(-5px);
    border-color: rgba(163, 166, 255, 0.25);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
  }

  /* Image */
  .stitch-design-img-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .stitch-design-img-wrap img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-design-card:hover .stitch-design-img-wrap img {
    transform: scale(1.04);
  }

  /* Overlay */
  .stitch-design-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(6, 14, 32, 0.95) 0%,
      rgba(6, 14, 32, 0.6) 40%,
      rgba(6, 14, 32, 0.1) 70%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .stitch-design-card:hover .stitch-design-card-overlay {
    opacity: 1;
  }

  /* Badges */
  .stitch-design-card-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  .stitch-badge-pill {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .stitch-badge-brand {
    background: rgba(163, 166, 255, 0.15);
    color: var(--accent-primary);
    border-color: rgba(163, 166, 255, 0.3);
  }

  .stitch-badge-social {
    background: rgba(255, 128, 200, 0.15);
    color: #ff80c8;
    border-color: rgba(255, 128, 200, 0.3);
  }

  .stitch-badge-poster {
    background: rgba(128, 255, 200, 0.15);
    color: #80ffc8;
    border-color: rgba(128, 255, 200, 0.3);
  }

  .stitch-badge-advertising {
    background: rgba(255, 200, 100, 0.15);
    color: #ffc864;
    border-color: rgba(255, 200, 100, 0.3);
  }

  /* Title & Desc */
  .stitch-design-card-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 6px;
  }

  .stitch-design-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .stitch-design-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .stitch-hero {
      padding: 120px 24px 40px;
    }
    .filter-bar {
      padding: 0 20px;
      gap: 8px;
    }
    .stitch-design-grid {
      column-count: 1;
      padding: 0 20px;
    }
  }
</style>

<script is:inline>
  // ---------- GLIGHTBOX INITIALIZATION ----------
  function initDesignLightbox() {
    if (typeof GLightbox !== 'undefined') {
      GLightbox({
        selector: '.glightbox',
        touchNavigation: true,
        loop: true,
      });
    } else {
      setTimeout(initDesignLightbox, 100);
    }
  }

  // ---------- DESIGN CATEGORY FILTER ----------
  function initDesignFilter() {
    const filterBar = document.querySelector('.filter-bar');
    if (!filterBar) return;

    const btns = filterBar.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.stitch-design-card');

    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const selectedFilter = btn.getAttribute('data-filter') ? btn.getAttribute('data-filter').toLowerCase() : 'all';

        // Update active button
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter design cards
        cards.forEach(card => {
          const cat = card.getAttribute('data-category') ? card.getAttribute('data-category').toLowerCase() : '';
          if (selectedFilter === 'all' || cat.includes(selectedFilter) || selectedFilter.includes(cat)) {
            card.style.display = 'inline-block';
            card.style.opacity = '1';
          } else {
            card.style.display = 'none';
            card.style.opacity = '0';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initDesignLightbox();
    initDesignFilter();
  });

  document.addEventListener('astro:page-load', () => {
    initDesignLightbox();
    initDesignFilter();
  });
</script>
