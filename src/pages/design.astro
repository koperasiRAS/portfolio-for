---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
---

<BaseLayout
  title="Design & Brand Identity | FRAME OF RANGGA"
  description="Visual identity systems, typography, luxury packaging, and brand design portfolios curated by Rangga Danuarta."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/design"
>
  <Navbar slot="navbar" activePage="design" />

  <style is:global>
    .design-filter-btn {
      cursor: pointer;
      user-select: none;
    }
    .design-filter-btn.filter-btn {
      transition: all 0.2s ease;
    }
    .design-filter-active {
      @apply bg-primary-container text-on-primary-container shadow-md;
    }
    .design-card {
      transition: all 0.3s ease;
    }
  </style>

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- ============================================================
           01. HERO SECTION
           ============================================================ -->
      <section class="relative w-full overflow-hidden px-margin-mobile md:px-margin pt-space-2xl md:pt-space-3xl pb-space-2xl">
        <div class="absolute -top-24 -left-20 w-96 h-96 bg-primary-container/10 rounded-full blur-[140px] pointer-events-none"></div>
        <div class="absolute top-1/3 -right-24 w-80 h-80 bg-tertiary-container/15 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto w-full flex flex-col gap-space-xl">
          <!-- Discipline Tag & Index -->
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <div class="flex items-center gap-space-sm bg-surface-container-low/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
              <span class="font-label-md text-label-md text-primary tracking-wider uppercase">05 / 06 • Brand Identity &amp; Design Systems</span>
            </div>
            <div class="flex items-center gap-space-sm">
              <span class="font-label-sm text-label-sm text-outline uppercase tracking-widest">DISPATCH NO. 04-D</span>
              <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
              <span class="font-label-sm text-label-sm text-secondary-fixed">ARCHIVE 2021—2024</span>
            </div>
          </div>

          <!-- Main Heading & Monograph Introduction -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-end">
            <div class="lg:col-span-8 flex flex-col gap-space-sm">
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface">Design.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
                Visual identity, branding, art direction, and meaningful digital experiences. Crafted through rigorous modernist typography, sculptural physical collateral, and high-fidelity design systems.
              </p>
            </div>
            <!-- Metrics Bar Capsule -->
            <div class="lg:col-span-4 w-full">
              <div class="bg-surface-container-lowest/80 backdrop-blur-xl p-space-md rounded-lg flex flex-col gap-space-md shadow-2xl">
                <div class="grid grid-cols-3 divide-x divide-transparent gap-space-sm text-center">
                  <div class="flex flex-col items-center">
                    <span class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">24<span class="text-primary">+</span></span>
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider mt-1">Identities</span>
                  </div>
                  <div class="flex flex-col items-center">
                    <span class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">08</span>
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider mt-1">Awards</span>
                  </div>
                  <div class="flex flex-col items-center">
                    <span class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">11</span>
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider mt-1">Cities</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-space-xs text-on-surface-variant/70">
                  <span class="font-label-sm text-label-sm">INDEX CRITERIA: LUXURY &amp; ARCHITECTURE</span>
                  <span class="material-symbols-outlined text-sm">verified</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Interactive Filter Capsule Row -->
          <div class="flex flex-wrap items-center gap-space-xs pt-space-sm">
            <button class="design-filter-btn filter-btn active px-space-md py-space-xs rounded-full bg-surface-container-highest text-on-surface font-label-md text-label-md flex items-center gap-space-xs shadow-md border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="all">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              <span>All (06)</span>
            </button>
            <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="branding">
              <span>Branding</span>
            </button>
            <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="uiux">
              <span>UI/UX</span>
            </button>
            <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="print">
              <span>Print</span>
            </button>
            <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="artdirection">
              <span>Art Direction</span>
            </button>
            <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="digital">
              <span>Digital</span>
            </button>
          </div>
        </div>
      </section>


      <!-- ============================================================
           02. LEAD SHOWCASE — LUMEN LABS
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin py-space-xl">
        <div class="max-w-7xl mx-auto w-full">
          <div class="relative bg-surface-container-lowest rounded-xl overflow-hidden shadow-2xl flex flex-col lg:flex-row group">
            <!-- Visual Column -->
            <div class="w-full lg:w-7/12 relative aspect-[16/10] lg:aspect-auto min-h-[420px] overflow-hidden">
              <img
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAXIJ1JqS2ROtzlb1tJT1nnG0SExWpNVuvhekPm0GEU9Bb_j3Twkq5pULya9TlhiMtXFcEgYWzDgMD-x2IX8Nl9Z4EYK0Xaa7OKFs63lv8-hXyrWKxErLys2HQ6QA67qsUyMI4Zvgcre6_pYw6AEhDeo09FRRRPQNpphGdsDACLyAWsz8xSIm-Ty7f6amQiYJqyTTNfii1gAI-rQKcJFXKzt5CQMfqTxs-ZSzIQmZf7q1Lmr9scp45W"
                alt="High-end luxury packaging set on dark architectural granite"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-surface-container-lowest"></div>
              <div class="absolute top-space-md left-space-md flex items-center gap-space-xs bg-surface-container-lowest/70 backdrop-blur-md px-space-md py-space-xs rounded-full">
                <span class="font-label-sm text-label-sm text-primary uppercase">CASE NO. 01</span>
                <span class="text-outline">/</span>
                <span class="font-label-sm text-label-sm text-on-surface">LEAD SHOWCASE</span>
              </div>
              <div class="absolute bottom-space-md left-space-md hidden sm:flex items-center gap-space-sm bg-surface-container-low/80 backdrop-blur-md px-space-md py-space-xs rounded-DEFAULT">
                <span class="font-label-sm text-label-sm text-secondary-fixed">DEBOSSED FOIL + COTTON 640GSM</span>
              </div>
            </div>
            <!-- Content Column -->
            <div class="w-full lg:w-5/12 p-space-lg md:p-space-2xl flex flex-col justify-between bg-surface-container-lowest">
              <div class="flex flex-col gap-space-md">
                <div class="flex items-center justify-between">
                  <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">Tokyo &amp; Zurich / 2024</span>
                  <span class="font-label-sm text-label-sm text-outline">ROLE: HEAD OF BRAND SYSTEM</span>
                </div>
                <div class="flex flex-col gap-space-xs">
                  <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">LUMEN Labs</span>
                  <h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold leading-tight">
                    Holistic Brand Identity &amp; Luxury Packaging System
                  </h2>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                  Engineered a multi-sensory brand universe for an advanced optical sensor research lab. The identity transitions effortlessly between scientific laboratory rigor and bespoke editorial tactile packaging featuring bespoke debossed black foil boxes, micro-perforated stationery, and an omni-channel physical-digital design token ecosystem.
                </p>
                <!-- Metrics Mini-Grid -->
                <div class="grid grid-cols-2 gap-space-sm pt-space-xs">
                  <div class="bg-surface-container p-space-sm rounded-DEFAULT">
                    <span class="font-label-sm text-label-sm text-outline uppercase block">Deliverables</span>
                    <span class="font-body-sm text-body-sm text-on-surface font-medium">18 Collateral SKUs</span>
                  </div>
                  <div class="bg-surface-container p-space-sm rounded-DEFAULT">
                    <span class="font-label-sm text-label-sm text-outline uppercase block">Recognition</span>
                    <span class="font-body-sm text-body-sm text-on-surface font-medium">TDC Tokyo Annual '24</span>
                  </div>
                </div>
              </div>
              <div class="pt-space-lg flex items-center justify-between">
                <a
                  class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-primary text-on-primary font-headline-sm text-headline-sm rounded-full shadow-lg border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] hover:bg-primary-fixed transition-all group-hover:translate-x-1"
                  href={waLink('design')}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Explore Case Study</span>
                  <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </a>
                <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface">
                  <span class="material-symbols-outlined text-lg">open_in_new</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- ============================================================
           03. CURATED IDENTITY ARCHIVES (BENTO GRID)
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin py-space-2xl">
        <div class="max-w-7xl mx-auto w-full flex flex-col gap-space-2xl">
          <!-- Section Header -->
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-md">
            <div>
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest block mb-2">CURATED MONOGRAPHS</span>
              <h2 class="font-headline-lg text-headline-lg text-on-surface">Curated Identity Archives</h2>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm">
              Archived physical, spatial, and dynamic digital works selected for structural restraint and typographic depth.
            </p>
          </div>

          <!-- Grid Composition: Bento-influenced asymmetric layout -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-space-lg" id="design-grid">

            <!-- Project 01: Aura Studio Singapore (Col 7) -->
            <article class="md:col-span-7 design-card stitch-design-card bg-surface-container-lowest rounded-xl overflow-hidden shadow-xl flex flex-col group" data-category="branding artdirection">
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-container">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAPw3GR96YKAYEmvx8S-eDx_AWltjXi-QZ6NMjhf0XN_UbTLdxS7sBagAdsOq2chobi_R558IpvI0t54L3xZRF4rhE85chYlehQJRsTZbbABBUaGvTxwA7CVXcps6k0yhTatmTOinWiDqCScazJPw4QVlSxN9E1vOqx4f_BqYysE5XNwQh3EtG8SSjZAN_8wGD6JLdlW6jmfA-yWfbha8zth7jFciJUYzrMGG-S82cVVIrw7j9et65J"
                  alt="Architectural monograph and visual identity for Aura Studio Singapore"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-space-md left-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
                  <span class="font-label-sm text-label-sm text-secondary uppercase">SPATIAL / ARCHITECTURE</span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col justify-between flex-grow gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline">SINGAPORE • 2024</span>
                    <span class="font-label-sm text-label-sm text-primary">MONOGRAPH &amp; SIGNAGE</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface font-semibold group-hover:text-primary transition-colors">
                    Aura Studio Singapore
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                    Architectural visual identity &amp; spatial lighting monograph. A quiet Swiss typographic framework grounded by raw concrete textures and custom laser-engraved wayfinding plates.
                  </p>
                </div>
                <div class="flex items-center justify-between pt-space-xs">
                  <span class="font-label-sm text-label-sm text-outline uppercase">Custom Typeface: Aura Grotesk Display</span>
                  <a class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-all" href="#" aria-label="View project">
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- Project 02: Nusantara Coffee Co. (Col 5) -->
            <article class="md:col-span-5 design-card stitch-design-card bg-surface-container-lowest rounded-xl overflow-hidden shadow-xl flex flex-col group" data-category="branding packaging">
              <div class="relative aspect-[4/5] overflow-hidden bg-surface-container">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBfvxlhxt6SImynGgs7lQgP9UWmX6cKveGt-En8P84HmhhHh4MgqW_KLY4bySSnCWdUgyDzNvLxIgt8kt0ipHlvMzPg-qBCQyk4WoUbix_co-mwFwN_T1QJ8nKaIvo84hTtS4KivXvoIETI1ein5WBC6hTkELFus0nIve08HorQxYBrn2LrbeyIN5hw3e-32Mgr6kS7KT4v36nHmgg8yVSUBmmtmwQD-5NXLz71K9Vq2oqnXGi-g4U"
                  alt="Eco-luxe coffee packaging for Nusantara Coffee Co."
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-space-md left-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
                  <span class="font-label-sm text-label-sm text-secondary uppercase">SUSTAINABLE PACKAGING</span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col justify-between flex-grow gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline">JAKARTA • 2023</span>
                    <span class="font-label-sm text-label-sm text-primary">REBRANDING</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface font-semibold group-hover:text-primary transition-colors">
                    Nusantara Coffee Co.
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                    Sustainable compostable packaging &amp; embossed copper heritage seals. Merging raw agrarian narratives with modernist Scandinavian packaging restraint.
                  </p>
                </div>
                <div class="flex items-center justify-between pt-space-xs">
                  <span class="font-label-sm text-label-sm text-outline uppercase">Plant-based Inks &amp; Hemp Fiber</span>
                  <a class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-all" href="#" aria-label="View project">
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- Project 03: The Silent Observer (Col 5) -->
            <article class="md:col-span-5 design-card stitch-design-card bg-surface-container-lowest rounded-xl overflow-hidden shadow-xl flex flex-col group" data-category="print artdirection">
              <div class="relative aspect-[4/5] overflow-hidden bg-surface-container">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCiIPOeLrjLT7M8kqvvhxuyk2S3uQv76x0sfuVjEwJdlmxWA52HIbuohQsPxsEVaIooaezkMOWtP2NmBRVxVF5BWyuanvrxYQAmVWCBe8EtwR0zXR0GK8kDVKMpFWY2jpyuVn25LRCIb15QKU9xSKbojhpIgCp7hhi1ci_dZnGzF9bznPVWW9FZClB3Irw--UFz6SzuPxAfYC4fJJpwc7n7twfcIm8VWyx3ri6D2U6zPJiGAM_3wi5t"
                  alt="High-fashion photographic monograph book"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-space-md left-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
                  <span class="font-label-sm text-label-sm text-secondary uppercase">EDITORIAL BOOK DESIGN</span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col justify-between flex-grow gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline">BERLIN • 2023</span>
                    <span class="font-label-sm text-label-sm text-primary">PRINT EDITION</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface font-semibold group-hover:text-primary transition-colors">
                    The Silent Observer
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                    280-page photographic collection &amp; Swiss modernist typography. Bound in custom charcoal bookcloth with hand-applied foil title lettering.
                  </p>
                </div>
                <div class="flex items-center justify-between pt-space-xs">
                  <span class="font-label-sm text-label-sm text-outline uppercase">Limited Edition: 500 Copies</span>
                  <a class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-all" href="#" aria-label="View project">
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- Project 04: Kinetic Design System (Col 7) -->
            <article class="md:col-span-7 design-card stitch-design-card bg-surface-container-lowest rounded-xl overflow-hidden shadow-xl flex flex-col group" data-category="uiux digital">
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-container">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB8oAb3B1MbhRW-qYYrqxL_chjd-i023LTKa0NQlI4BtuH1z__-ZBZPi792dNkaFVH6FfRona_SeDZ887xpLu1HYycL6n-yGlay4KE0smemYcQf65PJEpUZboFk1DtqN-H4fH0xj5hsxCmXLioK80r5ugHFoEu8C075HfIshmA2UzE05RvYsbayQLMeZwj-wJ9pdy95Fp0uiUQvzdqxvvSSJ8AtcwiJJ4BSbhP_gEPDmcKU1w4XHaby"
                  alt="Dynamic dark mode kinetic design system on screen"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-space-md left-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
                  <span class="font-label-sm text-label-sm text-secondary uppercase">DESIGN SYSTEM &amp; TOKENS</span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col justify-between flex-grow gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline">SAN FRANCISCO • 2024</span>
                    <span class="font-label-sm text-label-sm text-primary">MULTI-CHANNEL</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface font-semibold group-hover:text-primary transition-colors">
                    Kinetic Design System
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                    Responsive motion modules &amp; multi-channel tokens built for enterprise fintech application. Scaled across iOS, visionOS, and responsive web environments.
                  </p>
                </div>
                <div class="flex items-center justify-between pt-space-xs">
                  <span class="font-label-sm text-label-sm text-outline uppercase">Figma Tokens + React Components</span>
                  <a class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-all" href="#" aria-label="View project">
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </a>
                </div>
              </div>
            </article>

            <!-- Project 05: Verve Fragrance (Col 12 - Full Editorial Span) -->
