---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { getDesigns } from "../utils/content.js";

const designs = getDesigns();
const categories = [...new Set(designs.map(d => d.category).filter(Boolean))];
const totalDesigns = designs.length;

const heroFeature = designs.find(d => d.featuredHome) || designs[0];
const heroSrc = heroFeature?.imagePath || '/assets/design/placeholder.jpg';

function layoutClass(item) {
  if (item.layout === 'portrait') return 'aspect-[4/5]';
  if (item.layout === 'wide') return 'aspect-[16/9]';
  return 'aspect-square';
}

function colSpan(item, index) {
  if (item.layout === 'portrait') return 'md:col-span-5';
  if (item.layout === 'wide') return 'md:col-span-8';
  return 'md:col-span-6';
}
---

<BaseLayout
  title="Design & Brand Identity | FRAME OF RANGGA"
  description="Visual identity systems, typography, luxury packaging, and brand design portfolios curated by Rangga Danuarta."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/design"
  hasGlightbox={true}
>
  <Navbar slot="navbar" activePage="design" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- ============================================================
           01. HERO SECTION
           ============================================================ -->
      <section class="relative w-full overflow-hidden px-margin-mobile md:px-margin pt-space-2xl md:pt-space-3xl pb-space-2xl">
        <div class="absolute -top-24 -left-20 w-96 h-96 bg-primary-container/10 rounded-full blur-[140px] pointer-events-none"></div>
        <div class="absolute top-1/3 -right-24 w-80 h-80 bg-tertiary-container/15 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto w-full flex flex-col gap-space-xl">
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <div class="flex items-center gap-space-sm bg-surface-container-low/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
              <span class="font-label-md text-label-md text-primary tracking-wider uppercase">05 / 06 • Brand Identity &amp; Design Systems</span>
            </div>
            <div class="flex items-center gap-space-sm">
              <span class="font-label-sm text-label-sm text-outline uppercase tracking-widest">DISPATCH NO. 04-D</span>
              <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
              <span class="font-label-sm text-label-sm text-secondary-fixed">ARCHIVE 2021—2026</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-end">
            <div class="lg:col-span-8 flex flex-col gap-space-sm">
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface" data-i18n="design.title">Design.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed" data-i18n="design.heroSub">
                Visual identity, branding, art direction, and meaningful digital experiences. Crafted through rigorous modernist typography, sculptural physical collateral, and high-fidelity design systems.
              </p>
            </div>
            <div class="lg:col-span-4 w-full">
              <div class="bg-surface-container-lowest/80 backdrop-blur-xl p-space-md rounded-lg flex flex-col gap-space-md shadow-2xl">
                <div class="grid grid-cols-3 divide-x divide-transparent gap-space-sm text-center">
                  <div class="flex flex-col items-center">
                    <span class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">{totalDesigns}<span class="text-primary">+</span></span>
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider mt-1">Identities</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Interactive Filter Capsule Row (dynamic from CMS) -->
          {totalDesigns > 0 && (
          <div class="flex flex-wrap items-center gap-space-xs pt-space-sm" id="design-filter-bar">
            <button class="design-filter-btn filter-btn active px-space-md py-space-xs rounded-full bg-surface-container-highest text-on-surface font-label-md text-label-md flex items-center gap-space-xs shadow-md border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter="all">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              <span>All ({totalDesigns})</span>
            </button>
            {categories.map(cat => (
              <button class="design-filter-btn filter-btn px-space-md py-space-xs rounded-full bg-surface-container-low/70 hover:bg-surface-container-high/60 text-on-surface-variant hover:text-on-surface font-label-md text-label-md border border-outline-variant/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all" type="button" data-filter={cat.toLowerCase()}>
                <span>{cat}</span>
              </button>
            ))}
          </div>
          )}
        </div>
      </section>

      <!-- ============================================================
           02. FEATURED DESIGN HERO
           ============================================================ -->
      {heroFeature ? (
      <section class="w-full px-margin-mobile md:px-margin py-space-xl">
        <div class="max-w-7xl mx-auto w-full">
          <div class="design-card relative bg-surface-container-lowest rounded-xl overflow-hidden shadow-2xl flex flex-col lg:flex-row group" data-category={heroFeature.category?.toLowerCase() || ''}>
            <div class="w-full lg:w-7/12 relative aspect-[16/10] lg:aspect-auto min-h-[420px] overflow-hidden">
              <img
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                src={heroSrc}
                alt={heroFeature.title}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-surface-container-lowest"></div>
              <div class="absolute top-space-md left-space-md flex items-center gap-space-xs bg-surface-container-lowest/70 backdrop-blur-md px-space-md py-space-xs rounded-full">
                <span class="font-label-sm text-label-sm text-primary uppercase">FEATURED</span>
              </div>
            </div>
            <div class="w-full lg:w-5/12 p-space-lg md:p-space-2xl flex flex-col justify-between bg-surface-container-lowest">
              <div class="flex flex-col gap-space-md">
                <div class="flex items-center justify-between">
                  <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">{heroFeature.client || 'Studio Project'}</span>
                </div>
                <div class="flex flex-col gap-space-xs">
                  <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">{heroFeature.category}</span>
                  <h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold leading-tight">
                    {heroFeature.title}
                  </h2>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                  {heroFeature.description}
                </p>
              </div>
              <div class="pt-space-lg flex items-center justify-between">
                <a
                  class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-primary text-on-primary font-headline-sm text-headline-sm rounded-full shadow-lg border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] hover:bg-primary-fixed transition-all group-hover:translate-x-1"
                  href={waLink('design')}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Explore Case Study</span>
                  <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      ) : null}


      <!-- ============================================================
           03. CURATED IDENTITY ARCHIVES (dynamic from CMS)
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin py-space-2xl">
        <div class="max-w-7xl mx-auto w-full flex flex-col gap-space-2xl">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-md">
            <div>
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest block mb-2">CURATED MONOGRAPHS</span>
              <h2 class="font-headline-lg text-headline-lg text-on-surface">Curated Identity Archives</h2>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm">
              Archived physical, spatial, and dynamic digital works selected for structural restraint and typographic depth.
            </p>
          </div>

          {totalDesigns === 0 ? (
          <div class="w-full p-space-xl rounded-lg bg-surface-container-low/60 text-center">
            <p class="font-body-md text-on-surface-variant">No designs published yet. Manage your archive in the CMS portal.</p>
          </div>
          ) : (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-space-lg" id="design-grid">
            {designs.map((item, index) => (
            <article class={`design-card ${colSpan(item, index)} bg-surface-container-lowest rounded-xl overflow-hidden shadow-xl flex flex-col group`} data-category={item.category?.toLowerCase() || ''}>
              <div class={`relative w-full ${layoutClass(item)} overflow-hidden bg-surface-container`}>
                <img
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  src={item.imagePath || '/assets/design/placeholder.jpg'}
                  alt={item.title}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-space-md left-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
                  <span class="font-label-sm text-label-sm text-secondary uppercase">{item.category || 'Design'}</span>
                </div>
              </div>
              <div class="p-space-lg flex flex-col justify-between flex-grow gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  {item.client && (
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline">{item.client}</span>
                  </div>
                  )}
                  <h3 class="font-headline-md text-headline-md text-on-surface font-semibold group-hover:text-primary transition-colors">
                    {item.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            </article>
            ))}
          </div>
          )}
        </div>
      </section>


      <!-- ============================================================
           04. CTA SECTION
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin py-space-3xl">
        <div class="max-w-7xl mx-auto w-full">
          <div class="relative bg-surface-container-lowest p-space-xl md:p-space-3xl rounded-xl overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-space-2xl">
            <div class="absolute -top-32 -right-32 w-80 h-80 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
            <div class="flex flex-col gap-space-sm max-w-xl">
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest" data-i18n="design.ctaLabel">START A PROJECT</span>
              <h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold leading-tight" data-i18n="design.ctaTitle">
                Looking for brand identity or visual direction?
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant" data-i18n="design.ctaSub">
                Available for select brand commissions, packaging architecture, and design system direction worldwide.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row items-center gap-space-md w-full md:w-auto shrink-0">
              <a
                class="w-full sm:w-auto text-center px-space-xl py-space-sm bg-primary text-on-primary font-headline-sm text-headline-sm rounded-full shadow-lg border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] hover:bg-primary-fixed hover:scale-105 transition-all"
                href={waLink('design')}
                target="_blank"
                rel="noopener noreferrer"
              >
                Let's Talk &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- Filter Script -->
    <script is:inline>
      function initDesignFilters() {
        const filterBtns = document.querySelectorAll('.design-filter-btn');
        const designCards = document.querySelectorAll('.design-card');

        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            filterBtns.forEach(b => {
              b.classList.remove('filter-btn-active', 'bg-surface-container-highest');
              b.classList.add('bg-surface-container-low/70', 'text-on-surface-variant');
            });
            btn.classList.add('filter-btn-active', 'bg-surface-container-highest');
            btn.classList.remove('bg-surface-container-low/70', 'text-on-surface-variant');

            const cat = btn.getAttribute('data-filter');
            designCards.forEach(card => {
              const cardCat = card.getAttribute('data-category') || '';
              if (cat === 'all' || cardCat.includes(cat)) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });
      }

      document.addEventListener('astro:page-load', initDesignFilters);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDesignFilters);
      } else {
        initDesignFilters();
      }
    </script>
  </main>

  <!-- Monolithic Footer -->
  <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/20 pt-space-3xl pb-space-2xl mt-space-3xl">
    <div class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto flex flex-col gap-space-2xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-space-xl">
        <div class="md:col-span-5 flex flex-col gap-space-md">
          <span class="font-headline-md text-headline-md uppercase tracking-tight text-on-surface">FRAME OF RANGGA</span>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Multi-disciplinary visual storyteller &amp; director operating across photography, cinematic direction, graphic systems, and spatial web experiences.
          </p>
          <div class="flex flex-wrap gap-space-xs pt-space-xs">
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Photography</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Film Direction</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Visual Identity</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Web Experiences</span>
          </div>
        </div>
        <div class="md:col-span-3 md:col-start-7 flex flex-col gap-space-sm">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Index</span>
          <div class="flex flex-col gap-space-xs">
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/">Home</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/about">About Monograph</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/foto">Photo Archive</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/video">Video &amp; Film Reel</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/design">Design Identities</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/website">Interactive Web</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">Inquiries &amp; Booking</a>
          </div>
        </div>
        <div class="md:col-span-3 flex flex-col gap-space-sm">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Dispatches</span>
          <div class="flex flex-col gap-space-xs">
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer">Instagram (@rggadnrt)</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="https://tiktok.com/@madebyrangga" target="_blank" rel="noopener noreferrer">TikTok (@madebyrangga)</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">WhatsApp Direct</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="mailto:frameofrangga@gmail.com">frameofrangga@gmail.com</a>
          </div>
          <div class="mt-space-md p-space-md rounded bg-surface-container-low/70 border border-outline-variant/20">
            <p class="font-headline-sm text-headline-sm text-primary">Create. Capture. Inspire.</p>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-space-xs">Curated cinematic showcase edition 2026</p>
          </div>
        </div>
      </div>
      <div class="pt-space-lg border-t border-outline-variant/10 flex flex-col md:flex-row items-center justify-between gap-space-md">
        <span class="font-label-sm text-label-sm text-outline">&copy; {new Date().getFullYear()} FRAME OF RANGGA. All rights reserved.</span>
        <div class="flex items-center gap-space-lg font-label-sm text-label-sm text-outline">
          <span>Jakarta, Indonesia (WIB GMT+7)</span>
          <span>Cinematic Darkroom Specification</span>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
