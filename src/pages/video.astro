---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { getVideos } from "../utils/content.js";

const videos = getVideos();
const categories = [...new Set(videos.map(v => v.category).filter(Boolean))];
const totalVideos = videos.length;

const heroFeature = videos.find(v => v.isFeatured) || videos[0];
const heroSrc = heroFeature?.thumbnailPath || '/assets/thumbnails/thumbnail_wedding.png';
---

<BaseLayout
  title="Video & Film Direction | FRAME OF RANGGA"
  description="Cinematic film direction, documentaries, brand films, and motion reels directed by Rangga Danuarta."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/video"
  bodyClass="bg-[background] text-[on-surface] selection:bg-[primary-container] selection:text-[on-primary-container] antialiased"
>
  <Navbar slot="navbar" activePage="video" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- Top Atmospheric Gradient Scrim -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[360px] bg-[primary-container]/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-20 right-10 w-[400px] h-[300px] bg-[tertiary]/5 rounded-full blur-[100px] pointer-events-none"></div>

        <!-- ============================================================
             01. EDITORIAL HEADER SECTION
             ============================================================ -->
        <section class="relative w-full max-w-7xl mx-auto px-4 md:px-8 pt-10 md:pt-16 pb-6 flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-ping"></span>
            <span class="font-label-sm text-label-sm text-primary">Film Direction Archive — 04</span>
            <span class="text-outline-variant">/</span>
            <span class="font-label-sm text-label-sm text-outline">2024—2026 Reel</span>
          </div>

          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface" data-i18n="video.title">Video.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mt-1" data-i18n="video.heroSub">
                Short films, documentaries, visual stories, and cinematic motion. Atmospheric narratives captured across 35mm and anamorphic cinema formats.
              </p>
            </div>
            <div class="flex items-center gap-4 pb-1">
              <div class="flex flex-col items-start md:items-end">
                <span class="font-label-md text-label-md text-on-surface">{totalVideos} Curated Cuts</span>
                <span class="font-label-sm text-label-sm text-outline">DCI 4K • 2.39:1 Scope</span>
              </div>
            </div>
          </div>

          <!-- Category Filter Pills (dynamic from CMS) -->
          {totalVideos > 0 && (
          <div class="flex items-center gap-1.5 overflow-x-auto pb-2 pt-3" id="video-filter-bar">
            <button class="video-filter-btn active px-4 py-1.5 rounded-full font-label-md text-label-md transition-all flex items-center gap-1.5 bg-primary-container text-on-primary-container shadow-md border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] cursor-pointer" data-filter="all">
              <span class="w-1.5 h-1.5 rounded-full bg-primary-fixed"></span>
              <span>ALL</span>
            </button>
            {categories.map(cat => (
              <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter={cat.toLowerCase()}>
                <span class="uppercase">{cat}</span>
              </button>
            ))}
          </div>
          )}
        </section>

        <!-- ============================================================
             02. FEATURED MASTERWORK HERO
             ============================================================ -->
        {heroFeature ? (
        <section class="w-full max-w-7xl mx-auto px-4 md:px-8 pt-2 pb-14">
          <div class="group relative w-full aspect-[16/9] md:aspect-[21/9] rounded-2xl overflow-hidden bg-[surface-container-lowest] shadow-2xl transition-all duration-700 border border-[outline-variant]/25">
            <img
              class="w-full h-full object-cover scale-[1.01] group-hover:scale-105 transition-transform duration-1000 ease-out"
              src={heroSrc}
              alt={heroFeature.title}
            />

            <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-lowest] via-[surface-container-lowest]/40 to-transparent opacity-90 group-hover:opacity-75 transition-opacity"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[surface-container-lowest]/80 via-transparent to-[surface-container-lowest]/50"></div>

            <!-- Cinema Status Top Badges -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <div class="flex items-center gap-2 bg-surface-container-lowest/70 backdrop-blur-md px-4 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
                <span class="font-label-sm text-label-sm tracking-wider uppercase text-on-surface">FEATURED • {heroFeature.year || '2026'}</span>
              </div>
            </div>

            <!-- Central Play Trigger -->
            <div class="absolute inset-0 flex items-center justify-center">
              <a
                type="button"
                aria-label={`Play ${heroFeature.title}`}
                class="video-play-trigger group/btn relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-[surface-container-lowest]/70 backdrop-blur-xl border border-[outline-variant]/30 shadow-2xl hover:bg-[primary-container] transition-all duration-300 transform group-hover:scale-110 cursor-pointer"
                href={heroFeature.videoUrl || '#'}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="absolute -inset-2 rounded-full bg-[primary-container]/20 blur-md group-hover/btn:bg-[primary-container]/40 transition-all"></div>
                <span class="material-symbols-outlined text-on-surface group-hover/btn:text-white text-display-md md:text-display-lg translate-x-0.5 transition-colors">
                  play_arrow
                </span>
              </a>
            </div>

            <!-- Bottom Metadata Plate -->
            <div class="absolute bottom-0 inset-x-0 p-6 md:p-10 flex flex-col md:flex-row md:items-end justify-between gap-4 pointer-events-auto">
              <div class="flex flex-col gap-1.5 max-w-2xl">
                <div class="flex items-center gap-2">
                  <span class="px-space-sm py-space-xs rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm tracking-wider uppercase">{heroFeature.category || 'Film'}</span>
                </div>
                <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl text-[on-surface] font-semibold tracking-tight">
                  {heroFeature.title}
                </h2>
                <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2 md:line-clamp-none">
                  {heroFeature.description}
                </p>
              </div>
              {heroFeature.duration && (
              <div class="flex items-center gap-4 shrink-0">
                <div class="flex flex-col font-['JetBrains_Mono'] text-xs text-[secondary] bg-[surface-container-low]/85 backdrop-blur-md px-4 py-2.5 rounded-xl border border-[outline-variant]/20 gap-1">
                  <div class="flex items-center justify-between gap-6">
                    <span class="text-[outline]">RUNTIME</span>
                    <span class="text-[on-surface] font-medium">{heroFeature.duration}</span>
                  </div>
                </div>
              </div>
              )}
            </div>
          </div>
        </section>
        ) : (
        <section class="w-full max-w-7xl mx-auto px-4 md:px-8 pt-2 pb-14">
          <div class="w-full p-8 rounded-2xl bg-surface-container-low/60 text-center">
            <p class="font-body-md text-on-surface-variant">No videos published yet. Manage your reel from the CMS portal.</p>
          </div>
        </section>
        )}


        <!-- ============================================================
             03. MAIN VIDEO CATALOG GRID (dynamic from CMS)
             ============================================================ -->
        <section class="w-full max-w-7xl mx-auto px-4 md:px-8 pb-20 flex flex-col gap-8">
          {totalVideos > 1 && (
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <span class="font-['JetBrains_Mono'] text-xs uppercase tracking-wider text-[outline]">Selected Catalog</span>
              <h3 class="font-['Hanken_Grotesk'] text-2xl sm:text-3xl font-semibold text-[on-surface]">Cinematic Works &amp; Motion</h3>
            </div>
            <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-[outline]">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[tertiary]"></span> {totalVideos} Works Available</span>
            </div>
          </div>
          )}

          {totalVideos === 0 ? (
          <div class="w-full p-8 rounded-2xl bg-surface-container-low/60 text-center">
            <p class="font-body-md text-on-surface-variant">No videos published yet. Manage your reel from the CMS portal.</p>
          </div>
          ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8" id="video-collection-grid">
            {videos.map((item) => (
            <article class="video-grid-item group flex flex-col bg-[surface-container-low] rounded-2xl overflow-hidden border border-[outline-variant]/20 transition-all duration-500 hover:-translate-y-1 hover:border-[primary]/40 shadow-xl" data-category={item.category?.toLowerCase() || ''}>
              <div class="relative aspect-video w-full overflow-hidden bg-[surface-container-lowest]">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src={item.thumbnailPath || '/assets/thumbnails/thumbnail_wedding.png'}
                  alt={item.title}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-low] via-transparent to-[surface-container-lowest]/30"></div>
                {item.duration && (
                <div class="absolute top-3 left-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-xs text-[on-surface] flex items-center gap-1.5 border border-[outline-variant]/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-[tertiary]"></span>
                  <span>{item.duration}</span>
                </div>
                )}
                <div class="absolute top-space-md right-space-md bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xs rounded-full font-label-sm text-label-sm text-outline uppercase border border-outline-variant/20">
                  {item.category || 'FILM'}
                </div>
                <a
                  type="button"
                  class="video-play-trigger absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
                  href={item.videoUrl || '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="w-14 h-14 rounded-full bg-[primary-container] flex items-center justify-center text-white shadow-xl transform scale-90 group-hover:scale-100 transition-transform">
                    <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                  </div>
                </a>
              </div>
              <div class="p-6 flex flex-col gap-2 flex-1 justify-between">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center justify-between">
                    <h4 class="font-['Hanken_Grotesk'] text-xl font-medium text-[on-surface] group-hover:text-[primary] transition-colors">{item.title}</h4>
                    {item.year && <span class="font-['JetBrains_Mono'] text-xs text-[outline]">{item.year}</span>}
                  </div>
                  <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2">
                    {item.description}
                  </p>
                </div>
              </div>
            </article>
            ))}
          </div>
          )}
        </section>

      </div>
    </div>

    <!-- Video Filter Script -->
    <script is:inline>
      function initVideoPage() {
        const filterBtns = document.querySelectorAll('.video-filter-btn');
        const videoCards = document.querySelectorAll('.video-grid-item');

        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            filterBtns.forEach(b => {
              b.classList.remove('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
              b.classList.add('bg-surface-container-low', 'text-secondary');
            });

            btn.classList.add('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
            btn.classList.remove('bg-surface-container-low', 'text-secondary');

            const cat = btn.getAttribute('data-filter');
            videoCards.forEach(card => {
              const cardCat = card.getAttribute('data-category') || '';
              if (cat === 'all' || cardCat.includes(cat)) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });
      }

      document.addEventListener('astro:page-load', initVideoPage);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVideoPage);
      } else {
        initVideoPage();
      }
    </script>
  </main>

  <!-- Monolithic Footer -->
  <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/20 pt-24 pb-10 mt-16">
    <div class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto flex flex-col gap-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5 flex flex-col gap-4">
          <span class="font-headline-md text-headline-md uppercase tracking-tight text-on-surface">FRAME OF RANGGA</span>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Multi-disciplinary visual storyteller &amp; director operating across photography, cinematic direction, graphic systems, and spatial web experiences.
          </p>
          <div class="flex flex-wrap gap-1.5 pt-1">
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-3 py-1 rounded-full">Photography</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-3 py-1 rounded-full">Film Direction</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-3 py-1 rounded-full">Visual Identity</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-3 py-1 rounded-full">Web Experiences</span>
          </div>
        </div>
        <div class="md:col-span-3 md:col-start-7 flex flex-col gap-3">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Index</span>
          <div class="flex flex-col gap-2 font-body-md text-body-md text-on-surface-variant">
            <a class="hover:text-on-surface transition-colors" href="/">Home</a>
            <a class="hover:text-on-surface transition-colors" href="/about">About Monograph</a>
            <a class="hover:text-on-surface transition-colors" href="/foto">Photo Archive</a>
            <a class="hover:text-on-surface transition-colors" href="/video">Video &amp; Film Reel</a>
            <a class="hover:text-on-surface transition-colors" href="/design">Design Identities</a>
            <a class="hover:text-on-surface transition-colors" href="/website">Interactive Web</a>
            <a class="hover:text-on-surface transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">Inquiries &amp; Booking</a>
          </div>
        </div>
        <div class="md:col-span-3 flex flex-col gap-3">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Dispatches</span>
          <div class="flex flex-col gap-2 font-body-md text-body-md text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer">Instagram (@rggadnrt)</a>
            <a class="hover:text-primary transition-colors" href="https://tiktok.com/@madebyrangga" target="_blank" rel="noopener noreferrer">TikTok (@madebyrangga)</a>
            <a class="hover:text-primary transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">WhatsApp Direct</a>
            <a class="hover:text-primary transition-colors" href="mailto:frameofrangga@gmail.com">frameofrangga@gmail.com</a>
          </div>
          <div class="mt-4 p-4 rounded bg-surface-container-low/70 border border-outline-variant/20">
            <p class="font-headline-sm text-headline-sm text-primary">Create. Capture. Inspire.</p>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">Curated cinematic showcase edition 2026</p>
          </div>
        </div>
      </div>
      <div class="pt-4 border-t border-outline-variant/10 flex flex-col md:flex-row items-center justify-between gap-4 font-label-sm text-label-sm text-outline">
        <span>© {new Date().getFullYear()} FRAME OF RANGGA. All rights reserved.</span>
        <div class="flex items-center gap-6">
          <span>Jakarta &amp; Depok, Indonesia (WIB GMT+7)</span>
          <span class="hidden sm:inline">Cinematic Darkroom Specification</span>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
