---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
---

<BaseLayout
  title="Video & Film Direction | FRAME OF RANGGA"
  description="Cinematic film direction, documentaries, brand films, and motion reels directed by Rangga Danuarta."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/video"
  bodyClass="bg-[background] text-[on-surface] selection:bg-[primary-container] selection:text-[on-primary-container] antialiased"
>
  <Navbar slot="navbar" activePage="video" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">
      
      <!-- Top Atmospheric Gradient Scrim -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[360px] bg-[primary-container]/10 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="absolute top-20 right-10 w-[400px] h-[300px] bg-[tertiary]/5 rounded-full blur-[100px] pointer-events-none"></div>

        <!-- ============================================================
             01. EDITORIAL HEADER SECTION
             ============================================================ -->
        <section class="relative w-full max-w-7xl mx-auto px-4 md:px-8 pt-10 md:pt-16 pb-6 flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[tertiary] animate-ping"></span>
            <span class="font-['JetBrains_Mono'] text-xs uppercase tracking-widest text-[primary]">Film Direction Archive — 04</span>
            <span class="text-[outline-variant]">/</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[outline]">2024—2026 Reel</span>
          </div>

          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface">Video.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mt-1">
                Short films, documentaries, visual stories, and cinematic motion. Atmospheric narratives captured across 35mm and anamorphic cinema formats.
              </p>
            </div>
            <div class="flex items-center gap-4 pb-1">
              <div class="flex flex-col items-start md:items-end">
                <span class="font-label-md text-label-md text-on-surface">18 Curated Cuts</span>
                <span class="font-label-sm text-label-sm text-outline">DCI 4K • 2.39:1 Scope</span>
              </div>
              <div class="hidden sm:flex items-center gap-1.5 p-1 rounded-full bg-surface-container-high/60">
                <button type="button" class="p-1.5 rounded-full bg-surface-container-highest text-primary transition-colors" title="Cinematic View">
                  <span class="material-symbols-outlined text-[18px]">movie</span>
                </button>
                <button type="button" class="p-1.5 rounded-full text-outline hover:text-on-surface transition-colors" title="Grid View">
                  <span class="material-symbols-outlined text-[18px]">grid_view</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Category Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-2 pt-3" id="video-filter-bar">
            <button class="video-filter-btn active px-4 py-1.5 rounded-full font-label-md text-label-md transition-all flex items-center gap-1.5 bg-primary-container text-on-primary-container shadow-md border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] cursor-pointer" data-filter="all">
              <span class="w-1.5 h-1.5 rounded-full bg-primary-fixed"></span>
              <span>ALL</span>
            </button>
            <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter="short-film">
              <span>SHORT FILM</span>
            </button>
            <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter="documentary">
              <span>DOCUMENTARY</span>
            </button>
            <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter="behind-the-scenes">
              <span>BEHIND THE SCENES</span>
            </button>
            <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter="commercial">
              <span>COMMERCIAL</span>
            </button>
            <button class="video-filter-btn px-4 py-1.5 rounded-full font-label-md text-label-md transition-all text-secondary hover:text-on-surface bg-surface-container-low/70 backdrop-blur-md border border-outline-variant/20 hover:border-outline-variant/30 hover:bg-surface-container-high cursor-pointer" data-filter="travel">
              <span>TRAVEL</span>
            </button>
          </div>
        </section>


        <!-- ============================================================
             02. FEATURED MASTERWORK HERO: THE LAST LIGHT
             ============================================================ -->
        <section class="w-full max-w-7xl mx-auto px-4 md:px-8 pt-2 pb-14">
          <div class="group relative w-full aspect-[16/9] md:aspect-[21/9] rounded-2xl overflow-hidden bg-[surface-container-lowest] shadow-2xl transition-all duration-700 border border-[outline-variant]/25">
            <!-- Cinema Film Image -->
            <img
              class="w-full h-full object-cover scale-[1.01] group-hover:scale-105 transition-transform duration-1000 ease-out"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCzaFNm6IGga_n7wqM5NahcRZEtts_AQw6Bhb67l-OG4GtEoCrGc_Cj9JkT7YjkU5d15qUZRl1xcPKvhNEvZhRjW1ASbj7eu67CaD7q9We-xEF7U1eDzYkkQr_5UU8TsbfRhKL7GyrGwEvQEKXpqvDWpBCc4ferzgn3PO0eppchgOAg25L-2DzHl155A-wKh2lJodF-GvFREWivRfoXOXeyiWV3zAtggam79qXqp5P5U_9ytl7pyfr-"
              alt="Cinematic widescreen film still with solitary figure at sunset"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-lowest] via-[surface-container-lowest]/40 to-transparent opacity-90 group-hover:opacity-75 transition-opacity"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[surface-container-lowest]/80 via-transparent to-[surface-container-lowest]/50"></div>

            <!-- Cinema Status Top Badges -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <div class="flex items-center gap-2 bg-surface-container-lowest/70 backdrop-blur-md px-4 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
                <span class="font-label-sm text-label-sm tracking-wider uppercase text-on-surface">PREMIERE RELEASE • 2026</span>
              </div>
              <div class="hidden sm:flex items-center gap-2 bg-surface-container-lowest/70 backdrop-blur-md px-4 py-1 rounded-full font-label-sm text-label-sm text-secondary">
                <span>ARRI ALEXA 35</span>
                <span class="text-outline-variant">•</span>
                <span>COOKE ANAMORPHIC /i</span>
                <span class="text-outline-variant">•</span>
                <span class="text-primary">4K MASTER</span>
              </div>
            </div>

            <!-- Central Play Trigger -->
            <div class="absolute inset-0 flex items-center justify-center">
              <button
                type="button"
                aria-label="Play The Last Light Short Film"
                class="video-play-trigger group/btn relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-[surface-container-lowest]/70 backdrop-blur-xl border border-[outline-variant]/30 shadow-2xl hover:bg-[primary-container] transition-all duration-300 transform group-hover:scale-110 cursor-pointer"
                data-title="The Last Light"
                data-desc="A poetic exploration of isolation, memory, and vanishing skylines across the remote archipelago of Nusa Penida. Directed and graded by Rangga."
                data-runtime="08:42"
                data-role="Director, Cinematographer &amp; Colorist"
                data-format="DCI 4K Scope • 2.39:1"
              >
                <div class="absolute -inset-2 rounded-full bg-[primary-container]/20 blur-md group-hover/btn:bg-[primary-container]/40 transition-all"></div>
                <span class="material-symbols-outlined text-[on-surface] group-hover/btn:text-white text-[36px] md:text-[44px] translate-x-0.5 transition-colors">
                  play_arrow
                </span>
              </button>
            </div>

            <!-- Bottom Metadata Plate -->
            <div class="absolute bottom-0 inset-x-0 p-6 md:p-10 flex flex-col md:flex-row md:items-end justify-between gap-4 pointer-events-auto">
              <div class="flex flex-col gap-1.5 max-w-2xl">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded-full bg-[primary-container] text-[on-primary-container] font-['JetBrains_Mono'] text-[10px] tracking-wider uppercase">Short Film</span>
                  <span class="font-['JetBrains_Mono'] text-xs text-[outline]">Official Selection • Festival Cut</span>
                </div>
                <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl text-[on-surface] font-semibold tracking-tight">
                  The Last Light
                </h2>
                <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2 md:line-clamp-none">
                  A poetic exploration of isolation, memory, and vanishing skylines across the remote archipelago of Nusa Penida. Directed and graded by Rangga.
                </p>
              </div>
              <div class="flex items-center gap-4 shrink-0">
                <div class="flex flex-col font-['JetBrains_Mono'] text-xs text-[secondary] bg-[surface-container-low]/85 backdrop-blur-md px-4 py-2.5 rounded-xl border border-[outline-variant]/20 gap-1">
                  <div class="flex items-center justify-between gap-6">
                    <span class="text-[outline]">RUNTIME</span>
                    <span class="text-[on-surface] font-medium">08:42</span>
                  </div>
                  <div class="flex items-center justify-between gap-6">
                    <span class="text-[outline]">DIRECTION</span>
                    <span class="text-[on-surface]">Rangga</span>
                  </div>
                  <div class="flex items-center justify-between gap-6">
                    <span class="text-[outline]">AUDIO</span>
                    <span class="text-[tertiary]">Dolby 5.1 Surround</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             03. MAIN VIDEO CATALOG GRID
             ============================================================ -->
        <section class="w-full max-w-7xl mx-auto px-4 md:px-8 pb-20 flex flex-col gap-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <span class="font-['JetBrains_Mono'] text-xs uppercase tracking-wider text-[outline]">Selected Catalog</span>
              <h3 class="font-['Hanken_Grotesk'] text-2xl sm:text-3xl font-semibold text-[on-surface]">Cinematic Works &amp; Motion</h3>
            </div>
            <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-[outline]">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[tertiary]"></span> 4 Works Available</span>
            </div>
          </div>

          <!-- Video Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8" id="video-collection-grid">
            
            <!-- Project 1: Beneath The Surface -->
            <article class="video-grid-item group flex flex-col bg-[surface-container-low] rounded-2xl overflow-hidden border border-[outline-variant]/20 transition-all duration-500 hover:-translate-y-1 hover:border-[primary]/40 shadow-xl" data-category="documentary">
              <div class="relative aspect-video w-full overflow-hidden bg-[surface-container-lowest]">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmUtK7xsfeAgaNR7qdYRy8WzxN9vLyI6Qp5D77Ac2EeblCc7f3-Ie-DcBR2xKeM_S-Gdq7ESl9RcznkuDhZ3AM2dAgZmcRp6ysgzmHt_c9QTqngxYOvnatfsKvJewvrWSKwOiMpz_ULHeiaDpZXR26e-g7pFm0pvgr6QV6Wz7-OqF1iMHjqLFd-talpvNjtMQ9eZtiCx-1sQmuAzMKFEvpxZxP54D81u7wzcrCZVliQPGxjZDpCJh0"
                  alt="Underwater documentary film still"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-low] via-transparent to-[surface-container-lowest]/30"></div>
                <div class="absolute top-3 left-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-xs text-[on-surface] flex items-center gap-1.5 border border-[outline-variant]/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-[tertiary]"></span>
                  <span>14:20</span>
                </div>
                <div class="absolute top-3 right-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-[10px] text-[outline] uppercase border border-[outline-variant]/20">
                  DOCUMENTARY
                </div>
                <button
                  type="button"
                  class="video-play-trigger absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
                  data-title="Beneath The Surface"
                  data-desc="An intimate environmental documentary tracking coral restoration pioneers off the shores of Raja Ampat."
                  data-runtime="14:20"
                  data-role="Director &amp; Underwater DP"
                  data-format="RED V-Raptor 8K VV"
                >
                  <div class="w-14 h-14 rounded-full bg-[primary-container] flex items-center justify-center text-white shadow-xl transform scale-90 group-hover:scale-100 transition-transform">
                    <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                  </div>
                </button>
              </div>
              <div class="p-6 flex flex-col gap-2 flex-1 justify-between">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center justify-between">
                    <h4 class="font-['Hanken_Grotesk'] text-xl font-medium text-[on-surface] group-hover:text-[primary] transition-colors">Beneath The Surface</h4>
                    <span class="font-['JetBrains_Mono'] text-xs text-[outline]">2025</span>
                  </div>
                  <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2">
                    An intimate environmental documentary tracking coral restoration pioneers off the shores of Raja Ampat.
                  </p>
                </div>
                <div class="pt-3 border-t border-[outline-variant]/15 flex items-center justify-between font-['JetBrains_Mono'] text-xs text-[secondary]">
                  <span class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-[primary]">videocam</span>
                    Director &amp; Cinematographer
                  </span>
                  <span class="text-[outline]">RED V-Raptor 8K</span>
                </div>
              </div>
            </article>

            <!-- Project 2: Jakarta in Motion -->
            <article class="video-grid-item group flex flex-col bg-[surface-container-low] rounded-2xl overflow-hidden border border-[outline-variant]/20 transition-all duration-500 hover:-translate-y-1 hover:border-[primary]/40 shadow-xl" data-category="travel">
              <div class="relative aspect-video w-full overflow-hidden bg-[surface-container-lowest]">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDkj5QQmQf3y44qapoDWx0B-2HqW_XSZ8ONPdtChRtiSWbvNuEvxcidtBVxfhXhCzoKiuLEZ-RSexgq8c8105FaZumjXgyiuNuVMYXFQxUWCILaCt3mDGKPu9HRZ5oA1Af2HGRNpSjngBXRF63rFa2xHcVyy_rvEBit9yYNUGr-dLAtDaevmqGFYs9xTgGipgI9TSJljtI1MkwTP0hRYrY9RAVpTQ6uDyzYMbzYH7FmCoqO2_MePuwl"
                  alt="Nighttime Jakarta skyline light trails"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-low] via-transparent to-[surface-container-lowest]/30"></div>
                <div class="absolute top-3 left-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-xs text-[on-surface] flex items-center gap-1.5 border border-[outline-variant]/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-[tertiary]"></span>
                  <span>04:15</span>
                </div>
                <div class="absolute top-3 right-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-[10px] text-[outline] uppercase border border-[outline-variant]/20">
                  CITY SYMPHONY
                </div>
                <button
                  type="button"
                  class="video-play-trigger absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
                  data-title="Jakarta in Motion"
                  data-desc="A non-stop kinetic exploration of Southeast Asia's dense metropolis through hyperlapse and ambient field audio."
                  data-runtime="04:15"
                  data-role="Director &amp; Hyperlapse DP"
                  data-format="Sony FX6 Cinema Line"
                >
                  <div class="w-14 h-14 rounded-full bg-[primary-container] flex items-center justify-center text-white shadow-xl transform scale-90 group-hover:scale-100 transition-transform">
                    <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                  </div>
                </button>
              </div>
              <div class="p-6 flex flex-col gap-2 flex-1 justify-between">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center justify-between">
                    <h4 class="font-['Hanken_Grotesk'] text-xl font-medium text-[on-surface] group-hover:text-[primary] transition-colors">Jakarta in Motion</h4>
                    <span class="font-['JetBrains_Mono'] text-xs text-[outline]">2024</span>
                  </div>
                  <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2">
                    A kinetic exploration of Southeast Asia's metropolis through hyperlapse, high-speed shutter, and ambient field audio.
                  </p>
                </div>
                <div class="pt-3 border-t border-[outline-variant]/15 flex items-center justify-between font-['JetBrains_Mono'] text-xs text-[secondary]">
                  <span class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-[primary]">motion_photos_on</span>
                    Direction &amp; Motion
                  </span>
                  <span class="text-[outline]">Sony FX6 Cinema</span>
                </div>
              </div>
            </article>

            <!-- Project 3: Lumen Brand Story -->
            <article class="video-grid-item group flex flex-col bg-[surface-container-low] rounded-2xl overflow-hidden border border-[outline-variant]/20 transition-all duration-500 hover:-translate-y-1 hover:border-[primary]/40 shadow-xl" data-category="commercial">
              <div class="relative aspect-video w-full overflow-hidden bg-[surface-container-lowest]">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCEa_r8wc1e9nhryDFo50iA_tiO5fl035ckW9tBk4vc4_SsrvL29abzgmqFsib03DVaLA8mQauhVVTPoxgi3TaIUr5T1Q5t9E1rs-dYGXPkAF77N1QqPYC43wmc6XtvMZZea0ADSuFdXYqs-E1YGGTDqWDlB8OWOu3-0N993PGXCkUV1TY2TzSFn9mQUn40Hex-WxL-xlQGnGlHqjcb7n8cOL2whKLjDM_3At0-2gUNkPj3UEJZSc2v"
                  alt="Industrial brand design lighting commercial"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-low] via-transparent to-[surface-container-lowest]/30"></div>
                <div class="absolute top-3 left-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-xs text-[on-surface] flex items-center gap-1.5 border border-[outline-variant]/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-[tertiary]"></span>
                  <span>02:30</span>
                </div>
                <div class="absolute top-3 right-3 bg-[surface-container-lowest]/80 backdrop-blur-md px-2.5 py-0.5 rounded-full font-['JetBrains_Mono'] text-[10px] text-[outline] uppercase border border-[outline-variant]/20">
                  COMMERCIAL
                </div>
                <button
                  type="button"
                  class="video-play-trigger absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 cursor-pointer"
                  data-title="Lumen Brand Film"
                  data-desc="Brand narrative film celebrating tactile craftsmanship, modular materials, and silent design language."
                  data-runtime="02:30"
                  data-role="Commercial Director &amp; Colorist"
                  data-format="Master Prime 50mm"
                >
                  <div class="w-14 h-14 rounded-full bg-[primary-container] flex items-center justify-center text-white shadow-xl transform scale-90 group-hover:scale-100 transition-transform">
                    <span class="material-symbols-outlined text-[28px]">play_arrow</span>
                  </div>
                </button>
              </div>
              <div class="p-6 flex flex-col gap-2 flex-1 justify-between">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center justify-between">
                    <h4 class="font-['Hanken_Grotesk'] text-xl font-medium text-[on-surface] group-hover:text-[primary] transition-colors">Lumen Brand Story</h4>
                    <span class="font-['JetBrains_Mono'] text-xs text-[outline]">2025</span>
                  </div>
                  <p class="font-['Inter'] text-xs sm:text-sm text-[on-surface-variant] line-clamp-2">
                    Brand narrative film celebrating tactile craftsmanship, modular materials, and silent form factors.
                  </p>
                </div>
                <div class="pt-3 border-t border-[outline-variant]/15 flex items-center justify-between font-['JetBrains_Mono'] text-xs text-[secondary]">
                  <span class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-[primary]">palette</span>
                    Commercial Director &amp; Grade
                  </span>
                  <span class="text-[outline]">Master Prime 50mm</span>
                </div>
              </div>
            </article>

            <!-- Project 4: Silent Horizon -->
            <article class="video-grid-item group flex flex-col bg-[surface-container-low] rounded-2xl overflow-hidden border border-[outline-variant]/20 transition-all duration-500 hover:-translate-y-1 hover:border-[primary]/40 shadow-xl" data-category="short-film">
              <div class="relative aspect-video w-full overflow-hidden bg-[surface-container-lowest]">
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuA4vj4XcVASFEtzzAX6IYpJcpmO_MM5xkxMqqq9vPIz5UMCuk331l3NZ45rVguvXmK4anCnUww9pw748ha_KCRLQy9rS8l7d5HTQYsguWq_ZJweiCLAKI7jkC7GsAJyMjYt0uw63GwCyQDSa4JFs8B_aQxgzONzuZMLD7vNK8Ni-lo5GZEglR9K24zs5ll3VpAqBaOQMgUQZX80NjfMEYlk4jo7BEyYApWWUaVrUdYPsuqwxMk2g-UW"
                  alt="Mountain ridge visual poem"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[surface-container-low] via-transparent to-[surface-container-lowest]/30"></div>
