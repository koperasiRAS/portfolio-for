---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getVideos } from '../utils/content.js';

const rawVideos = getVideos();

// Format videos with hybrid YouTube & Google Drive detection
const videos = rawVideos.map(v => {
  const url = v.videoUrl || '';
  const isYouTube = url.includes('youtu.be') || url.includes('youtube.com');
  const isGDrive = url.includes('drive.google.com');
  
  let playableUrl = url;
  let glightboxType = isYouTube ? 'video' : isGDrive ? 'iframe' : 'external';
  let glightboxSource = isYouTube ? 'youtube' : undefined;

  if (isGDrive) {
    // Convert view link to preview embed
    const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/id=([a-zA-Z0-9_-]+)/);
    if (match && match[1]) {
      playableUrl = `https://drive.google.com/file/d/${match[1]}/preview`;
    }
  }

  return {
    ...v,
    playableUrl,
    glightboxType,
    glightboxSource,
    isYouTube,
    isGDrive
  };
});

const featuredVideo = videos.find(v => v.isFeatured || v.featured) || videos[0];
const regularVideos = videos.filter(v => v !== featuredVideo);
---

<BaseLayout
  title="Video Portfolio | Frame Of Rangga"
  description="Portofolio videografi Rangga Danuarta brand video, dokumentasi event, konten sosial media, dan video promosi dengan pendekatan cinematic storytelling."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-video.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/video"
  hasGlightbox={true}
>
  <Navbar slot="navbar" activePage="video" />

  <!-- PAGE HERO -->
  <section class="page-hero stitch-hero" transition:animate="fade">
    <div class="page-hero-bg-glow" aria-hidden="true"></div>
    <div class="page-hero-inner stitch-hero-inner">
      <h1 class="stitch-hero-title">
        Cinematic <span class="stitch-hero-accent">Work.</span>
      </h1>
      <p class="stitch-hero-sub">
        Exploring stories through motion and light. A curated collection of brand narratives, documentaries, wedding highlights, and creative experiments.
      </p>
    </div>
  </section>

  <!-- VIDEO GALLERY -->
  <section class="video-section" transition:animate="fade">

    <!-- Filter Bar -->
    <div class="filter-bar fade-up" aria-label="Filter by category">
      <button class="filter-btn active" data-filter="all">Semua</button>
      <button class="filter-btn" data-filter="wedding">Wedding</button>
      <button class="filter-btn" data-filter="dokumentasi">Dokumentasi</button>
      <button class="filter-btn" data-filter="vlog">Vlog</button>
      <button class="filter-btn" data-filter="sosmed">Konten Sosmed</button>
      <button class="filter-btn" data-filter="promosi">Promosi</button>
    </div>

    <!-- Video Grid -->
    <div class="stitch-video-grid fade-up">

      {featuredVideo && (
        <!-- FEATURED VIDEO CARD -->
        <a class="stitch-video-card stitch-video-card-featured glightbox"
           href={featuredVideo.playableUrl}
           data-type={featuredVideo.glightboxType}
           data-source={featuredVideo.glightboxSource}
           data-gallery="videos"
           data-category={featuredVideo.category ? featuredVideo.category.toLowerCase() : 'all'}>

          <div class="stitch-video-thumb-wrap">
            <img
              src={featuredVideo.thumbnail || featuredVideo.thumbnailPath}
              alt={featuredVideo.title}
              loading="lazy"
            />
            <div class="stitch-video-thumb-overlay"></div>
          </div>

          <div class="stitch-video-card-featured-body">
            <div class="stitch-video-card-featured-left">
              <span class="stitch-featured-badge">Featured Project</span>
              <h2 class="stitch-video-card-featured-title">{featuredVideo.title}</h2>
              {featuredVideo.description && (
                <p class="stitch-video-card-featured-desc">{featuredVideo.description}</p>
              )}
            </div>
            <div class="stitch-video-card-featured-right">
              {featuredVideo.duration && (
                <div class="stitch-duration-block">
                  <span class="stitch-duration-label">Duration</span>
                  <span class="stitch-duration-value">{featuredVideo.duration}</span>
                </div>
              )}
              <div class="stitch-play-btn stitch-play-btn-lg" aria-label="Play video">
                <i class="fas fa-play"></i>
              </div>
            </div>
          </div>
        </a>
      )}

      <!-- Regular Video Cards (2 Columns) -->
      <div class="stitch-video-grid-regular">
        {regularVideos.map((video) => {
          const thumbSrc = video.thumbnail || video.thumbnailPath;
          
          return (
            <a class="stitch-video-card stitch-video-card-regular glightbox"
               href={video.playableUrl}
               data-type={video.glightboxType}
               data-source={video.glightboxSource}
               data-gallery="videos"
               data-category={video.category ? video.category.toLowerCase() : 'all'}>
              <div class="stitch-video-thumb-wrap">
                <img
                  src={thumbSrc}
                  alt={video.title}
                  loading="lazy"
                />
                {video.duration && (
                  <div class="stitch-duration-badge">{video.duration}</div>
                )}
                <div class="stitch-video-play-overlay">
                  <div class="stitch-play-btn">
                    <i class="fas fa-play"></i>
                  </div>
                </div>
              </div>
              <div class="stitch-video-card-footer">
                <div class="stitch-video-card-info">
                  <h3 class="stitch-video-card-title">{video.title}</h3>
                  <p class="stitch-video-card-meta">{video.category ? video.category.toUpperCase() : 'VIDEO'} &bull; {video.year || '2024'}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

  </section>

  <Footer slot="footer" variant="minimal" />
</BaseLayout>

<style>
  /* =============================================
     STITCH VIDEO PAGE Scoped styles
     ============================================= */

  /* Hero */
  .stitch-hero {
    padding: 140px 48px 80px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .stitch-hero-inner {
    max-width: 100%;
    text-align: center;
  }

  .stitch-hero-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .stitch-hero-accent {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stitch-hero-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Filter Bar */
  .filter-bar {
    padding: 0 48px;
    margin-bottom: 48px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.08);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 22px;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: var(--surface-bright);
    color: var(--accent-primary);
    border-color: rgba(163, 166, 255, 0.15);
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: var(--accent-secondary-container);
    border-color: rgba(193, 128, 255, 0.3);
    color: #e9cdff;
  }

  /* Video Section */
  .video-section {
    padding: 0 48px 80px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Bento-style grid: featured + 2-col grid */
  .stitch-video-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Featured Card */
  .stitch-video-card-featured {
    display: block;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-container);
    border: 1px solid rgba(163, 166, 255, 0.08);
    cursor: pointer;
    aspect-ratio: 21 / 9;
    transition: transform 0.4s ease, box-shadow 0.3s ease;
  }

  .stitch-video-card-featured:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
  }

  .stitch-video-thumb-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .stitch-video-card-featured .stitch-video-thumb-wrap {
    position: absolute;
    inset: 0;
  }

  .stitch-video-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-video-card-featured:hover .stitch-video-thumb-wrap img,
  .stitch-video-card-regular:hover .stitch-video-thumb-wrap img {
    transform: scale(1.04);
  }

  .stitch-video-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 14, 32, 0.95) 0%, rgba(6, 14, 32, 0.4) 50%, rgba(6, 14, 32, 0.1) 100%);
  }

  /* Featured Body */
  .stitch-video-card-featured-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    z-index: 2;
  }

  .stitch-featured-badge {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-primary);
    background: rgba(163, 166, 255, 0.15);
    border: 1px solid rgba(163, 166, 255, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .stitch-video-card-featured-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .stitch-video-card-featured-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 540px;
  }

  .stitch-video-card-featured-right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .stitch-duration-block {
    text-align: right;
  }

  .stitch-duration-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 2px;
  }

  .stitch-duration-value {
    font-family: 'Manrope', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Play Button */
  .stitch-play-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent-primary);
    color: #0f00a4;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(163, 166, 255, 0.4);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .stitch-play-btn-lg {
    width: 64px;
    height: 64px;
    font-size: 20px;
  }

  .stitch-video-card-featured:hover .stitch-play-btn,
  .stitch-video-card-regular:hover .stitch-play-btn {
    transform: scale(1.1);
    background: #ffffff;
  }

  /* Regular Video Grid (2 columns) */
  .stitch-video-grid-regular {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* Regular Card */
  .stitch-video-card-regular {
    display: block;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-container);
    border: 1px solid rgba(163, 166, 255, 0.08);
    cursor: pointer;
    transition: transform 0.4s ease, box-shadow 0.3s ease, opacity 0.3s ease;
  }

  .stitch-video-card-regular:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
  }

  .stitch-video-card-regular .stitch-video-thumb-wrap {
    aspect-ratio: 16 / 9;
  }

  .stitch-duration-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(6, 14, 32, 0.85);
    border: 1px solid rgba(163, 166, 255, 0.2);
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .stitch-video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 14, 32, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .stitch-video-card-regular:hover .stitch-video-play-overlay {
    opacity: 1;
  }

  .stitch-video-card-footer {
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .stitch-video-card-title {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .stitch-video-card-meta {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  @media (max-width: 900px) {
    .stitch-video-grid-regular {
      grid-template-columns: 1fr;
    }
    .stitch-video-card-featured {
      aspect-ratio: 16 / 9;
    }
    .stitch-video-card-featured-body {
      padding: 24px;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 600px) {
    .stitch-hero {
      padding: 120px 24px 40px;
    }
    .filter-bar {
      padding: 0 20px;
      gap: 8px;
    }
    .video-section {
      padding: 0 20px 60px;
    }
  }
</style>

<script is:inline>
  // ---------- GLIGHTBOX (YouTube & Google Drive embed) ----------
  function initVideoLightbox() {
    if (typeof GLightbox !== 'undefined') {
      GLightbox({
        selector: '.glightbox',
        touchNavigation: true,
        loop: false,
        autoplayVideos: true,
      });
    } else {
      setTimeout(initVideoLightbox, 100);
    }
  }

  // ---------- VIDEO CATEGORY FILTER ----------
  function initVideoFilter() {
    const filterBar = document.querySelector('.filter-bar');
    if (!filterBar) return;

    const btns = filterBar.querySelectorAll('.filter-btn');
    const featuredCard = document.querySelector('.stitch-video-card-featured');
    const regularCards = document.querySelectorAll('.stitch-video-card-regular');

    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const selectedFilter = btn.getAttribute('data-filter') ? btn.getAttribute('data-filter').toLowerCase() : 'all';

        // Update active button
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter regular cards
        regularCards.forEach(card => {
          const cat = card.getAttribute('data-category') ? card.getAttribute('data-category').toLowerCase() : '';
          if (selectedFilter === 'all' || cat.includes(selectedFilter) || selectedFilter.includes(cat)) {
            card.style.display = 'block';
            card.style.opacity = '1';
          } else {
            card.style.display = 'none';
            card.style.opacity = '0';
          }
        });

        // Filter featured card
        if (featuredCard) {
          const featCat = featuredCard.getAttribute('data-category') ? featuredCard.getAttribute('data-category').toLowerCase() : '';
          if (selectedFilter === 'all' || featCat.includes(selectedFilter) || selectedFilter.includes(featCat)) {
            featuredCard.style.display = 'block';
            featuredCard.style.opacity = '1';
          } else {
            featuredCard.style.display = 'none';
            featuredCard.style.opacity = '0';
          }
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initVideoLightbox();
    initVideoFilter();
  });

  document.addEventListener('astro:page-load', () => {
    initVideoLightbox();
    initVideoFilter();
  });
</script>
