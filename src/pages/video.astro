    <!-- Video Filter & Player Script -->
    <script is:inline>
      function initVideoPage() {
        const filterBtns = document.querySelectorAll('.video-filter-btn');
        const videoCards = document.querySelectorAll('.video-grid-item');
        const playTriggers = document.querySelectorAll('.video-play-trigger');
        const modal = document.getElementById('video-player-modal');
        const closeBtn = document.getElementById('close-video-player-btn');
        const modalTitle = document.getElementById('player-modal-title');
        const filmName = document.getElementById('player-film-name');
        const filmSpec = document.getElementById('player-film-spec');
        const filmDesc = document.getElementById('player-film-desc');
        const filmRole = document.getElementById('player-film-role');
        const filmRuntime = document.getElementById('player-film-runtime');

        // Filter buttons
        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            filterBtns.forEach(b => {
              b.classList.remove('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
              b.classList.add('bg-surface-container-low', 'text-secondary');
              const dot = b.querySelector('.w-1\\.5');
              if (dot && !b.contains(dot)) b.insertBefore(dot, b.firstChild);
            });

            btn.classList.add('active', 'bg-primary-container', 'text-on-primary-container', 'shadow-md');
            btn.classList.remove('bg-surface-container-low', 'text-secondary');

            const cat = btn.getAttribute('data-filter');
            videoCards.forEach(card => {
              const cardCat = card.getAttribute('data-category') || '';
              if (cat === 'all' || cardCat.includes(cat)) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });

        function openPlayer(title, desc, runtime, role, format) {
          if (!modal) return;
          modalTitle.textContent = title || 'CINEMA REEL';
          filmName.textContent = title || '';
          filmDesc.textContent = desc || '';
          filmSpec.textContent = format || '4K DCI';
          filmRole.textContent = role || 'Direction by Rangga';
          filmRuntime.textContent = runtime ? 'RUNTIME: ' + runtime : '';

          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = 'hidden';
        }

        function closePlayer() {
          if (!modal) return;
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = '';
        }

        playTriggers.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const title = trigger.getAttribute('data-title');
            const desc = trigger.getAttribute('data-desc');
            const runtime = trigger.getAttribute('data-runtime');
            const role = trigger.getAttribute('data-role');
            const format = trigger.getAttribute('data-format');
            openPlayer(title, desc, runtime, role, format);
          });
        });

        if (closeBtn) closeBtn.addEventListener('click', closePlayer);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target.id === 'video-player-modal') closePlayer();
          });
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closePlayer();
        });
      }

      document.addEventListener('astro:page-load', initVideoPage);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVideoPage);
      } else {
        initVideoPage();
      }
    </script>
