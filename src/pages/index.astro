---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";
import ranggaPortrait from "../assets/foto/about rangga.jpg";
---

<BaseLayout
  title="FRAME OF RANGGA | Cinematic Visual Storyteller & Creative Director"
  description="Archival portfolio of Rangga Danuarta. Photography, film direction, brand identity, and high-performance digital experiences based in Indonesia."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/"
  hasHeroPreload={true}
  bodyClass="bg-background text-on-surface selection:bg-primary selection:text-on-primary antialiased"
>
  <!-- Floating Glass Capsule Navbar -->
  <Navbar slot="navbar" activePage="home" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">
      
      <!-- ============================================================
           SECTION: FULL-SCREEN CINEMATIC HERO
           ============================================================ -->
      <section class="relative w-full -mt-16 flex flex-col justify-between overflow-hidden min-h-[92vh] lg:min-h-screen">
        <!-- Atmospheric Visual Canvas -->
        <div class="absolute inset-0 z-0">
          <div
            class="w-full h-full bg-cover bg-center filter brightness-[0.65] contrast-[1.15] scale-[1.02] transform transition-transform duration-1000 ease-out"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCLSpiA-v4-EnhFVUTxUvMsnGBVF5Hw0X_QHtZnDknwykX6I2vPvoR7xjEizXY3Ugr1gQYJohOJ_X_tyBAoc4g4HFlN4hUfgq8GC-rIkfmA_PIt8pS0VgEEZpVyHRpgYgUHSYInA1MyBUynXukqwIJ59AlDqVNX_d6Hu7mrEpRXMYmlemjxajRdjGGgCpQokef3ZNmZ2v7rb3bmGJNeDpR5Ii9iqBN__Kmzstnz2DSk-w4PC7r2H_sA')"
          ></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-background/80"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-background/90 via-transparent to-background/60"></div>
        </div>

        <!-- Hero Content Cluster -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-margin-mobile md:px-margin pt-36 pb-10 flex flex-col justify-between flex-grow">
          <!-- Top Line Identity -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-4">
            <div class="flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-surface-container-lowest/70 backdrop-blur-md border border-outline-variant/20 shadow-md">
              <span class="w-2 h-2 rounded-full bg-tertiary animate-ping"></span>
              <span class="font-label-sm text-label-sm text-secondary tracking-widest uppercase">A creative visual practice based in Indonesia</span>
            </div>
            <span class="font-label-md text-label-md text-outline hidden md:inline-block tracking-wider">ARCHIVAL FOLIO 2020 — 2026</span>
          </div>

          <!-- Monumental Typography -->
          <div class="my-auto py-10 md:py-14 flex flex-col gap-6">
            <div class="flex flex-col tracking-tighter select-none font-headline-lg leading-[0.9]">
              <span class="font-display-xl text-display-xl sm:font-display-lg md:font-display-xl font-semibold text-on-surface opacity-95">FRAME</span>
              <span class="font-display-xl text-display-xl sm:font-display-lg md:font-display-xl font-semibold text-on-surface -mt-2 sm:-mt-4 md:-mt-6 opacity-85">OF</span>
              <div class="flex items-baseline gap-4 flex-wrap -mt-2 sm:-mt-4 md:-mt-6">
                <span class="font-display-xl text-display-xl font-bold text-primary">RANGGA.</span>
                <span class="font-label-md text-label-md text-tertiary px-3 py-1 rounded-full bg-surface-container-high/60 backdrop-blur-md border border-outline-variant/30">IDN // 06.2° S</span>
              </div>
            </div>
            <p class="font-body-lg text-body-lg sm:text-body-md text-on-surface-variant max-w-2xl leading-relaxed">
              Photography, film direction, visual identity &amp; digital experiences crafted with editorial quietude and technical discipline.
            </p>
          </div>

          <!-- Hero Bottom Controls & Wayfinding -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pt-4 border-t border-outline-variant/15">
            <div class="flex items-center gap-3">
              <a
                class="group flex items-center gap-2 px-6 sm:px-8 py-3.5 rounded-full bg-surface-container-high/90 text-on-surface font-headline-sm text-headline-sm hover:bg-surface-container-highest hover:scale-[1.02] shadow-xl border border-outline-variant/30 backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all duration-300"
                href="#curated-works"
              >
                <span>Explore Work</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
              </a>
              <a
                class="px-5 sm:px-6 py-3.5 rounded-full bg-surface-container/70 backdrop-blur-xl text-on-surface-variant hover:text-on-surface font-body-md text-body-md hover:bg-surface-container-high transition-colors border border-outline-variant/15"
                href="#monograph"
              >
                Monograph
              </a>
            </div>
            <a
              class="flex items-center gap-1.5 text-outline hover:text-on-surface transition-colors cursor-pointer group font-label-md text-label-md uppercase tracking-widest"
              href="#monograph"
            >
              <span>SCROLL</span>
              <span class="material-symbols-outlined text-sm group-hover:translate-y-1 transition-transform">south</span>
            </a>
          </div>
        </div>
      </section>


      <!-- ============================================================
           SECTION 01: ABOUT PREVIEW & MONOGRAPH
           ============================================================ -->
      <section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin py-20 md:py-28 flex flex-col gap-14" id="monograph">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-3">
              <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">01 / ARCHIVE IDENTITY</span>
              <span class="w-12 h-px bg-outline-variant/40"></span>
            </div>
            <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-semibold text-on-surface tracking-tight">A visual practice by Rangga.</h2>
          </div>
          <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant max-w-md leading-relaxed">
            Balancing raw cinematic intuition with precise spatial systems, documenting cultures, narratives, and digital frontiers.
          </p>
        </div>

        <!-- Editorial Monograph Spread -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Portrait Card -->
          <div class="lg:col-span-5 relative group">
            <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container shadow-2xl border border-outline-variant/20">
              <Image
                src={ranggaPortrait}
                alt="Editorial portrait of Rangga Danuarta, creative director and visual storyteller"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 inset-x-4 flex items-center justify-between">
                <span class="font-['JetBrains_Mono'] text-xs text-on-surface-variant bg-background/80 backdrop-blur-md px-3 py-1 rounded-full border border-outline-variant/20">Rangga P. / Founder</span>
                <span class="font-['JetBrains_Mono'] text-xs text-tertiary">JAKARTA &amp; DEPOK, ID</span>
              </div>
            </div>
            <!-- Offset Accent Card -->
            <div class="absolute -bottom-4 -right-4 p-4 rounded-xl bg-surface-container-high/90 backdrop-blur-xl shadow-2xl border border-outline-variant/30 hidden sm:flex flex-col gap-1 max-w-xs">
              <span class="font-['JetBrains_Mono'] text-[10px] text-tertiary uppercase tracking-wider">CURRENT FOCUS</span>
              <span class="font-['Inter'] text-xs text-on-surface">Archival film direction &amp; high-performance web storytelling.</span>
            </div>
          </div>

          <!-- Narrative & Metrics Column -->
          <div class="lg:col-span-7 flex flex-col gap-8 lg:pl-4">
            <div class="flex flex-col gap-4">
              <p class="font-['Inter'] text-base sm:text-lg text-on-surface leading-relaxed">
                Operating at the convergence of still photography, moving image, and interactive web architecture. For over six years, the practice has partnered with visionary brands, clients, and cultural platforms to craft stories that endure.
              </p>
              <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant leading-relaxed">
                Every frame is captured with optical discipline, and every digital canvas is engineered to evoke sensory presence. The work balances organic emotion with contemporary precision.
              </p>
            </div>

            <!-- Discipline Tags Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <a href="/foto" class="flex flex-col gap-1.5 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors group">
                <span class="material-symbols-outlined text-tertiary text-[22px]">photo_camera</span>
                <span class="font-['Hanken_Grotesk'] text-sm sm:text-base font-medium text-on-surface group-hover:text-tertiary transition-colors">Photography</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-on-surface-variant">Editorial &amp; 35mm</span>
              </a>
              <a href="/video" class="flex flex-col gap-1.5 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors group">
                <span class="material-symbols-outlined text-tertiary text-[22px]">videocam</span>
                <span class="font-['Hanken_Grotesk'] text-sm sm:text-base font-medium text-on-surface group-hover:text-tertiary transition-colors">Film Direction</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-on-surface-variant">Cinematic Motion</span>
              </a>
              <a href="/design" class="flex flex-col gap-1.5 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors group">
                <span class="material-symbols-outlined text-tertiary text-[22px]">category</span>
                <span class="font-['Hanken_Grotesk'] text-sm sm:text-base font-medium text-on-surface group-hover:text-tertiary transition-colors">Visual Identity</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-on-surface-variant">Design Systems</span>
              </a>
              <a href="/website" class="flex flex-col gap-1.5 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors group">
                <span class="material-symbols-outlined text-tertiary text-[22px]">web</span>
                <span class="font-['Hanken_Grotesk'] text-sm sm:text-base font-medium text-on-surface group-hover:text-tertiary transition-colors">Digital Exp.</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-on-surface-variant">Interactive Web</span>
              </a>
            </div>

            <!-- Archival Metrics Bar -->
            <div class="grid grid-cols-3 gap-4 pt-4 border-t border-outline-variant/20">
              <div class="flex flex-col">
                <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-tertiary tracking-tight">2020</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase mt-1">Years In Practice</span>
                <span class="font-['Inter'] text-xs text-on-surface-variant">Active across Regions</span>
              </div>
              <div class="flex flex-col">
                <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-on-surface tracking-tight">38+</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase mt-1">Selected Works</span>
                <span class="font-['Inter'] text-xs text-on-surface-variant">Commercial &amp; Editorial</span>
              </div>
              <div class="flex flex-col">
                <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-tertiary tracking-tight">04</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase mt-1">Disciplines</span>
                <span class="font-['Inter'] text-xs text-on-surface-variant">Unified Studio Portfolio</span>
              </div>
            </div>

            <!-- Full Bio Action -->
            <div class="pt-2">
              <a class="inline-flex items-center gap-2 text-tertiary font-['Hanken_Grotesk'] font-medium text-base group hover:text-on-surface transition-colors" href="/about">
                <span>Read Full Biography &amp; Philosophy</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1.5 transition-transform">arrow_right_alt</span>
              </a>
            </div>
          </div>
        </div>
      </section>


      <!-- ============================================================
           SECTION 02: CURATED SELECTED WORKS (ASYMMETRIC BENTO GRID)
           ============================================================ -->
      <section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin py-20 md:py-28 flex flex-col gap-12" id="curated-works">
        <!-- Section Title & Filter Chips -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-3">
              <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">02 / CURATED WORKS</span>
              <span class="w-12 h-px bg-outline-variant/40"></span>
            </div>
            <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl md:text-5xl font-semibold text-on-surface tracking-tight">Selected Projects (2025—2026)</h2>
          </div>

          <!-- Category Filter Bar -->
          <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-full bg-background/80 backdrop-blur-md border border-outline-variant/20">
            <button class="filter-btn active px-4 py-1.5 rounded-full font-['JetBrains_Mono'] text-[11px] bg-surface-container-high text-on-surface border border-outline-variant/30 shadow-sm" data-category="all">ALL WORK</button>
            <button class="filter-btn px-4 py-1.5 rounded-full font-['JetBrains_Mono'] text-[11px] text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors" data-category="photo">PHOTO</button>
            <button class="filter-btn px-4 py-1.5 rounded-full font-['JetBrains_Mono'] text-[11px] text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors" data-category="film">FILM</button>
            <button class="filter-btn px-4 py-1.5 rounded-full font-['JetBrains_Mono'] text-[11px] text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors" data-category="design">DESIGN</button>
            <button class="filter-btn px-4 py-1.5 rounded-full font-['JetBrains_Mono'] text-[11px] text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors" data-category="web">INTERACTIVE</button>
          </div>
        </div>

        <!-- 4 Disciplines Asymmetric Showcase Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8">
          
          <!-- Item 01: Photo - The Ocean Series (Spans 7 cols) -->
          <div class="work-card md:col-span-7 flex flex-col gap-3 group" data-category="photo">
            <a href="/foto" class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-surface-container shadow-lg border border-outline-variant/20 block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLUmgq8ihNYNNLzO10X4Fi1Ng3GBBBovXTJ7Bsd6tIsPtyUVmZB5LfEFaZ7AZwga9UKqnvmCPyxy2qnxnNFmyqQZPpaH4fnhYAK3gCutU8eZr2DGUFiyA4nAf7ImlPqH1FlnQi7OjcCbZDwVMCithWVdMYOYB9OzMz_U1ubX3s_ysCGddStb91qOU3x5bGPAlK_2BqrCVoJf8LvqDIRy6HxjLztTwnmbYUZk5of-XF0rZIylsIbeun"
                alt="Fine art black and white analog photo of breaking ocean waves on volcanic cliffs"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute top-4 left-4">
                <span class="font-['JetBrains_Mono'] text-[10px] uppercase px-3 py-1 rounded-full bg-background/80 backdrop-blur-md text-tertiary border border-outline-variant/20">PHOTOGRAPHY</span>
              </div>
              <div class="absolute bottom-4 right-4">
                <span class="w-10 h-10 rounded-full bg-background/80 backdrop-blur-md flex items-center justify-center text-on-surface group-hover:bg-primary group-hover:text-on-primary transition-all border border-outline-variant/20 shadow-lg">
                  <span class="material-symbols-outlined text-[20px]">north_east</span>
                </span>
              </div>
            </a>
            <div class="flex items-baseline justify-between px-1">
              <div>
                <a href="/foto" class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface group-hover:text-tertiary transition-colors block">The Ocean Series</a>
                <p class="font-['Inter'] text-xs text-on-surface-variant">Archival Monograph &amp; Large Format Print Exhibition</p>
              </div>
              <span class="font-['JetBrains_Mono'] text-xs text-on-surface-variant">2026</span>
            </div>
          </div>

          <!-- Item 02: Film - The Last Light (Spans 5 cols) -->
          <div class="work-card md:col-span-5 flex flex-col gap-3 group" data-category="film">
            <a href="/video" class="relative w-full aspect-[4/5] md:aspect-auto md:h-full rounded-2xl overflow-hidden bg-surface-container shadow-lg border border-outline-variant/20 flex flex-col justify-end block min-h-[300px]">
              <img
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCVsrViwITXH4R3FyJjPU_RTHfLWOsIA9fiCVGhoJDqwZXZh9FNerV8bC35aNMDdmtWTtiJTZ78Vy7Lf8NGu8T92Ui60TGIpAVpwYYPZ2kywgPRlgviK84b6Z3rD3dJuxruD0THx7k77JklMn3WxaxukoXurkwtYiOG-uqc8YsICDnN69oBGAihQ0ahK7DOaJ8eade_slnpW2ufg-r4vHvefPe7YU5Nn-8wKRGrS5jB4LNfRbIxuhbK"
                alt="Cinematic 35mm motion picture still with warm flare on mountain ridge"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent"></div>
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-[10px] uppercase px-3 py-1 rounded-full bg-background/80 backdrop-blur-md text-tertiary border border-outline-variant/20">FILM DIRECTION</span>
                <span class="px-2.5 py-0.5 rounded-full bg-red-950/80 text-red-300 font-['JetBrains_Mono'] text-[10px] flex items-center gap-1 border border-red-800/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                  REEL
                </span>
              </div>
              <div class="relative z-10 p-6 flex flex-col gap-1">
                <div class="flex items-center justify-between">
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface group-hover:text-tertiary transition-colors">The Last Light</h3>
                  <span class="font-['JetBrains_Mono'] text-xs text-on-surface-variant">2026</span>
                </div>
                <p class="font-['Inter'] text-xs text-on-surface-variant">Narrative Short &amp; Festival Official Selection (16mm Cinema)</p>
              </div>
            </a>
          </div>

          <!-- Item 03: Design - Lumen Brand Identity (Spans 5 cols) -->
          <div class="work-card md:col-span-5 flex flex-col gap-3 group" data-category="design">
            <a href="/design" class="relative w-full aspect-square rounded-2xl overflow-hidden bg-surface-container shadow-lg border border-outline-variant/20 block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbLNPRpGguviIR-bsQ2D2YKhwtK0ow5u0T_bwjr4Qc8E6j-J_eQ9E2fRKRSrWbO4k18vV4Le-yXya7X_lSL0vjZiLg-aTXqMqQLqpgeJEXbm_FXH8UR_TDMiLg3Zz83CWCmi9sDZUkJ7IB-k2lgMP9DC0EdkY0KU5bJpGtAAnYtjPOS9S35dZQQKX1m-rZzIi12E4PmVhw650CzHd_vxHhJghyjY6ncGyu71lHTkiChLCl2pKzBhJ6"
                alt="Brand identity packaging and stationery design"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
              <div class="absolute top-4 left-4">
                <span class="font-['JetBrains_Mono'] text-[10px] uppercase px-3 py-1 rounded-full bg-background/80 backdrop-blur-md text-secondary border border-outline-variant/20">BRANDING &amp; IDENTITY</span>
              </div>
              <div class="absolute bottom-4 right-4">
                <span class="w-10 h-10 rounded-full bg-background/80 backdrop-blur-md flex items-center justify-center text-on-surface group-hover:bg-primary group-hover:text-on-primary transition-all border border-outline-variant/20 shadow-lg">
                  <span class="material-symbols-outlined text-[20px]">north_east</span>
                </span>
              </div>
            </a>
            <div class="flex items-baseline justify-between px-1">
              <div>
                <a href="/design" class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface group-hover:text-tertiary transition-colors block">Lumen Brand Identity</a>
                <p class="font-['Inter'] text-xs text-on-surface-variant">Spatial Lighting Atelier Complete Visual System</p>
              </div>
              <span class="font-['JetBrains_Mono'] text-xs text-on-surface-variant">2026</span>
            </div>
          </div>

          <!-- Item 04: Web - Aura Architecture (Spans 7 cols) -->
          <div class="work-card md:col-span-7 flex flex-col gap-3 group" data-category="web">
            <a href="/website" class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-surface-container shadow-lg border border-outline-variant/20 block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAO6BDLECnJXG_N7pL-pOVMtc27seTbmE5t8qZjZEaGcIcd4iUz_T9o6eRjphwdQfZwrN0cOpAcejk7mBFTiXKFK28OIN3VrL4ySepUSRcPwuP6kX6y5JSFf-LaZMzDEwpXBtsZnpypr9Hp1t8TE_AB_lDtKIeVjsPqzHSaGHLF1oZpWsAtnnDt1CMmKi8Y-xw67vUWoY6iiHnx6vbW3DawyPwISxo2xCGzClt2En0QBYU_UGVDT7xN"
                alt="Interactive web experience with 3D spatial layout"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
              <div class="absolute top-4 left-4">
                <span class="font-['JetBrains_Mono'] text-[10px] uppercase px-3 py-1 rounded-full bg-background/80 backdrop-blur-md text-tertiary border border-outline-variant/20">WEB &amp; DIGITAL EXP</span>
