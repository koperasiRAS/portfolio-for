  <!-- Filter Category Script -->
  <script is:inline>
    function setupWorkFilters() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.work-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const category = btn.getAttribute('data-category');

          buttons.forEach(b => {
            b.classList.remove('active', 'bg-surface-container-high', 'text-on-surface', 'border', 'border-outline-variant/30', 'shadow-sm');
            b.classList.add('text-on-surface-variant');
          });

          btn.classList.add('active', 'bg-surface-container-high', 'text-on-surface', 'border', 'border-outline-variant/30', 'shadow-sm');
          btn.classList.remove('text-on-surface-variant');

          cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (category === 'all' || cardCat === category) {
              card.style.display = 'flex';
              card.style.opacity = '1';
            } else {
              card.style.display = 'none';
              card.style.opacity = '0';
            }
          });
        });
      });
    }

    document.addEventListener('astro:page-load', setupWorkFilters);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupWorkFilters);
    } else {
      setupWorkFilters();
    }
  </script>
