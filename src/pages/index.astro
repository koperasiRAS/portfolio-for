---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";
import ranggaPortrait from "../assets/foto/about rangga.jpg";
---

<BaseLayout
  title="FRAME OF RANGGA | Cinematic Visual Storyteller & Creative Director"
  description="Archival portfolio of Rangga Danuarta. Photography, film direction, brand identity, and high-performance digital experiences based in Indonesia."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/"
  hasHeroPreload={true}
  bodyClass="bg-background text-on-surface selection:bg-primary selection:text-on-primary antialiased"
>
  <!-- Floating Glass Capsule Navbar -->
  <Navbar slot="navbar" activePage="home" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">
      
      <!-- ============================================================
           SECTION: FULL-SCREEN CINEMATIC HERO
           ============================================================ -->
      <section class="relative w-full -mt-16 flex flex-col justify-between overflow-hidden min-h-[92vh] lg:min-h-screen">
        <!-- Atmospheric Visual Canvas -->
        <div class="absolute inset-0 z-0">
          <div
            class="w-full h-full bg-cover bg-center filter brightness-[0.65] contrast-[1.15] scale-[1.02] transform transition-transform duration-1000 ease-out"
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCLSpiA-v4-EnhFVUTxUvMsnGBVF5Hw0X_QHtZnDknwykX6I2vPvoR7xjEizXY3Ugr1gQYJohOJ_X_tyBAoc4g4HFlN4hUfgq8GC-rIkfmA_PIt8pS0VgEEZpVyHRpgYgUHSYInA1MyBUynXukqwIJ59AlDqVNX_d6Hu7mrEpRXMYmlemjxajRdjGGgCpQokef3ZNmZ2v7rb3bmGJNeDpR5Ii9iqBN__Kmzstnz2DSk-w4PC7r2H_sA')"
          ></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-background/80"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-background/90 via-transparent to-background/60"></div>
        </div>

        <!-- Hero Content Cluster -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-margin-mobile md:px-margin pt-36 pb-10 flex flex-col justify-between flex-grow">
          <!-- Top Line Identity -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm pt-space-md">
            <div class="flex items-center gap-space-sm px-space-md py-space-xs rounded-full bg-surface-container-lowest/60 backdrop-blur-md shadow-md">
              <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-ping"></span>
              <span class="font-label-sm text-label-sm text-secondary tracking-widest uppercase" data-i18n="home.tagline">A creative visual practice based in Indonesia</span>
            </div>
            <span class="font-label-sm text-label-sm text-outline hidden md:inline-block" data-i18n="home.archival">ARCHIVAL FOLIO 2020 — 2026</span>
          </div>

          <!-- Monumental Typography -->
          <div class="my-auto py-space-xl flex flex-col gap-space-lg">
            <div class="flex flex-col tracking-tighter select-none">
              <span class="font-display-xl text-display-xl text-on-surface opacity-95">FRAME</span>
              <span class="font-display-xl text-display-xl text-on-surface -mt-space-md md:-mt-space-lg opacity-85">OF</span>
              <div class="flex items-baseline gap-space-md flex-wrap -mt-space-md md:-mt-space-lg">
                <span class="font-display-xl text-display-xl text-primary font-bold">RANGGA.</span>
                <span class="font-label-md text-label-md text-tertiary px-space-sm py-space-xs rounded-full bg-surface-container-high/40 backdrop-blur-md">IDN // 06.2° S</span>
              </div>
            </div>
            <p class="font-headline-sm text-headline-sm text-on-surface-variant max-w-xl font-normal leading-relaxed" data-i18n="home.subtitle">
              Photography, film direction, visual identity &amp; digital experiences crafted with editorial quietude and technical discipline.
            </p>
          </div>

          <!-- Hero Bottom Controls & Wayfinding -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-lg border-t-0 pt-space-md">
            <div class="flex items-center gap-space-md">
              <a
                class="group flex items-center gap-space-sm px-space-xl py-space-md rounded-full bg-surface-container-high/80 text-on-surface font-headline-sm text-headline-sm hover:bg-surface-container-highest hover:scale-[1.02] shadow-xl border border-outline-variant/30 backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all duration-300"
                href="#curated-works"
              >
                <span data-i18n="home.exploreAll">Explore Work</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
              </a>
              <a
                class="px-space-lg py-space-md rounded-full bg-surface-container-high/60 backdrop-blur-xl text-on-surface font-body-md text-body-md hover:bg-surface-container-highest transition-colors"
                href="#monograph"
              >
                <span data-i18n="home.monograph">Monograph</span>
              </a>
            </div>
            <a
              class="flex items-center gap-space-xs text-outline hover:text-on-surface transition-colors cursor-pointer group"
              href="#monograph"
            >
              <span class="font-label-sm text-label-sm uppercase tracking-widest">SCROLL</span>
              <span class="material-symbols-outlined text-sm group-hover:translate-y-1 transition-transform">south</span>
            </a>
          </div>
        </div>
      </section>


      <!-- ============================================================
           SECTION 01: ABOUT PREVIEW & MONOGRAPH
           ============================================================ -->
      <section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin py-space-3xl flex flex-col gap-space-2xl" id="monograph">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
          <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-sm">
              <span class="font-label-md text-label-md text-primary uppercase" data-i18n="home.archiveLabel">01 / ARCHIVE IDENTITY</span>
              <span class="w-12 h-px bg-outline-variant/30"></span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight" data-i18n="home.practiceTitle">A visual practice by Rangga.</h2>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md" data-i18n="home.practiceSub">
            Balancing raw cinematic intuition with precise spatial systems, documenting cultures, narratives, and digital frontiers.
          </p>
        </div>

        <!-- Editorial Monograph Spread -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
          <!-- Portrait Card -->
          <div class="lg:col-span-5 relative group">
            <div class="relative w-full aspect-[4/5] rounded-DEFAULT overflow-hidden bg-surface-container shadow-2xl">
              <Image
                src={ranggaPortrait}
                alt="Editorial portrait of Rangga Danuarta, creative director and visual storyteller"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-space-md inset-x-space-md flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xs rounded-full">Rangga P. / Founder</span>
                <span class="font-label-sm text-label-sm text-tertiary">DKI JAKARTA, ID</span>
              </div>
            </div>
            <!-- Offset Accent Card -->
            <div class="absolute -bottom-space-md -right-space-md p-space-md rounded-DEFAULT bg-surface-container-high/90 backdrop-blur-xl shadow-xl hidden sm:flex flex-col gap-space-xs max-w-xs">
              <span class="font-label-sm text-label-sm text-secondary uppercase" data-i18n="home.currentFocus">CURRENT FOCUS</span>
              <span class="font-body-sm text-body-sm text-on-surface" data-i18n="home.currentFocusText">Archival film installations &amp; high-performance WebGL digital artifacts.</span>
            </div>
          </div>

          <!-- Narrative & Metrics Column -->
          <div class="lg:col-span-7 flex flex-col gap-space-xl lg:pl-space-lg">
            <div class="flex flex-col gap-space-md">
              <p class="font-body-lg text-body-lg text-on-surface leading-relaxed">
                Operating at the convergence of still photography, moving image, and interactive web architecture. For over six years, the studio has partnered with visionary brands, galleries, and cultural institutions globally to shape identities that endure.
              </p>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                Every frame is captured with optical discipline, and every digital canvas is engineered to evoke sensory presence. The work exists between the tangible grit of Indonesian coastlines and the surgical clarity of contemporary typography.
              </p>
            </div>

            <!-- Discipline Tags Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
              <a href="/foto" class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm group hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-primary text-[22px]">photo_camera</span>
                <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Photography</span>
                <span class="font-label-sm text-label-sm text-outline">Editorial &amp; 35mm</span>
              </a>
              <a href="/video" class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm group hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-primary text-[22px]">videocam</span>
                <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Film Direction</span>
                <span class="font-label-sm text-label-sm text-outline">Cinematic Motion</span>
              </a>
              <a href="/design" class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm group hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-primary text-[22px]">category</span>
                <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Visual Identity</span>
                <span class="font-label-sm text-label-sm text-outline">Design Systems</span>
              </a>
              <a href="/website" class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm group hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-primary text-[22px]">web</span>
                <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">Digital Exp.</span>
                <span class="font-label-sm text-label-sm text-outline">Interactive Web</span>
              </a>
            </div>

            <!-- Archival Metrics Bar -->
            <div class="grid grid-cols-3 gap-space-md pt-space-lg">
              <div class="flex flex-col">
                <span class="font-display-lg text-display-lg text-primary tracking-tight">2020</span>
                <span class="font-label-sm text-label-sm text-secondary uppercase mt-space-xs">Years In Practice</span>
                <span class="font-body-sm text-body-sm text-outline">Active across 6 Regions</span>
              </div>
              <div class="flex flex-col">
                <span class="font-display-lg text-display-lg text-on-surface tracking-tight">38+</span>
                <span class="font-label-sm text-label-sm text-secondary uppercase mt-space-xs">Selected Projects</span>
                <span class="font-body-sm text-body-sm text-outline">Galleries &amp; Commercial</span>
              </div>
              <div class="flex flex-col">
                <span class="font-display-lg text-display-lg text-tertiary tracking-tight">06</span>
                <span class="font-label-sm text-label-sm text-secondary uppercase mt-space-xs">Disciplines</span>
                <span class="font-body-sm text-body-sm text-outline">Unified Studio Practice</span>
              </div>
            </div>

            <!-- Full Bio Action -->
            <div class="pt-space-sm">
              <a class="inline-flex items-center gap-space-sm text-primary font-headline-sm text-headline-sm group hover:text-on-surface transition-colors" href="/about">
                <span>Read Full Biography &amp; Philosophy</span>
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1.5 transition-transform">arrow_right_alt</span>
              </a>
            </div>
          </div>
        </div>
      </section>


      <!-- ============================================================
           SECTION 02: CURATED SELECTED WORKS (ASYMMETRIC BENTO GRID)
           ============================================================ -->
      <section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin py-space-3xl flex flex-col gap-space-2xl" id="curated-works">
        <!-- Section Title & Filter Chips -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
          <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-sm">
              <span class="font-label-md text-label-md text-tertiary uppercase">02 / CURATED WORKS</span>
              <span class="w-12 h-px bg-outline-variant/30"></span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Selected Projects (2025—2026)</h2>
          </div>

          <!-- Category Filter Bar -->
          <div class="flex flex-wrap items-center gap-space-xs p-space-xs rounded-full bg-surface-container-lowest/80 backdrop-blur-md border border-outline-variant/20 shadow-sm">
            <button class="filter-btn active px-space-md py-space-xs rounded-full font-label-sm text-label-sm bg-surface-container-high text-on-surface border border-outline-variant/30 shadow-sm backdrop-blur-md" data-category="all">ALL WORK</button>
            <button class="filter-btn px-space-md py-space-xs rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors border border-transparent hover:border-outline-variant/20" data-category="photo">PHOTO</button>
            <button class="filter-btn px-space-md py-space-xs rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors border border-transparent hover:border-outline-variant/20" data-category="film">FILM</button>
            <button class="filter-btn px-space-md py-space-xs rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors border border-transparent hover:border-outline-variant/20" data-category="design">DESIGN</button>
            <button class="filter-btn px-space-md py-space-xs rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-colors border border-transparent hover:border-outline-variant/20" data-category="web">INTERACTIVE</button>
          </div>
        </div>

        <!-- 4 Disciplines Asymmetric Showcase Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-space-lg">

          <!-- Item 01: Photo - The Ocean Series (Spans 7 cols) -->
          <div class="work-card md:col-span-7 flex flex-col gap-space-sm group cursor-pointer" data-category="photo">
            <a href="/foto" class="relative w-full aspect-[16/10] rounded-DEFAULT overflow-hidden bg-surface-container shadow-lg block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLUmgq8ihNYNNLzO10X4Fi1Ng3GBBBovXTJ7Bsd6tIsPtyUVmZB5LfEFaZ7AZwga9UKqnvmCPyxy2qnxnNFmyqQZPpaH4fnhYAK3gCutU8eZr2DGUFiyA4nAf7ImlPqH1FlnQi7OjcCbZDwVMCithWVdMYOYB9OzMz_U1ubX3s_ysCGddStb91qOU3x5bGPAlK_2BqrCVoJf8LvqDIRy6HxjLztTwnmbYUZk5of-XF0rZIylsIbeun"
                alt="Fine art black and white analog photo of breaking ocean waves on volcanic cliffs"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute top-space-md left-space-md">
                <span class="font-label-sm text-label-sm uppercase px-space-sm py-space-xs rounded-full bg-surface-container-lowest/80 backdrop-blur-md text-tertiary">PHOTOGRAPHY</span>
              </div>
              <div class="absolute bottom-space-md right-space-md">
                <span class="w-10 h-10 rounded-full bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-on-surface group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[20px]">north_east</span>
                </span>
              </div>
            </a>
            <div class="flex items-baseline justify-between px-space-xs">
              <div>
                <a href="/foto" class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors block">The Ocean Series</a>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Archival Monograph &amp; Large Format Print Exhibition</p>
              </div>
              <span class="font-label-md text-label-md text-outline">2026</span>
            </div>
          </div>

          <!-- Item 02: Film - The Last Light (Spans 5 cols) -->
          <div class="work-card md:col-span-5 flex flex-col gap-space-sm group cursor-pointer" data-category="film">
            <a href="/video" class="relative w-full aspect-[4/5] md:aspect-auto md:h-full rounded-DEFAULT overflow-hidden bg-surface-container shadow-lg flex flex-col justify-end block min-h-[300px]">
              <img
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCVsrViwITXH4R3FyJjPU_RTHfLWOsIA9fiCVGhoJDqwZXZh9FNerV8bC35aNMDdmtWTtiJTZ78Vy7Lf8NGu8T92Ui60TGIpAVpwYYPZ2kywgPRlgviK84b6Z3rD3dJuxruD0THx7k77JklMn3WxaxukoXurkwtYiOG-uqc8YsICDnN69oBGAihQ0ahK7DOaJ8eade_slnpW2ufg-r4vHvefPe7YU5Nn-8wKRGrS5jB4LNfRbIxuhbK"
                alt="Cinematic 35mm motion picture still with warm flare on mountain ridge"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent"></div>
              <div class="absolute top-space-md left-space-md flex items-center gap-space-xs">
                <span class="font-label-sm text-label-sm uppercase px-space-sm py-space-xs rounded-full bg-surface-container-lowest/80 backdrop-blur-md text-primary">FILM DIRECTION</span>
                <span class="px-space-sm py-space-xs rounded-full bg-error-container/80 text-on-error-container font-label-sm text-label-sm flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-error animate-pulse"></span>
                  REEL
                </span>
              </div>
              <div class="relative z-10 p-space-lg flex flex-col gap-space-xs">
                <div class="flex items-center justify-between">
                  <h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">The Last Light</h3>
                  <span class="font-label-md text-label-md text-outline">2026</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Narrative Short &amp; Festival Official Selection (16mm Cinema)</p>
              </div>
            </a>
          </div>

          <!-- Item 03: Design - Lumen Brand Identity (Spans 5 cols) -->
          <div class="work-card md:col-span-5 flex flex-col gap-space-sm group cursor-pointer" data-category="design">
            <a href="/design" class="relative w-full aspect-square rounded-DEFAULT overflow-hidden bg-surface-container-high shadow-lg block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbLNPRpGguviIR-bsQ2D2YKhwtK0ow5u0T_bwjr4Qc8E6j-J_eQ9E2fRKRSrWbO4k18vV4Le-yXya7X_lSL0vjZiLg-aTXqMqQLqpgeJEXbm_FXH8UR_TDMiLg3Zz83CWCmi9sDZUkJ7IB-k2lgMP9DC0EdkY0KU5bJpGtAAnYtjPOS9S35dZQQKX1m-rZzIi12E4PmVhw650CzHd_vxHhJghyjY6ncGyu71lHTkiChLCl2pKzBhJ6"
                alt="Brand identity packaging and stationery design"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
              <div class="absolute top-space-md left-space-md">
                <span class="font-label-sm text-label-sm uppercase px-space-sm py-space-xs rounded-full bg-surface-container-lowest/80 backdrop-blur-md text-secondary">BRANDING &amp; PACKAGING</span>
              </div>
              <div class="absolute bottom-space-md right-space-md">
                <span class="w-10 h-10 rounded-full bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-on-surface group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[20px]">north_east</span>
                </span>
              </div>
            </a>
            <div class="flex items-baseline justify-between px-space-xs">
              <div>
                <a href="/design" class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors block">Lumen Brand Identity</a>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Spatial Lighting Atelier Complete Visual System</p>
              </div>
              <span class="font-label-md text-label-md text-outline">2026</span>
            </div>
          </div>

          <!-- Item 04: Web - Aura Architecture (Spans 7 cols) -->
          <div class="work-card md:col-span-7 flex flex-col gap-space-sm group cursor-pointer" data-category="web">
            <a href="/website" class="relative w-full aspect-[16/10] rounded-DEFAULT overflow-hidden bg-surface-container shadow-lg block">
              <img
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAO6BDLECnJXG_N7pL-pOVMtc27seTbmE5t8qZjZEaGcIcd4iUz_T9o6eRjphwdQfZwrN0cOpAcejk7mBFTiXKFK28OIN3VrL4ySepUSRcPwuP6kX6y5JSFf-LaZMzDEwpXBtsZnpypr9Hp1t8TE_AB_lDtKIeVjsPqzHSaGHLF1oZpWsAtnnDt1CMmKi8Y-xw67vUWoY6iiHnx6vbW3DawyPwISxo2xCGzClt2En0QBYU_UGVDT7xN"
                alt="Interactive web experience with 3D spatial layout"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
              <div class="absolute top-space-md left-space-md">
                <span class="font-label-sm text-label-sm uppercase px-space-sm py-space-xs rounded-full bg-surface-container-lowest/80 backdrop-blur-md text-tertiary-fixed">WEBGL &amp; INTERACTIVE</span>
              </div>
              <div class="absolute bottom-space-md right-space-md">
                <span class="w-10 h-10 rounded-full bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-on-surface group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[20px]">north_east</span>
                </span>
              </div>
            </a>
            <div class="flex items-baseline justify-between px-space-xs">
              <div>
