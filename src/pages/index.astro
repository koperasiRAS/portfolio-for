---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import TechShowcase from "../components/TechShowcase.astro";
import HeroSection from "../components/HeroSection.astro";
import WorkMarquee from "../components/WorkMarquee.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";
import imgAsset3 from "../assets/foto/wedding/ultah raden 2 landscape.JPG";
import imgAsset4 from "../assets/thumbnails/thumbnail-video.png";
import imgAsset5 from "../assets/thumbnails/web2.png";
import imgAsset6 from "../assets/thumbnails/thumbnail-design.png";
import imgAsset7 from "../assets/foto/about rangga.jpg";
import imgAsset8 from "../assets/logos/ptnr-tokopedia.png";
import imgAsset9 from "../assets/logos/ptnr-kitabisa.png";
import imgAsset10 from "../assets/logos/ptnr-shopee.png";
import imgAsset11 from "../assets/logos/ptnr-bankqurban.png";
import imgAsset12 from "../assets/logos/ptnr-shinepartner.png";
import imgAsset13 from "../assets/logos/ptnr-mandiri.png";
---

<BaseLayout
  title="Frame Of Rangga | Visual Storyteller Foto, Video, Design & Web"
  description="Rangga Danuarta, Visual Storyteller berbasis di Depok. Spesialis fotografi komersial, videografi, brand design, dan web development untuk brand dan bisnis Anda."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/"
  hasHeroPreload={true}
>
  <!-- Navbar slot -->
  <Navbar slot="navbar" activePage="home" />

  <!-- HERO — Framer Motion island (SEO markup preserved via client:load) -->
  <HeroSection />

  <!-- WORK MARQUEE — Disney-Plus style thumbnail stripe -->
  <WorkMarquee />

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>


  <!-- EXPLORE CATEGORIES -->
  <section class="cat-section" id="categories" transition:animate="fade">
    <div class="cat-inner">
      <div class="cat-header fade-up">
        <h2 class="cat-title">Explore Categories</h2>
        <div class="cat-title-line"></div>
      </div>
      <div class="cat-grid">
        <a href="/foto" class="cat-card cat-card-foto">
          <Image             src={imgAsset3}
            alt="Birthday Photography Momen perayaan oleh Rangga Danuarta"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Capturing Essence</span>
            <h3 class="cat-card-title">Foto</h3>
          </div>
          <div class="cat-card-arrow">
            <span class="material-symbols-outlined">arrow_outward</span>
          </div>
        </a>
        <a href="/video" class="cat-card cat-card-video">
          <Image             src={imgAsset4}
            alt="Videography Portfolio Brand video dan dokumentasi event oleh Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Motion Theory</span>
            <h3 class="cat-card-title">Video</h3>
          </div>
        </a>
        <a href="/website" class="cat-card cat-card-website">
          <Image             src={imgAsset5}
            alt="Web Development Portfolio Portfolio dan landing page oleh Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Web App</span>
            <h3 class="cat-card-title">Website</h3>
          </div>
        </a>
        <a href="/design" class="cat-card cat-card-design">
          <Image             src={imgAsset6}
            alt="Brand Design Portfolio Identity dan advertising design oleh Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Visual Social Media</span>
            <h3 class="cat-card-title">Design</h3>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- COLOR GRADING & RETOUCHING INTERACTIVE SLIDER -->
  <section class="slider-section" id="color-science" transition:animate="fade">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <BeforeAfterSlider
        beforeImg={imgAsset3}
        afterImg={imgAsset3}
        beforeLabel="S-LOG3 / RAW"
        afterLabel="FINAL COLOR GRADE"
        metaText="Sony Alpha 7 Series • 35mm f/1.8 • 10-bit 4:2:2 Color Space • Custom Film LUT"
        title="Cinematic Color Grading & Retouching"
      />
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></di  <!-- ABOUT (Screenshot 2) -->
  <section class="about" id="about" transition:animate="fade">
    <div class="about-inner">
      <div class="about-photo fade-up">
        <div class="about-photo-wrap">
          <Image
            src={imgAsset7}
            alt="Rangga Danuarta Visual Storyteller"
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
      <div class="about-text fade-up">
        <h2 class="section-title" style="margin-bottom: 8px;">Tentang</h2>
        <p class="about-bio">
          Aku Rangga Danuarta, videografer, fotografer, dan developer di Depok. Lebih dari 3 tahun aku membantu brand dan bisnis membuat konten visual dan digital yang enak dilihat sekaligus mendukung tujuan pemasaran mereka.
        </p>
        <p class="about-bio">
          Kombinasi ini bukan kebetulan. Konten yang kuat butuh visual yang tepat dan platform yang mendukungnya, jadi tiap proyek aku kerjakan dari riset kebutuhan klien, eksekusi teknis, sampai hasil akhir yang siap dipakai.
        </p>
        <div class="about-skills-wrap">
          <span class="about-skill-pill">Videografi</span>
          <span class="about-skill-pill">Brand design</span>
          <span class="about-skill-pill">Fotografi</span>
          <span class="about-skill-pill">Editing</span>
          <span class="about-skill-pill">Astro</span>
          <span class="about-skill-pill">React</span>
          <span class="about-skill-pill">Node.js</span>
          <span class="about-skill-pill">PostgreSQL</span>
        </div>
        <div class="about-stats">
          <div class="stat-card">
            <span class="stat-number">3+</span>
            <span class="stat-label">Tahun pengalaman</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">4</span>
            <span class="stat-label">Layanan</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">6</span>
            <span class="stat-label">Brand partner</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- BRANDS -->
  <section class="brands" id="brands" transition:animate="fade">
    <div class="brands-inner fade-up">
      <p class="brands-label">Trusted by brands &amp; clients</p>
      <div class="logo-strip">
        <div class="logo-item">
          <Image src={imgAsset8} alt="Tokopedia" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset9} alt="KitaBisa" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset10} alt="Shopee" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset11} alt="Bank Qurban" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset12} alt="Shinepartner" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset13} alt="Mandiri" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- SERVICES (Screenshot 1: Sage Container) -->
  <section class="services" id="services" transition:animate="fade">
    <div class="services-inner">
      <div class="services-sage-box fade-up">
        <div class="services-header">
          <h2 class="services-title">Yang bisa aku kerjakan</h2>
        </div>
        <div class="services-grid">
          <!-- Photography -->
          <div class="svc-item">
            <h3 class="svc-title">Photography</h3>
            <p class="svc-desc">
              Foto komersial, birthday dan event, editorial, dan automotive dengan pendekatan storytelling yang kuat.
            </p>
            <a href={waLink("foto_general")} target="_blank" rel="noopener noreferrer" class="svc-link">
              Tanya via WhatsApp
            </a>
          </div>

          <!-- Videography -->
          <div class="svc-item">
            <h3 class="svc-title">Videography</h3>
            <p class="svc-desc">
              Produksi video dari konsep sampai final cut. Cocok untuk konten brand, dokumentasi acara, dan video promosi.
            </p>
            <a href={waLink("video_general")} target="_blank" rel="noopener noreferrer" class="svc-link">
              Tanya via WhatsApp
            </a>
          </div>

          <!-- Brand Design -->
          <div class="svc-item">
            <h3 class="svc-title">Brand Design</h3>
            <p class="svc-desc">
              Identitas visual, desain sosial media, poster, dan materi iklan yang membangun karakter brand secara konsisten.
            </p>
            <a href={waLink("design_general")} target="_blank" rel="noopener noreferrer" class="svc-link">
              Tanya via WhatsApp
            </a>
          </div>

          <!-- Web Development -->
          <div class="svc-item">
            <h3 class="svc-title">Web Development</h3>
            <p class="svc-desc">
              Website portofolio, landing page, dan undangan digital yang responsif, cepat, dan mengutamakan pengalaman pengguna.
            </p>
            <a href={waLink("web_general")} target="_blank" rel="noopener noreferrer" class="svc-link">
              Tanya via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- CREATIVE ENGINEERING & TECH SHOWCASE -->
  <TechShowcase />

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- WORKFLOW SECTION -->
  <section class="workflow-section" id="workflow" transition:animate="fade">
    <div class="workflow-inner">
      <div class="workflow-header fade-up">
        <span class="section-label">CARA KERJA</span>
        <h2 class="section-title">Alur Kerja Dari Brief sampai Delivery</h2>
        <p class="section-sub">
          Proses yang transparan dan terstruktur, supaya kamu tahu apa yang diharapkan di setiap tahap.
        </p>
      </div>
      <div class="workflow-steps fade-up">
        <div class="workflow-step">
          <div class="workflow-step-num">01</div>
          <div class="workflow-step-icon"><i class="fas fa-comments"></i></div>
          <h3 class="workflow-step-title">Brief &amp; Konsultasi</h3>
          <p class="workflow-step-desc">
            Ceritakan kebutuhan kamu topik, target audiens, dan goal. Diskusi gratis via WhatsApp. Saya bantu klarifikasi ide kamu.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">02</div>
          <div class="workflow-step-icon"><i class="fas fa-lightbulb"></i></div>
          <h3 class="workflow-step-title">Konsep &amp; Pitch</h3>
          <p class="workflow-step-desc">
            Saya kembangkan konsep visual sesuai brief. Moodboard, storyboard, atau wireframe dikasih untuk alignment sebelum eksekusi.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">03</div>
          <div class="workflow-step-icon"><i class="fas fa-cogs"></i></div>
          <h3 class="workflow-step-title">Eksekusi &amp; Produksi</h3>
          <p class="workflow-step-desc">
            Proses shooting, editing, atau development dengan update berkala. Kamu bisa monitor progress dan kasih feedback mid-way.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">04</div>
          <div class="workflow-step-icon"><i class="fas fa-sync-alt"></i></div>
          <h3 class="workflow-step-title">Revisi &amp; Fine-tuning</h3>
          <p class="workflow-step-desc">
            Feedback loop revisi hingga hasil sesuai ekspektasi. Revisi minor biasanya free, revisi major dihitung terpisah.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">05</div>
          <div class="workflow-step-icon"><i class="fas fa-download"></i></div>
          <h3 class="workflow-step-title">Delivery Final</h3>
          <p class="workflow-step-desc">
            File final dikirim dalam format yang disepakati. Untuk web: deployed dan ready. Untuk desain: print ready atau digital optimized.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- FAQ SECTION (Screenshot 3) -->
  <section class="faq-section" id="faq" transition:animate="fade">
    <div class="faq-inner">
      <div class="faq-header fade-up">
        <h2 class="section-title">Pertanyaan yang sering muncul</h2>
      </div>
      <div class="faq-list fade-up">
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Berapa lama pengerjaan setiap project?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Tergantung scope dan kompleksitas. Foto single session: 1-3 hari. Video: 3-7 hari. Desain brand: 1-2 minggu. Website: 2-4 minggu. Timeline exact akan dikasih setelah brief.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Apakah bisa revisi?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Ya! Setiap project include revisi. Photography: revisi edit 1x. Video: revisi 2x. Design: revisi 2x. Website: revisi minor included. Revisi major dihitung terpisah tapi biasanya masih reasonable.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Apakah melayani luar Depok atau Jakarta?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Untuk photography &amp; videography lokasi, saya bisa ke Jabodetabek. Untuk luar area, bisa arrange shoot dengan partner atau via remote editing. Web &amp; desain: anywhere, 100% remote.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Bagaimana cara pembayarannya?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Pembayaran via transfer bank (BCA, Mandiri, BSI). Skema: 50% DP saat konfirmasi, 50% sisanya saat final delivery. Untuk project kecil biasanya full payment di awal.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Bisa konsultasi dulu sebelum deal?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Absolutely! Konsultasi awal via WhatsApp itu gratis dan tidak mengikat. Ceritakan ide kamu, kita diskusi bareng kalau memang cocok, lanjut. Kalau tidak, ya tidak apa apa.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">File apa saja yang dikirim?</span>
            <span class="faq-plus-icon">+</span>
          </summary>
          <div class="faq-answer">
            Foto: JPEG high-res + web-optimized. Video: MP4 (1080p atau 4K). Desain: PNG/JPG + source file (AI/PSD/Figma). Website: deployed + source code. Semua dalam Google Drive yang aman.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- TESTIMONIALS (Screenshot 2: Kata klien) -->
  <section class="testimonials" id="testimonials" transition:animate="fade">
    <div class="testimonials-inner">
      <div class="testimonials-header fade-up">
        <h2 class="section-title">Kata klien</h2>
      </div>
      <div class="testimonials-grid fade-up">
        <!-- Card 1: White -->
        <div class="testimonial-card">
          <div>
            <span class="testimonial-quote-mark">&#8220;</span>
            <p class="testimonial-text">
              Rangga berhasil menangkap esensi brand kami dengan sangat baik. Hasil fotonya melebihi ekspektasi dan proses kerjanya sangat profesional.
            </p>
          </div>
          <div class="testimonial-footer">
            <div class="testimonial-avatar">TK</div>
            <div class="testimonial-meta">
              <p class="testimonial-name">Tim Kreatif Tokopedia</p>
              <p class="testimonial-role">Brand Team</p>
            </div>
          </div>
        </div>

        <!-- Card 2: Warm Sun Accent -->
        <div class="testimonial-card testimonial-card-sun">
          <div>
            <span class="testimonial-quote-mark">&#8220;</span>
            <p class="testimonial-text">
              Video campaign yang dibuat Rangga berhasil meningkatkan engagement kami secara signifikan. Storytelling-nya autentik dan emosional.
            </p>
          </div>
          <div class="testimonial-footer">
            <div class="testimonial-avatar" style="background: #12161C; color: #FFFFFF;">KB</div>
            <div class="testimonial-meta">
              <p class="testimonial-name">KitaBisa.com</p>
              <p class="testimonial-role">Marketing Division</p>
            </div>
          </div>
        </div>

        <!-- Card 3: White -->
        <div class="testimonial-card">
          <div>
            <span class="testimonial-quote-mark">&#8220;</span>
            <p class="testimonial-text">
              Desain brand identity dari Rangga sangat on-point. Beliau memahami kebutuhan bisnis dan menterjemahkannya ke visual yang powerful.
            </p>
          </div>
          <div class="testimonial-footer">
            <div class="testimonial-avatar">SP</div>
            <div class="testimonial-meta">
              <p class="testimonial-name">Shinepartner</p>
              <p class="testimonial-role">Brand Owner</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- CONTACT (Screenshot 3: Dark Box Container) -->
  <section class="contact" id="contact" transition:animate="fade">
    <div class="services-inner fade-up">
      <div class="contact-dark-box">
        <!-- Left info -->
        <div class="contact-left">
          <h2 class="contact-title">Punya proyek?</h2>
          <p class="contact-sub">
            Ceritakan singkat, aku balas secepatnya lewat WhatsApp atau email.
          </p>

          <div class="availability-beacon">
            <span class="beacon-dot"></span>
            Tersedia untuk project baru
          </div>

          <div class="contact-direct-links">
            <a href={waLink("contact")} target="_blank" rel="noopener noreferrer" class="contact-link-item">
              WhatsApp
            </a>
            <a href="mailto:frameofrangga@gmail.com" class="contact-link-item">
              frameofrangga@gmail.com
            </a>
            <a href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer" class="contact-link-item">
              Instagram @rggadnrt
            </a>
            <a href="https://instagram.com/frameofrangga" target="_blank" rel="noopener noreferrer" class="contact-link-item">
              Portofolio desain @frameofrangga
            </a>
          </div>
        </div>

        <!-- Right form -->
        <form id="contact-form" class="contact-dark-form" novalidate>
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            style="position:absolute;left:-9999px;opacity:0;"
          />

          <div class="form-group">
            <label for="name">Nama</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Nama lengkap"
              autocomplete="name"
            />
            <span class="form-error" id="name-error"></span>
          </div>

          <div class="form-group">
            <label for="project">Jenis proyek</label>
            <input
              type="text"
              id="project"
              name="project"
              placeholder="Video, foto, website..."
            />
            <span class="form-error" id="project-error"></span>
          </div>

          <div class="form-group">
            <label for="message">Cerita singkat</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Ceritakan gambaran proyek atau kebutuhan Anda..."></textarea>
            <span class="form-error" id="message-error"></span>
          </div>

          <div id="form-success" class="form-message form-success" style="display:none;">
            <i class="fas fa-check-circle"></i> Pesan terkirim! Saya akan membalas secepatnya.
          </div>
          <div id="form-error-msg" class="form-message form-error-msg" style="display:none;">
            <i class="fas fa-exclamation-circle"></i> Gagal mengirim. Silakan hubungi via WhatsApp.
          </div>

          <button type="submit" id="submit-btn" class="contact-dark-submit fx-layer fx-btn fx-glass-dk">
            <span class="fx-label">Kirim Pesan</span>
            <span class="fx-icon"><i class="fas fa-paper-plane" aria-hidden="true"></i></span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Floating WhatsApp Action Button -->
  <a
    href={waLink("general")}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-wa-btn fx-layer fx-btn fx-glass-dk fx-btn--sm"
    aria-label="Chat WhatsApp"
  >
    <span class="fx-label">Chat WhatsApp</span>
    <span class="fx-icon"><i class="fab fa-whatsapp" aria-hidden="true"></i></span>
  </a>

<style>
  /* ---- EXISTING PAGE RESPONSIVE ---- */
  @media (max-width: 768px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 0 24px;
    }
    .about-text {
      text-align: center;
    }
    .about-stats {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .about-inner {
      padding: 0 20px;
      gap: 32px;
    }
    .about-bio {
      font-size: 14px;
    }
    .about-stats {
      gap: 12px;
    }
    .section-title {
      font-size: 28px;
    }
  }

  /* ---- CATEGORIES SECTION ---- */
