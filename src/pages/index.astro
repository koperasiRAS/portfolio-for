---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";

import imgAsset1 from "../assets/design/social/carousels 1.png";
import imgAsset2 from "../assets/foto/foto cover halaman utama.jpg";
import imgAsset3 from "../assets/foto/wedding/ultah raden 2 landscape.JPG";
import imgAsset4 from "../assets/thumbnails/thumbnail-video.png";
import imgAsset5 from "../assets/thumbnails/web2.png";
import imgAsset6 from "../assets/thumbnails/thumbnail-design.png";
import imgAsset7 from "../assets/foto/about rangga.jpg";

import imgAsset8 from "../assets/logos/ptnr-tokopedia.png";
import imgAsset9 from "../assets/logos/ptnr-kitabisa.png";
import imgAsset10 from "../assets/logos/ptnr-shopee.png";
import imgAsset11 from "../assets/logos/ptnr-bankqurban.png";
import imgAsset12 from "../assets/logos/ptnr-shinepartner.png";
import imgAsset13 from "../assets/logos/ptnr-mandiri.png";
---

<BaseLayout
  title="Frame Of Rangga — Visual Storyteller & Creative Developer"
  description="Rangga Danuarta, Visual Storyteller & Developer berbasis di Depok. Spesialis fotografi komersial, videografi sinematik, brand design, dan web engineering."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/"
  hasHeroPreload={true}
>
  <!-- Navbar slot -->
  <Navbar slot="navbar" activePage="home" />

  <!-- HERO SECTION WITH NOCTURNAL GLASSMORPHISM & STRONG VALUE PROP -->
  <header class="stitch-hero" id="hero" transition:animate="fade">
    <!-- Background ambient glow blobs -->
    <div class="stitch-hero-glow-r" aria-hidden="true"></div>
    <div class="stitch-hero-glow-l" aria-hidden="true"></div>

    <!-- Background showcase artwork -->
    <div class="stitch-hero-bg" aria-hidden="true">
      <Image
        src={imgAsset1}
        alt="Frame Of Rangga Visual Portfolio Showcase"
        class="stitch-hero-bg-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="stitch-hero-bg-overlay"></div>
    </div>

    <!-- Hero grid: Left Text & Value Prop, Right Portrait -->
    <div class="stitch-hero-grid">
      <!-- Text Content -->
      <div class="stitch-hero-content">
        <!-- Badge -->
        <span class="stitch-badge">
          <i class="fas fa-sparkles"></i> Visual Storyteller &amp; Creative Developer
        </span>

        <!-- H1 Headline -->
        <h1 class="stitch-hero-title">
          Crafting Visual Stories<br />
          <span class="stitch-hero-title-accent">That Drive Real Impact.</span>
        </h1>

        <!-- High-Converting Description -->
        <p class="stitch-hero-desc">
          Satu pintu solusi kreatif untuk brand Anda — memadukan seni fotografi komersial, videografi sinematik, desain identitas visual, dan <em>web engineering</em> modern yang responsif.
        </p>

        <!-- CTA Buttons -->
        <div class="stitch-hero-cta-group">
          <a href="#categories" class="btn btn-primary">
            <i class="fas fa-layer-group"></i> Jelajahi Karya
          </a>
          <a href={waLink("collab")} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <i class="fab fa-whatsapp"></i> Chat via WhatsApp
          </a>
        </div>
      </div>

      <!-- Portrait Card -->
      <div class="stitch-hero-portrait">
        <div class="stitch-hero-portrait-inner">
          <Image
            src={imgAsset2}
            alt="Rangga Danuarta Frame Of Rangga"
            class="stitch-hero-portrait-img"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Floating Verified Badge -->
          <div class="stitch-hero-float-badge">
            <div class="stitch-float-badge-icon">
              <span class="material-symbols-outlined stitch-icon-filled">verified</span>
            </div>
            <div>
              <p class="stitch-float-badge-sub">Visual Storyteller</p>
              <p class="stitch-float-badge-name">Rangga Danuarta</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- EXPLORE CATEGORIES GRID -->
  <section class="cat-section" id="categories" transition:animate="fade">
    <div class="cat-inner">
      <div class="cat-header fade-up">
        <span class="section-label gradient-label">CURATED DISCIPLINES</span>
        <h2 class="cat-title">Explore Categories</h2>
        <div class="cat-title-line"></div>
      </div>

      <div class="cat-grid">
        <!-- Foto -->
        <a href="/foto" class="cat-card cat-card-foto">
          <Image
            src={imgAsset3}
            alt="Photography Showcase Rangga Danuarta"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Commercial &amp; Event Capture</span>
            <h3 class="cat-card-title">Foto</h3>
          </div>
          <div class="cat-card-arrow">
            <span class="material-symbols-outlined">arrow_outward</span>
          </div>
        </a>

        <!-- Video -->
        <a href="/video" class="cat-card cat-card-video">
          <Image
            src={imgAsset4}
            alt="Videography Portfolio Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Cinematic Reels &amp; Motion</span>
            <h3 class="cat-card-title">Video</h3>
          </div>
          <div class="cat-card-arrow">
            <span class="material-symbols-outlined">arrow_outward</span>
          </div>
        </a>

        <!-- Website -->
        <a href="/website" class="cat-card cat-card-website">
          <Image
            src={imgAsset5}
            alt="Web Development Portfolio Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Interactive Web Applications</span>
            <h3 class="cat-card-title">Website</h3>
          </div>
          <div class="cat-card-arrow">
            <span class="material-symbols-outlined">arrow_outward</span>
          </div>
        </a>

        <!-- Design -->
        <a href="/design" class="cat-card cat-card-design">
          <Image
            src={imgAsset6}
            alt="Brand Identity Design Frame Of Rangga"
            loading="lazy"
          />
          <div class="cat-card-overlay"></div>
          <div class="cat-card-content">
            <span class="cat-card-label">Brand Systems &amp; Identity</span>
            <h3 class="cat-card-title">Design</h3>
          </div>
          <div class="cat-card-arrow">
            <span class="material-symbols-outlined">arrow_outward</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- ABOUT ME SECTION (ONE-STOP CREATIVE SOLUTION) -->
  <section class="about" id="about" transition:animate="fade">
    <div class="about-inner">
      <div class="about-photo fade-up">
        <div class="about-photo-wrap">
          <Image
            src={imgAsset7}
            alt="Rangga Danuarta Portrait"
            loading="lazy"
          />
        </div>
      </div>
      <div class="about-text fade-up">
        <span class="section-label gradient-label">ONE-STOP CREATIVE SOLUTION</span>
        <h2 class="section-title">About Me</h2>
        <p class="about-bio">
          Saya Rangga Danuarta, fotografer, videografer, brand designer, dan web developer berbasis di Depok, Indonesia. Selama lebih dari 3 tahun, saya membantu brand dan bisnis menghadirkan konten visual serta platform digital yang tidak hanya estetis, namun berorientasi pada hasil nyata.
        </p>
        <p class="about-bio">
          Saya percaya bahwa proses kreatif yang baik tidak berhenti pada satu disiplin saja. Visual yang memukau membutuhkan narasi yang tepat dan platform web yang cepat untuk menyampaikannya. Oleh karena itu, saya meng-handle eksekusi kreatif secara end-to-end tanpa perlu merekrut banyak vendor terpisah.
        </p>

        <!-- Stats Counters -->
        <div class="about-stats">
          <div class="stat-card">
            <span class="stat-number" data-target="3">0</span>
            <span class="stat-label">Tahun Pengalaman</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="50">0</span>
            <span class="stat-label">Project Selesai</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="10">0</span>
            <span class="stat-label">Brand Partners</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="4">0</span>
            <span class="stat-label">Layanan Utama</span>
          </div>
        </div>

        <a
          href={waLink("collab")}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <i class="fab fa-whatsapp"></i> Chat via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- PROMINENT CLIENT BRANDS -->
  <section class="brands" id="brands" transition:animate="fade">
    <div class="brands-inner fade-up text-center">
      <p class="brands-label">TRUSTED BY BRANDS &amp; CLIENTS</p>
      <div class="logo-strip">
        <div class="logo-item">
          <Image src={imgAsset8} alt="Tokopedia" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset9} alt="KitaBisa" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset10} alt="Shopee" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset11} alt="Bank Qurban" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset12} alt="Shinepartner" loading="lazy" />
        </div>
        <div class="logo-item">
          <Image src={imgAsset13} alt="Mandiri" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- SERVICES SECTION (NO PRICELIST - DIRECT CONSULTATION) -->
  <section class="services" id="services" transition:animate="fade">
    <div class="services-inner">
      <div class="services-header fade-up">
        <span class="section-label gradient-label">WHAT I DO</span>
        <h2 class="section-title">Services</h2>
        <p class="section-sub" style="text-align: center;">
          Solusi kreatif lengkap untuk memperkuat citra dan pemasaran brand Anda
        </p>
      </div>
      <div class="services-grid">
        <ServiceCard
          icon="fas fa-camera"
          title="Photography"
          description="Fotografi komersial, event & birthday, editorial, serta produk dengan pencahayaan profesional dan tone warna tajam."
          whatsappKey="foto_general"
        />
        <ServiceCard
          icon="fas fa-video"
          title="Videography"
          description="Produksi video promosi, dokumentasi acara sinematik, dan reels media sosial dari konsep storyboard hingga final edit."
          whatsappKey="video_general"
        />
        <ServiceCard
          icon="fas fa-palette"
          title="Brand Design"
          description="Identitas brand, aset materi promosi, desain media sosial, dan materi iklan yang konsisten membangun citra bisnis Anda."
          whatsappKey="design_general"
        />
        <ServiceCard
          icon="fas fa-code"
          title="Web Development"
          description="Aplikasi web portofolio, landing page komersial, dan sistem web interaktif yang cepat, responsif, dan berorientasi UX."
          whatsappKey="web_general"
        />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- WORKFLOW SECTION -->
  <section class="workflow-section" id="workflow" transition:animate="fade">
    <div class="workflow-inner">
      <div class="workflow-header fade-up">
        <span class="section-label gradient-label">CARA KERJA</span>
        <h2 class="section-title">Alur Kerja Dari Brief sampai Delivery</h2>
        <p class="section-sub">
          Proses terstruktur dan transparan untuk memastikan hasil project memenuhi standar tertinggi.
        </p>
      </div>
      <div class="workflow-steps fade-up">
        <div class="workflow-step">
          <div class="workflow-step-num">01</div>
          <div class="workflow-step-icon"><i class="fas fa-comments"></i></div>
          <h3 class="workflow-step-title">Brief &amp; Konsultasi</h3>
          <p class="workflow-step-desc">
            Diskusi kebutuhan, konsep awal, dan target yang ingin dicapai melalui WhatsApp atau online meeting.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">02</div>
          <div class="workflow-step-icon"><i class="fas fa-lightbulb"></i></div>
          <h3 class="workflow-step-title">Konsep &amp; Storyboard</h3>
          <p class="workflow-step-desc">
            Penyusunan moodboard, sketsa visual, atau wireframe untuk menyelaraskan ekspektasi sebelum eksekusi.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">03</div>
          <div class="workflow-step-icon"><i class="fas fa-cogs"></i></div>
          <h3 class="workflow-step-title">Eksekusi &amp; Produksi</h3>
          <p class="workflow-step-desc">
            Proses shooting, pencahayaan, editing, atau coding web dengan standar kualitas teknis tinggi.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">04</div>
          <div class="workflow-step-icon"><i class="fas fa-sync-alt"></i></div>
          <h3 class="workflow-step-title">Revisi &amp; Review</h3>
          <p class="workflow-step-desc">
            Feedback loop untuk penyempurnaan detail karya hingga memenuhi kepuasan akhir Anda.
          </p>
        </div>
        <div class="workflow-connector" aria-hidden="true">
          <i class="fas fa-arrow-right"></i>
        </div>
        <div class="workflow-step">
          <div class="workflow-step-num">05</div>
          <div class="workflow-step-icon"><i class="fas fa-download"></i></div>
          <h3 class="workflow-step-title">Final Delivery</h3>
          <p class="workflow-step-desc">
            Penyerahan file resolusi tinggi, aset lengkap, atau live deployment website yang siap digunakan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- FAQ SECTION -->
  <section class="faq-section" id="faq" transition:animate="fade">
    <div class="faq-inner">
      <div class="faq-header fade-up">
        <span class="section-label gradient-label">FAQ</span>
        <h2 class="section-title">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="faq-list fade-up">
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Berapa lama estimasi pengerjaan setiap project?</span>
            <i class="fas fa-chevron-down faq-chevron"></i>
          </summary>
          <div class="faq-answer">
            Foto komersial/event: 1–3 hari kerja. Video &amp; Reels editing: 3–7 hari kerja. Brand Design: 1–2 minggu. Web Development: 2–3 minggu tergantung scope.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Apakah setiap project mendapatkan garansi revisi?</span>
            <i class="fas fa-chevron-down faq-chevron"></i>
          </summary>
          <div class="faq-answer">
            Ya! Setiap project menyertakan revisi untuk memastikan hasil akhir sesuai dengan brief dan kebutuhan brand Anda.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Apakah melayani lokasi shooting di luar Depok atau Jakarta?</span>
            <i class="fas fa-chevron-down faq-chevron"></i>
          </summary>
          <div class="faq-answer">
            Tentu. Saya melayani shooting on-location di seluruh wilayah Jabodetabek maupun area luar kota. Untuk project web dan desain dapat dilakukan 100% remote.
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">
            <span class="faq-q-text">Apakah bisa berdiskusi atau konsultasi ide terlebih dahulu?</span>
            <i class="fas fa-chevron-down faq-chevron"></i>
          </summary>
          <div class="faq-answer">
            Sangat bisa. Konsultasi awal via WhatsApp atau Google Meet bersifat gratis tanpa ikatan untuk membantu merumuskan kebutuhan visual Anda.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- TESTIMONIALS SECTION -->
  <section class="testimonials" id="testimonials" transition:animate="fade">
    <div class="testimonials-inner">
      <div class="testimonials-header fade-up">
        <span class="section-label gradient-label">REVIEWS</span>
        <h2 class="section-title">Kata Klien &amp; Partner</h2>
      </div>
      <div class="testimonials-scroll">
        <TestimonialCard
          quote="Rangga berhasil menangkap esensi brand kami dengan sangat baik. Hasil fotonya melebihi ekspektasi dan proses kerjanya sangat profesional."
          name="Tim Kreatif Tokopedia"
          role="Brand Team"
          initials="TK"
        />
        <TestimonialCard
          quote="Video campaign yang dibuat Rangga berhasil meningkatkan engagement kami secara signifikan. Storytelling-nya autentik dan emosional."
          name="KitaBisa.com"
          role="Marketing Division"
          initials="KB"
        />
        <TestimonialCard
          quote="Desain brand identity dari Rangga sangat on-point. Beliau memahami kebutuhan bisnis dan menterjemahkannya ke visual yang powerful."
          name="Shinepartner"
          role="Brand Owner"
          initials="SP"
        />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- INTERACTIVE CONTACT FORM SECTION -->
  <section class="contact" id="contact" transition:animate="fade">
    <div class="contact-inner fade-up">
      <div class="contact-header">
        <span class="section-label gradient-label">GET IN TOUCH</span>
        <h2 class="section-title">Let's Create Together</h2>
        <p class="section-sub">
          Sampaikan gambaran project Anda dan mari diskusi mengenai kolaborasi selanjutnya.
        </p>
      </div>

      <!-- Contact Form -->
      <form id="contact-form" class="contact-form stitch-form" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nama Anda / Brand *</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="mis. John Doe / Tokopedia"
              autocomplete="name"
              required
            />
          </div>
          <div class="form-group">
            <label for="email">WhatsApp / Email *</label>
            <input
              type="text"
              id="email"
              name="email"
              placeholder="mis. 08123456789 / email@domain.com"
              required
            />
          </div>
        </div>
        <div class="form-group">
          <label for="project">Jenis Project</label>
          <select id="project" name="project">
            <option value="" disabled selected>Pilih jenis project yang dibutuhkan</option>
            <option value="Photography">Fotografi Komersial / Event</option>
            <option value="Videography">Videography / Reels</option>
            <option value="Brand Design">Brand Design &amp; Assets</option>
            <option value="Web Development">Web Application / Portfolio</option>
            <option value="Lainnya">Lainnya / All-in-One Package</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Detail Project *</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Ceritakan tujuan, lokasi, atau konsep project yang Anda rencanakan..."
            required></textarea>
        </div>

        <div class="form-submit">
          <button type="submit" id="submit-btn" class="btn btn-primary">
            <i class="fab fa-whatsapp"></i> Kirim via WhatsApp
          </button>
        </div>
      </form>

      <div class="contact-divider">
        <span>atau hubungi langsung</span>
      </div>

      <div class="contact-buttons">
        <a
          href={waLink("contact")}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <i class="fab fa-whatsapp"></i> WhatsApp
        </a>
        <a
          href="https://instagram.com/rggadnrt"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <i class="fab fa-instagram"></i> Personal Instagram
        </a>
        <a
          href="https://instagram.com/frameofrangga"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <i class="fas fa-camera"></i> Design Portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- Footer slot -->
  <Footer slot="footer" variant="full" />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name')?.value || '';
        const contact = document.getElementById('email')?.value || '';
        const project = document.getElementById('project')?.value || 'General Inquiry';
        const msg = document.getElementById('message')?.value || '';

        const textMessage = `Halo Rangga! Saya ${name} (${contact}).\n\n` +
          `*Jenis Project:* ${project}\n` +
          `*Detail:* ${msg}\n\n` +
          `Saya tertarik untuk berdiskusi mengenai kolaborasi dengan Anda. Terima kasih!`;

        const waUrl = `https://wa.me/6287779560264?text=${encodeURIComponent(textMessage)}`;
        window.open(waUrl, '_blank');
      });
    }
  });
</script>

<style>
  /* =============================================
     STITCH HERO Mobile-first responsive
     ============================================= */

  .stitch-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 24px 64px;
    background-color: var(--bg-primary);
  }

  /* Background glow blobs */
  .stitch-hero-glow-r {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(
      circle,
      rgba(193, 128, 255, 0.12) 0%,
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    z-index: 1;
  }

  .stitch-hero-glow-l {
    position: absolute;
    bottom: -5%;
    left: -5%;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(163, 166, 255, 0.1) 0%,
