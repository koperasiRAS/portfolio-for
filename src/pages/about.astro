---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";
import ranggaPortrait from "../assets/foto/about rangga.jpg";
---

<BaseLayout
  title="About Rangga Danuarta | Visual Director & Monograph"
  description="Biography, artistic philosophy, and studio trajectory of Rangga Danuarta, creative director and visual storyteller based in Jakarta & Depok, Indonesia."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/about"
  bodyClass="bg-background text-on-surface selection:bg-primary selection:text-on-primary antialiased"
>
  <Navbar slot="navbar" activePage="about" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">
      
      <!-- Subtle Ambient Glow -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-primary-container/10 blur-[140px] pointer-events-none rounded-full"></div>
        
        <!-- ============================================================
             01. HERO SECTION: MONOGRAPH & DIRECTION
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-10 md:pt-16 pb-20 md:pb-28">
          <!-- Breadcrumb / Index Indicator -->
          <div class="flex items-center justify-between pb-8">
            <div class="flex items-center gap-2">
              <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">02 / ABOUT MONOGRAPH</span>
              <span class="w-1.5 h-1.5 rounded-full bg-tertiary/40"></span>
              <span class="font-['JetBrains_Mono'] text-xs text-on-surface-variant">EDITION 2026</span>
            </div>
            <div class="hidden sm:flex items-center gap-4 font-['JetBrains_Mono'] text-xs text-on-surface-variant">
              <span>LAT: -6.2088° S</span>
              <span>LON: 106.8456° E</span>
            </div>
          </div>

          <!-- Hero Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
            <div class="lg:col-span-7 flex flex-col gap-6">
              <div class="flex flex-col gap-2">
                <span class="font-['JetBrains_Mono'] text-xs text-secondary tracking-widest uppercase">Monograph &amp; Direction</span>
                <h1 class="font-['Hanken_Grotesk'] text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold uppercase tracking-tighter text-on-surface leading-[0.95]">
                  About<br />Rangga.
                </h1>
              </div>
              <p class="font-['Inter'] text-base sm:text-lg md:text-xl text-on-surface-variant font-normal max-w-xl leading-relaxed">
                Visual storyteller &amp; director based in Jakarta &amp; Depok, Indonesia. Crafting emotional cinema, raw light photography, and tactile spatial interfaces.
              </p>

              <!-- Core Stat Ticker -->
              <div class="grid grid-cols-3 gap-4 pt-4">
                <div class="flex flex-col gap-1 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 shadow-sm">
                  <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-tertiary leading-none">06<span class="text-tertiary text-xl">+</span></span>
                  <span class="font-['JetBrains_Mono'] text-[10px] sm:text-[11px] uppercase text-on-surface-variant mt-1">Years in Practice</span>
                </div>
                <div class="flex flex-col gap-1 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 shadow-sm">
                  <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-tertiary leading-none">42<span class="text-tertiary text-xl">+</span></span>
                  <span class="font-['JetBrains_Mono'] text-[10px] sm:text-[11px] uppercase text-on-surface-variant mt-1">Commissioned Works</span>
                </div>
                <div class="flex flex-col gap-1 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 shadow-sm">
                  <span class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold text-tertiary leading-none">04</span>
                  <span class="font-['JetBrains_Mono'] text-[10px] sm:text-[11px] uppercase text-on-surface-variant mt-1">Core Disciplines</span>
                </div>
              </div>
            </div>

            <!-- Hero Portrait with High-Contrast Editorial Cropping -->
            <div class="lg:col-span-5 relative">
              <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container shadow-2xl border border-outline-variant/25">
                <Image
                  src={ranggaPortrait}
                  alt="Monochrome low-key studio portrait of Rangga Danuarta"
                  class="w-full h-full object-cover contrast-110 grayscale"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent opacity-80"></div>
                <!-- Floating Portrait Badges -->
                <div class="absolute bottom-4 inset-x-4 flex items-center justify-between p-4 rounded-xl bg-background/85 backdrop-blur-md border border-outline-variant/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
                  <div>
                    <p class="font-['Hanken_Grotesk'] text-sm sm:text-base font-medium text-on-surface">Rangga Danuarta</p>
                    <p class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-on-surface-variant uppercase tracking-wider">Founder &amp; Principal Director</p>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             02. SECTION: 01 — MY STORY & ETHOS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-20 border-t border-outline-variant/15">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
            <!-- Section Sidebar Index -->
            <div class="lg:col-span-4 flex flex-col gap-4">
              <div class="flex items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">01 — Context</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold uppercase tracking-tight text-on-surface">
                My Story &amp;<br />Ethos
              </h2>
              <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant max-w-sm">
                From analog street archives across the archipelago to orchestrating commercial films and clean digital identities.
              </p>

              <!-- Quote Block -->
              <div class="mt-4 p-5 rounded-xl bg-surface-container-low border border-outline-variant/20 shadow-sm flex flex-col gap-2">
                <span class="material-symbols-outlined text-tertiary text-[28px]">format_quote</span>
                <p class="font-['Inter'] text-base text-on-surface italic leading-snug">
                  "Every frame carries an emotional gravity. The goal is never sheer aesthetic, but honest human resonance."
                </p>
                <span class="font-['JetBrains_Mono'] text-[11px] text-on-surface-variant uppercase mt-2">— Rangga, Studio Diary</span>
              </div>
            </div>

            <!-- Narrative Content + Candid Photography Bento -->
            <div class="lg:col-span-8 flex flex-col gap-8">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-['Inter'] text-sm sm:text-base text-on-surface-variant leading-relaxed">
                <p>
                  I am a director, photographer, and visual designer navigating the fertile intersection between honest documentary realism and contemporary graphic discipline. My practice began over half a decade ago, capturing the dense, kinetic streetscapes and authentic narratives of Indonesia.
                </p>
                <p>
                  Over time, still observation evolved into motion. Today, under the mantle of <strong class="text-on-surface font-medium">FRAME OF RANGGA</strong>, I direct brand films, construct distinct visual identity architectures, and curate bespoke digital web experiences.
                </p>
              </div>

              <!-- Candid Gallery Mosaic -->
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 pt-2">
                <div class="sm:col-span-7 h-64 sm:h-72 rounded-xl overflow-hidden relative shadow-md group border border-outline-variant/20 bg-surface-container">
                  <img
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCpGVa7y8Vnwr00h7gKk33RkQUjAl9ulowuBeAL_TpfKgqxqY9VJwoxaVtyTKNFBqBMyp-RbKn4L7jjco32jGEp1uQ8snuLiNDpktzCj1cpzChy1A4SG_P3pt2OKx0C7eXhhpeSSELWUtS9qDv8yJ1GkHDayh4VY4hE5Sllq-3AEaqRE_xaNXyEaQkpZuhFvv49RvoVrSelua3kn5nmvWNDjRTEX_-ffPKvxIaL16ktbAMVFmtIetn4"
                    alt="Cinematographer on set with camera rig"
                    loading="lazy"
                  />
                  <div class="absolute bottom-3 left-3 bg-background/80 backdrop-blur-md px-3 py-1 rounded-full border border-outline-variant/20">
                    <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-on-surface">SET PRODUCTION // ON LOCATION</span>
                  </div>
                </div>
                <div class="sm:col-span-5 h-64 sm:h-72 rounded-xl overflow-hidden relative shadow-md group border border-outline-variant/20 bg-surface-container">
                  <img
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUVOzdROmMi6S0er-2slMjHD2facCCaaisvUqbnwFHAPiP4F_gmavFbkbOBPKcMFV5BOup1x27nuZyu1sZ7gixY4k3AreTg8kJdtL-x6DlqFJygBkY4b0BJUBTjlasUgHKJ17TzS6CnOcsDxT7e4Ff5Cj1WmeOm19h2c98SZqY1c-LPQ4eimBelrF0cjYD1Du2F2y-FPsSpIHma-1j-G_rVJvdeiV5T1Wp0_DBaT9ixFkrKwA5lf09"
                    alt="Camera lenses and optics setup"
                    loading="lazy"
                  />
                  <div class="absolute bottom-3 left-3 bg-background/80 backdrop-blur-md px-3 py-1 rounded-full border border-outline-variant/20">
                    <span class="font-['JetBrains_Mono'] text-[10px] sm:text-xs text-on-surface">OPTICS &amp; WORKSPACE</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             03. SECTION: 02 — DISCIPLINES & FOCUS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-20 border-t border-outline-variant/15">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">02 — Expertise</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold uppercase tracking-tight text-on-surface">
                Disciplines &amp; Focus
              </h2>
            </div>
            <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant max-w-md">
              A four-pillar studio methodology engineered to maintain aesthetic cohesion across physical medium and digital surface.
            </p>
          </div>

          <!-- 4 Discipline Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            <!-- Photography Card -->
            <div class="flex flex-col justify-between p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors shadow-sm gap-6 group">
              <div class="flex flex-col gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-tertiary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">photo_camera</span>
                </div>
                <div>
                  <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase tracking-wider">Discipline 01</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Photography</h3>
                </div>
                <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  Editorial portraits, commercial campaigns, documentary photo essays, and analog 35mm formats.
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-2">
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Portraits</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">35mm</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Lookbooks</span>
              </div>
            </div>

            <!-- Filmmaking Card -->
            <div class="flex flex-col justify-between p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors shadow-sm gap-6 group">
              <div class="flex flex-col gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-tertiary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">movie</span>
                </div>
                <div>
                  <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase tracking-wider">Discipline 02</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Filmmaking</h3>
                </div>
                <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  Cinematic direction, documentary shorts, commercial stories, and DaVinci color grading.
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-2">
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Direction</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Docu</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Grading</span>
              </div>
            </div>

            <!-- Design Card -->
            <div class="flex flex-col justify-between p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors shadow-sm gap-6 group">
              <div class="flex flex-col gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-tertiary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">token</span>
                </div>
                <div>
                  <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase tracking-wider">Discipline 03</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Design</h3>
                </div>
                <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  Brand identity systems, typographical hierarchies, packaging, and spatial art direction.
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-2">
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Identity</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Systems</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Branding</span>
              </div>
            </div>

            <!-- Web Card -->
            <div class="flex flex-col justify-between p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 hover:border-tertiary/40 transition-colors shadow-sm gap-6 group">
              <div class="flex flex-col gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-tertiary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">language</span>
                </div>
                <div>
                  <span class="font-['JetBrains_Mono'] text-[11px] text-secondary uppercase tracking-wider">Discipline 04</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Web</h3>
                </div>
                <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  Tactile web experiences, creative frontend architecture, and modern digital portfolios.
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-2">
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Astro/React</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">UI / UX</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-on-surface-variant bg-background px-2.5 py-1 rounded-full border border-outline-variant/20">Performance</span>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             04. SECTION: 03 — JOURNEY / TIMELINE
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-20 border-t border-outline-variant/15">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
            <div class="lg:col-span-4 flex flex-col gap-4">
              <div class="flex items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-xs text-tertiary uppercase tracking-widest">03 — Trajectory</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-['Hanken_Grotesk'] text-3xl sm:text-4xl font-semibold uppercase tracking-tight text-on-surface">
                Journey &amp;<br />Milestones
              </h2>
              <p class="font-['Inter'] text-sm sm:text-base text-on-surface-variant">
                A chronological timeline documenting continuous exploration, from independent visual diaries to creative commissions.
              </p>
              <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 mt-4 flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary/20 text-tertiary flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">timelapse</span>
                </div>
                <div>
                  <p class="font-['JetBrains_Mono'] text-[10px] uppercase text-on-surface-variant">Current Operational State</p>
                  <p class="font-['Inter'] text-xs text-on-surface font-medium">Accepting Selected Projects 2026</p>
                </div>
              </div>
            </div>

            <!-- Chronology Steps -->
            <div class="lg:col-span-8 flex flex-col gap-4">
              <!-- Step 2024 - 2026 -->
              <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4 group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full bg-primary text-on-primary font-['JetBrains_Mono'] text-[10px] font-medium">Current Phase</span>
                    <span class="font-['JetBrains_Mono'] text-xs text-secondary">Scale &amp; Mastery</span>
                  </div>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Consolidating Frame of Rangga</h3>
                  <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant max-w-xl leading-relaxed">
                    Unifying photography, video production, brand design, and modern web engineering into a cohesive studio practice.
                  </p>
                </div>
                <span class="font-['Hanken_Grotesk'] text-4xl text-on-surface-variant/30 font-bold group-hover:text-tertiary transition-colors">24-26</span>
              </div>

              <!-- Step 2023 -->
              <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4 group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-1">
                  <span class="font-['JetBrains_Mono'] text-xs text-secondary">Studio Expansion</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Design Systems &amp; Web Development</h3>
                  <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant max-w-xl leading-relaxed">
                    Broadened creative capabilities to encompass high-performance web architecture and brand identity systems for businesses and brands.
                  </p>
                </div>
                <span class="font-['Hanken_Grotesk'] text-4xl text-on-surface-variant/30 font-bold group-hover:text-tertiary transition-colors">2023</span>
              </div>

              <!-- Step 2021 -->
              <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4 group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-1">
                  <span class="font-['JetBrains_Mono'] text-xs text-secondary">Independent Practice</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Solo Filmmaking &amp; Documentaries</h3>
                  <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant max-w-xl leading-relaxed">
                    Commissioned for commercial video shoots, event storytelling, wedding monographs, and independent motion projects.
                  </p>
                </div>
                <span class="font-['Hanken_Grotesk'] text-4xl text-on-surface-variant/30 font-bold group-hover:text-tertiary transition-colors">2021</span>
              </div>

              <!-- Step 2020 -->
              <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-4 group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-1">
                  <span class="font-['JetBrains_Mono'] text-xs text-secondary">Origins</span>
                  <h3 class="font-['Hanken_Grotesk'] text-xl font-medium text-on-surface mt-1">Visual Exploration &amp; Photography</h3>
                  <p class="font-['Inter'] text-xs sm:text-sm text-on-surface-variant max-w-xl leading-relaxed">
                    Deep dive into portrait photography, street documentary storytelling, and foundational video production across Greater Jakarta.
                  </p>
                </div>
                <span class="font-['Hanken_Grotesk'] text-4xl text-on-surface-variant/30 font-bold group-hover:text-tertiary transition-colors">2020</span>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             05. SECTION: PHILOSOPHY & SPECIFICATIONS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-20 border-t border-outline-variant/15">
          <div class="rounded-3xl bg-surface-container-low p-8 sm:p-12 md:p-16 shadow-xl relative overflow-hidden border border-outline-variant/25">
            <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 relative z-10">
