---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { Image } from "astro:assets";
import ranggaPortrait from "../assets/foto/about rangga.jpg";
---

<BaseLayout
  title="About Rangga Danuarta | Visual Director & Monograph"
  description="Biography, artistic philosophy, and studio trajectory of Rangga Danuarta, creative director and visual storyteller based in Jakarta & Depok, Indonesia."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/about"
  bodyClass="bg-background text-on-surface selection:bg-primary selection:text-on-primary antialiased"
>
  <Navbar slot="navbar" activePage="about" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">
      
      <!-- Subtle Ambient Glow -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-primary-container/10 blur-[140px] pointer-events-none rounded-full"></div>
        
        <!-- ============================================================
             01. HERO SECTION: MONOGRAPH & DIRECTION
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-space-xl pb-space-3xl">
          <!-- Breadcrumb / Index Indicator -->
          <div class="flex items-center justify-between pb-space-lg">
            <div class="flex items-center gap-space-xs">
              <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest" data-i18n="about.indexLabel">02 / ABOUT MONOGRAPH</span>
              <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
              <span class="font-label-sm text-label-sm text-outline" data-i18n="about.edition">EDITION 2026</span>
            </div>
            <div class="hidden sm:flex items-center gap-space-sm font-label-sm text-label-sm text-outline">
              <span>LAT: -6.2088° S</span>
              <span>LON: 106.8456° E</span>
            </div>
          </div>

          <!-- Hero Grid -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-end">
            <div class="lg:col-span-7 flex flex-col gap-space-lg">
              <div class="flex flex-col gap-space-xs">
                <span class="font-label-md text-label-md text-secondary tracking-widest uppercase" data-i18n="about.monographSubtitle">Monograph &amp; Direction</span>
                <h1 class="font-display-xl text-display-xl uppercase tracking-tighter text-on-surface">
                  About<br />Rangga.
                </h1>
              </div>
              <p class="font-headline-md text-headline-md text-on-surface-variant font-normal max-w-xl leading-relaxed" data-i18n="about.aboutSub">
                Visual storyteller &amp; director based in Jakarta &amp; Depok, Indonesia. Crafting emotional cinema, raw light photography, and tactile spatial interfaces.
              </p>

              <!-- Core Stat Ticker -->
              <div class="grid grid-cols-3 gap-space-md pt-space-lg">
                <div class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm">
                  <span class="font-display-lg text-display-lg text-primary leading-none">06<span class="text-tertiary text-headline-md">+</span></span>
                  <span class="font-label-sm text-label-sm uppercase text-outline" data-i18n="about.yearsLabel">Years in Practice</span>
                </div>
                <div class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm">
                  <span class="font-display-lg text-display-lg text-primary leading-none">42<span class="text-tertiary text-headline-md">+</span></span>
                  <span class="font-label-sm text-label-sm uppercase text-outline" data-i18n="about.worksLabel">Commissioned Works</span>
                </div>
                <div class="flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-low shadow-sm">
                  <span class="font-display-lg text-display-lg text-primary leading-none">04</span>
                  <span class="font-label-sm text-label-sm uppercase text-outline" data-i18n="about.disciplinesLabel">Core Disciplines</span>
                </div>
              </div>
            </div>

            <!-- Hero Portrait with High-Contrast Editorial Cropping -->
            <div class="lg:col-span-5 relative">
              <div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container shadow-2xl">
                <Image
                  src={ranggaPortrait}
                  alt="Monochrome low-key studio portrait of Rangga Danuarta"
                  class="w-full h-full object-cover grayscale contrast-125"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-80"></div>
                <!-- Floating Portrait Badges -->
                <div class="absolute bottom-space-md inset-x-space-md flex items-center justify-between p-space-md rounded-DEFAULT bg-surface-container-lowest/80 backdrop-blur-md border border-outline-variant/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
                  <div>
                    <p class="font-headline-sm text-headline-sm text-on-surface">Rangga Danuarta</p>
                    <p class="font-label-sm text-label-sm text-outline uppercase tracking-wider" data-i18n="about.founder">Founder &amp; Principal Director</p>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             02. SECTION: 01 — MY STORY & ETHOS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-3xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl">
            <!-- Section Sidebar Index -->
            <div class="lg:col-span-4 flex flex-col gap-space-md">
              <div class="flex items-center gap-space-xs">
                <span class="font-label-md text-label-md text-primary uppercase tracking-widest" data-i18n="about.contextSection">01 — Context</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-headline-lg text-headline-lg uppercase tracking-tight text-on-surface">
                My Story &amp;<br />Ethos
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant max-w-sm" data-i18n="about.storySub">
                From analog street archives across the archipelago to orchestrating large-scale narrative films and clean digital identities.
              </p>

              <!-- Quote Block -->
              <div class="mt-space-lg p-space-lg rounded-DEFAULT bg-surface-container-low shadow-sm flex flex-col gap-space-sm">
                <span class="material-symbols-outlined text-primary text-[28px]">format_quote</span>
                <p class="font-body-lg text-body-lg text-on-surface italic leading-snug">
                  "Every frame carries an emotional gravity. The goal is never sheer aesthetic, but honest human resonance."
                </p>
                <span class="font-label-sm text-label-sm text-outline uppercase mt-space-xs">— Rangga, Studio Diary</span>
              </div>
            </div>

            <!-- Narrative Content + Candid Photography Bento -->
            <div class="lg:col-span-8 flex flex-col gap-space-xl">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                <p>
                  I am a director, photographer, and visual designer navigating the fertile intersection between honest documentary realism and contemporary graphic discipline. My practice began over half a decade ago, capturing the dense, kinetic streetscapes and authentic narratives of Indonesia.
                </p>
                <p>
                  Over time, still observation evolved into motion. Today, under the mantle of <strong class="text-on-surface font-medium">FRAME OF RANGGA</strong>, I direct commercial films, construct distinct brand design languages, and curate immersive digital web interactions for brands worldwide.
                </p>
              </div>

              <!-- Candid Gallery Mosaic -->
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-space-md pt-space-md">
                <div class="sm:col-span-7 h-72 rounded-DEFAULT overflow-hidden relative shadow-md group">
                  <img
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCpGVa7y8Vnwr00h7gKk33RkQUjAl9ulowuBeAL_TpfKgqxqY9VJwoxaVtyTKNFBqBMyp-RbKn4L7jjco32jGEp1uQ8snuLiNDpktzCj1cpzChy1A4SG_P3pt2OKx0C7eXhhpeSSELWUtS9qDv8yJ1GkHDayh4VY4hE5Sllq-3AEaqRE_xaNXyEaQkpZuhFvv49RvoVrSelua3kn5nmvWNDjRTEX_-ffPKvxIaL16ktbAMVFmtIetn4"
                    alt="Cinematographer on set with camera rig"
                    loading="lazy"
                  />
                  <div class="absolute bottom-space-sm left-space-sm bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xs rounded-full">
                    <span class="font-label-sm text-label-sm text-on-surface">LOC: TANGKUBAN PERAHU / DIR. ROLL</span>
                  </div>
                </div>
                <div class="sm:col-span-5 h-72 rounded-DEFAULT overflow-hidden relative shadow-md group">
                  <img
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUVOzdROmMi6S0er-2slMjHD2facCCaaisvUqbnwFHAPiP4F_gmavFbkbOBPKcMFV5BOup1x27nuZyu1sZ7gixY4k3AreTg8kJdtL-x6DlqFJygBkY4b0BJUBTjlasUgHKJ17TzS6CnOcsDxT7e4Ff5Cj1WmeOm19h2c98SZqY1c-LPQ4eimBelrF0cjYD1Du2F2y-FPsSpIHma-1j-G_rVJvdeiV5T1Wp0_DBaT9ixFkrKwA5lf09"
                    alt="Camera lenses and optics setup"
                    loading="lazy"
                  />
                  <div class="absolute bottom-space-sm left-space-sm bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xs rounded-full">
                    <span class="font-label-sm text-label-sm text-on-surface">GEAR: LEICA M10-R ARCHIVE</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             03. SECTION: 02 — DISCIPLINES & FOCUS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-3xl">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-2xl">
            <div class="flex flex-col gap-space-xs">
              <div class="flex items-center gap-space-xs">
                <span class="font-label-md text-label-md text-primary uppercase tracking-widest" data-i18n="about.expertiseSection">02 — Expertise</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-headline-lg text-headline-lg uppercase tracking-tight text-on-surface">
                Disciplines &amp; Focus
              </h2>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-md" data-i18n="about.disciplinesSub">
              A four-pillar studio methodology engineered to maintain aesthetic cohesion across physical medium and digital surface.
            </p>
          </div>

          <!-- 4 Discipline Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Photography Card -->
            <div class="flex flex-col justify-between p-space-lg rounded-DEFAULT bg-surface-container-low hover:bg-surface-container transition-colors shadow-sm gap-space-xl group">
              <div class="flex flex-col gap-space-md">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">photo_camera</span>
                </div>
                <div>
                  <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Discipline 01</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Photography</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  Editorial portraits, evocative commercial campaigns, documentary photo essays, and analog 35mm/120mm medium format.
                </p>
              </div>
              <div class="flex flex-wrap gap-space-xs pt-space-md">
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Portraits</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">35mm Film</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Lookbooks</span>
              </div>
            </div>

            <!-- Filmmaking Card -->
            <div class="flex flex-col justify-between p-space-lg rounded-DEFAULT bg-surface-container-low hover:bg-surface-container transition-colors shadow-sm gap-space-xl group">
              <div class="flex flex-col gap-space-md">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">movie</span>
                </div>
                <div>
                  <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Discipline 02</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Filmmaking</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  Cinematic direction, short documentaries, mood films, commercial brand stories, and meticulous DaVinci color grading.
                </p>
              </div>
              <div class="flex flex-wrap gap-space-xs pt-space-md">
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Direction</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Docu-Narrative</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Color Grade</span>
              </div>
            </div>

            <!-- Design Card -->
            <div class="flex flex-col justify-between p-space-lg rounded-DEFAULT bg-surface-container-low hover:bg-surface-container transition-colors shadow-sm gap-space-xl group">
              <div class="flex flex-col gap-space-md">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">token</span>
                </div>
                <div>
                  <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Discipline 03</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Design</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  Comprehensive brand identity systems, typographical hierarchies, bespoke print editions, packaging, and spatial art direction.
                </p>
              </div>
              <div class="flex flex-wrap gap-space-xs pt-space-md">
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Identity</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Typography</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Art Direction</span>
              </div>
            </div>

            <!-- Web Card -->
            <div class="flex flex-col justify-between p-space-lg rounded-DEFAULT bg-surface-container-low hover:bg-surface-container transition-colors shadow-sm gap-space-xl group">
              <div class="flex flex-col gap-space-md">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
                  <span class="material-symbols-outlined text-[24px]">language</span>
                </div>
                <div>
                  <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Discipline 04</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Web</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  Tactile web experiences, creative frontend architecture, interactive exhibition sites, and digital archive portals.
                </p>
              </div>
              <div class="flex flex-wrap gap-space-xs pt-space-md">
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Webflow</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">Creative Dev</span>
                <span class="font-label-sm text-label-sm text-outline bg-surface-container-lowest px-space-sm py-space-xs rounded-full">UX / UI</span>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             04. SECTION: 03 — JOURNEY / TIMELINE
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-3xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl">
            <div class="lg:col-span-4 flex flex-col gap-space-md">
              <div class="flex items-center gap-space-xs">
                <span class="font-label-md text-label-md text-primary uppercase tracking-widest" data-i18n="about.trajectorySection">03 — Trajectory</span>
                <span class="w-8 h-[1px] bg-outline-variant/40"></span>
              </div>
              <h2 class="font-headline-lg text-headline-lg uppercase tracking-tight text-on-surface">
                Journey &amp;<br />Milestones
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant" data-i18n="about.journeySub">
                A chronological timeline documenting continuous exploration, from independent visual diaries to global creative commissions.
              </p>
              <div class="p-space-md rounded-DEFAULT bg-surface-container-low mt-space-md flex items-center gap-space-md">
                <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">timelapse</span>
                </div>
                <div>
                  <p class="font-label-sm text-label-sm uppercase text-outline" data-i18n="about.currentState">Current Operational State</p>
                  <p class="font-body-sm text-body-sm text-on-surface font-medium" data-i18n="about.accepting">Accepting Selected Projects</p>
                </div>
              </div>
            </div>

            <!-- Chronology Steps -->
            <div class="lg:col-span-8 flex flex-col gap-space-md">
              <!-- Step 2024 - 2026 -->
              <div class="p-space-lg rounded-DEFAULT bg-surface-container-low shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-space-md group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center gap-space-sm">
                    <span class="px-space-sm py-0.5 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm font-medium">Current Phase</span>
                    <span class="font-label-md text-label-md text-secondary">Global Scale</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Establishing Frame of Rangga</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Consolidating photography, film production, and digital design under a single studio umbrella. Directing commercial campaigns across Southeast Asia, Europe, and Japan.
                  </p>
                </div>
                <span class="font-display-lg text-display-lg text-outline/30 font-bold group-hover:text-primary transition-colors">24-26</span>
              </div>

              <!-- Step 2023 -->
              <div class="p-space-lg rounded-DEFAULT bg-surface-container-low shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-space-md group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-space-xs">
                  <span class="font-label-md text-label-md text-secondary">Studio Expansion</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Expansions in Design &amp; Web</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Broadened creative services to encompass high-end interactive websites and brand identity architectures for architecture firms, fashion houses, and tech products.
                  </p>
                </div>
                <span class="font-display-lg text-display-lg text-outline/30 font-bold group-hover:text-primary transition-colors">2023</span>
              </div>

              <!-- Step 2021 -->
              <div class="p-space-lg rounded-DEFAULT bg-surface-container-low shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-space-md group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-space-xs">
                  <span class="font-label-md text-label-md text-secondary">Independent Direction</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Solo Filmmaking &amp; Monograph</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Commissioned for independent documentary shorts, travel anthologies, and musical artist visuals. Released first curated photography photobook ‘The Silent Current’.
                  </p>
                </div>
                <span class="font-display-lg text-display-lg text-outline/30 font-bold group-hover:text-primary transition-colors">2021</span>
              </div>

              <!-- Step 2020 -->
              <div class="p-space-lg rounded-DEFAULT bg-surface-container-low shadow-sm flex flex-col sm:flex-row sm:items-start justify-between gap-space-md group hover:bg-surface-container transition-colors">
                <div class="flex flex-col gap-space-xs">
                  <span class="font-label-md text-label-md text-secondary">Origins</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface mt-space-xs">Visual Exploration &amp; Analog Roots</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
                    Deep dive into medium-format analog photography, street documentary storytelling across Java and Bali, and foundational video cinematography.
                  </p>
                </div>
                <span class="font-display-lg text-display-lg text-outline/30 font-bold group-hover:text-primary transition-colors">2020</span>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             05. SECTION: PHILOSOPHY & SPECIFICATIONS
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-3xl">
          <div class="rounded-DEFAULT bg-surface-container-low p-space-xl sm:p-space-3xl md:p-space-4xl shadow-xl relative overflow-hidden">
            <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl lg:gap-space-3xl relative z-10">
              <div class="lg:col-span-6 flex flex-col gap-space-lg">
                <div class="flex items-center gap-space-xs">
                  <span class="font-label-md text-label-md text-primary uppercase tracking-widest" data-i18n="about.philosophySection">Philosophy &amp; Ethos</span>
                </div>
                <h2 class="font-headline-lg text-headline-lg uppercase tracking-tight text-on-surface">
                  The Architecture of<br />Visual Presence.
                </h2>
                <div class="flex flex-col gap-space-md font-body-lg text-body-lg text-on-surface-variant">
                  <p>
                    In a digital sphere saturated with fleeting stimulation, we believe the most profound frames are those that breathe. Light, shadow, and pacing are active emotional instruments.
                  </p>
                  <p>
                    Whether filming a documentary sequence or developing a high-speed digital portfolio, our dedication remains unwavering: clear intent, zero superfluous noise, and an obsession with quality.
                  </p>
                </div>
              </div>

              <!-- Studio Equipment & Specifications -->
              <div class="lg:col-span-6 flex flex-col justify-between gap-space-lg">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider" data-i18n="about.specsLabel">Studio Specifications &amp; Arsenal</span>
