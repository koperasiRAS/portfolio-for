                <div class="dropzone-container" id="dropzone" onclick="document.getElementById('item-image-file').click()">
                  <i class="fas fa-cloud-upload-alt dropzone-icon"></i>
                  <div class="dropzone-text">Klik untuk pilih gambar atau seret file ke sini</div>
                  <div class="dropzone-hint">Format: JPG, PNG, WEBP (Maks. 15MB)</div>
                  <input type="file" id="item-image-file" accept="image/*" style="display: none;" onchange="previewUploadedImage(event)" />
                </div>

                <input type="text" id="item-image-path" placeholder="Atau masukkan path gambar (contoh: /assets/foto/...)" style="margin-top: 10px;" oninput="previewManualPath(event)" />
                
                <div id="image-preview-container" class="image-preview-box" style="display: none;">
                  <img id="image-preview" src="" alt="Preview" />
                  <button type="button" class="remove-img-btn" onclick="clearImagePreview()"><i class="fas fa-trash"></i> Hapus</button>
                </div>
              </div>

              <!-- VIDEOS FIELDS -->
              <div class="form-group" id="group-video-url" style="display: none;">
                <label for="item-video-url">URL Video (YouTube / Google Drive) <span class="req">*</span></label>
                <input type="text" id="item-video-url" placeholder="https://www.youtube.com/watch?v=..." />
              </div>

              <div class="form-grid-2" id="group-video-meta" style="display: none;">
                <div class="form-group">
                  <label for="item-video-duration">Durasi Video (Contoh: 02:30)</label>
                  <input type="text" id="item-video-duration" placeholder="02:30" />
                </div>
                <div class="form-group">
                  <label for="item-video-year">Tahun</label>
                  <input type="text" id="item-video-year" value="2024" />
                </div>
              </div>

              <!-- WEBSITES FIELDS -->
              <div class="form-group" id="group-web-url" style="display: none;">
                <label for="item-web-url">URL Website Live</label>
                <input type="text" id="item-web-url" placeholder="https://domain-anda.com" />
