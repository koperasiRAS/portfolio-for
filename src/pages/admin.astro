              <div class="tab-header-left">
                <h2>Keamanan & Ganti Password</h2>
                <p>Ubah password login panel admin CMS</p>
              </div>
            </div>

            <form id="security-form" style="max-width: 520px; background: var(--surface-card); backdrop-filter: blur(24px); padding: 36px; border-radius: var(--radius-lg); border: 1px solid var(--border-card);">
              <div class="form-group">
                <label for="sec-current">Password Saat Ini</label>
                <input type="password" id="sec-current" required />
              </div>
              <div class="form-group">
                <label for="sec-new">Password Baru</label>
                <input type="password" id="sec-new" placeholder="Minimal 5 karakter" required />
              </div>
              <div class="form-group">
                <label for="sec-confirm">Konfirmasi Password Baru</label>
                <input type="password" id="sec-confirm" required />
