          </section>
        </main>
      </div>
    </div>

    <!-- 3. UNIVERSAL CREATE / EDIT MODAL WITH SPLIT LIVE PREVIEW -->
    <div id="admin-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-box">
        <div class="modal-header">
          <h3 id="modal-title">Tambah Item Baru</h3>
          <button type="button" class="modal-close-btn" onclick="closeModal()">
            <i class="fas fa-times"></i>
          </button>
        </div>

        <form id="modal-form">
          <div class="modal-split-grid">
            <!-- LEFT COLUMN: FORM INPUTS -->
            <div class="modal-form-col">
              <input type="hidden" id="modal-type" />
              <input type="hidden" id="modal-slug" />
              <input type="hidden" id="modal-action" value="create" />

              <div class="form-group">
                <label for="item-title">Judul / Nama Karya <span class="req">*</span></label>
                <input type="text" id="item-title" required oninput="updateLivePreview()" />
