---
// Master Studio Admin CMS - Frame Of Rangga (Bespoke Pro Edition)
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Studio CMS | Frame Of Rangga</title>
  <meta name="robots" content="noindex, nofollow" />
  
  <!-- Premium Modern Typography: Outfit (Display) & Plus Jakarta Sans (UI) & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <style is:inline>
    /* ============================================================== */
    /* MASTER STUDIO DESIGN SYSTEM & BESPOKE UI/UX TOKENS             */
    /* ============================================================== */
    :root {
      /* Rich Slate & Ambient Indigo Mesh Background */
      --bg-base: #080c14;
      --bg-mesh: radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.18) 0px, transparent 50%),
                 radial-gradient(at 100% 0%, rgba(168, 85, 247, 0.16) 0px, transparent 50%),
                 radial-gradient(at 50% 100%, rgba(236, 72, 153, 0.12) 0px, transparent 55%),
                 #0b101d;

      /* Surfaces */
      --surface-glass: rgba(18, 26, 43, 0.75);
      --surface-glass-hover: rgba(26, 36, 58, 0.9);
      --surface-card: rgba(20, 29, 48, 0.68);
      --surface-card-hover: rgba(30, 43, 70, 0.9);
      --surface-input: rgba(11, 16, 28, 0.85);

      /* Refined Borders */
      --border-subtle: rgba(148, 163, 184, 0.12);
      --border-card: rgba(148, 163, 184, 0.18);
      --border-active: #818cf8;
      --border-glow: rgba(129, 140, 248, 0.35);

      /* Typography Colors */
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --text-dim: #94a3b8;
      --text-faint: #64748b;

      /* Premium Vibrant Accents */
      --accent-grad: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
      --accent-grad-hover: linear-gradient(135deg, #4f46e5 0%, #9333ea 50%, #db2777 100%);
      --accent-indigo: #6366f1;
      --accent-violet: #a855f7;
      --accent-pink: #ec4899;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-cyan: #06b6d4;

      /* Radii */
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-pill: 9999px;

      /* Motion */
      --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
      --transition-fast: 0.2s var(--ease-fluid);
      --transition-smooth: 0.35s var(--ease-fluid);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      color-scheme: dark;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      width: 100%;
      min-height: 100vh;
      background: var(--bg-mesh);
      background-attachment: fixed;
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.6;
      letter-spacing: 0;
      overflow-x: hidden;
      overflow-y: scroll;
    }

    h1, h2, h3, h4, .brand-title {
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.25;
    }

    /* Custom Sleek Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: rgba(8, 12, 20, 0.9); }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, rgba(99, 102, 241, 0.5), rgba(168, 85, 247, 0.5));
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #6366f1, #a855f7);
    }

    /* ── 1. LOGIN SCREEN ── */
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
    }

    .login-ambient-orb {
      position: absolute;
      width: 520px;
      height: 520px;
      background: radial-gradient(circle, rgba(168, 85, 247, 0.25) 0%, rgba(99, 102, 241, 0.12) 50%, transparent 70%);
      filter: blur(90px);
      pointer-events: none;
    }

    .login-card {
      width: 100%;
      max-width: 440px;
      background: var(--surface-glass);
      backdrop-filter: blur(32px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-lg);
      padding: 44px 38px;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.65), 0 0 40px rgba(99, 102, 241, 0.15);
      position: relative;
      z-index: 2;
      animation: loginFloat 0.6s var(--ease-fluid);
    }

    @keyframes loginFloat {
      from { opacity: 0; transform: translateY(24px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .login-brand { text-align: center; margin-bottom: 32px; }
    
    .brand-logo-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 60px;
      background: var(--accent-grad);
      color: #ffffff;
      border-radius: 18px;
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 18px;
      box-shadow: 0 10px 25px rgba(168, 85, 247, 0.45);
    }

    .login-brand h2 {
      font-size: 26px;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .login-brand p { font-size: 13.5px; color: var(--text-muted); }

    .login-error {
      background: rgba(239, 68, 68, 0.14);
      border: 1px solid rgba(239, 68, 68, 0.35);
      color: #fca5a5;
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
    }

    /* ── 2. DASHBOARD FRAMEWORK ── */
    .dashboard-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* TOPBAR */
    .admin-topbar {
      height: 72px;
      background: rgba(11, 16, 29, 0.85);
      backdrop-filter: blur(24px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-left { display: flex; align-items: center; gap: 14px; }
    
    .topbar-logo-badge {
      width: 40px;
      height: 40px;
      background: var(--accent-grad);
      color: #ffffff;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
    }

    .topbar-title {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
    }

    .status-live-chip {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--accent-emerald);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 1px;
    }
    .status-live-chip .pulse-dot {
      width: 7px;
      height: 7px;
      background: var(--accent-emerald);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent-emerald);
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .admin-body { display: flex; flex: 1; }

    /* SIDEBAR */
    .admin-sidebar {
      width: 280px;
      background: rgba(11, 16, 29, 0.7);
      backdrop-filter: blur(24px);
      border-right: 1px solid var(--border-subtle);
      padding: 24px 16px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .sidebar-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-faint);
      padding: 16px 14px 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      font-size: 13.5px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      text-align: left;
      transition: all var(--transition-fast);
      width: 100%;
    }

    .nav-item i { font-size: 14px; width: 18px; text-align: center; color: var(--text-dim); }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
      transform: translateX(3px);
    }
    .nav-item:hover i { color: #ffffff; }

    .nav-item.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.2));
      color: #ffffff;
      border-color: rgba(168, 85, 247, 0.4);
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.18);
    }
    .nav-item.active i { color: #a5b4fc; }

    .nav-badge {
      margin-left: auto;
      background: rgba(255, 255, 255, 0.08);
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
    }
    .nav-item.active .nav-badge {
      background: var(--accent-grad);
      color: #ffffff;
    }

    /* MAIN CONTENT VIEW */
    .admin-content {
      flex: 1;
      padding: 36px 44px;
      max-width: 1340px;
    }

    .tab-pane { display: none; }
    .tab-pane.active {
      display: block;
      animation: tabFade 0.35s var(--ease-fluid);
    }

    @keyframes tabFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .tab-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border-subtle);
      gap: 16px;
      flex-wrap: wrap;
    }

    .tab-header-left h2 {
      font-size: 26px;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .tab-header-left p {
      font-size: 13.5px;
      color: var(--text-muted);
    }

    /* STATS OVERVIEW CARDS */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 32px;
    }

    .stat-box {
      background: var(--surface-card);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-md);
      padding: 22px;
      display: flex;
      align-items: center;
      gap: 18px;
      cursor: pointer;
      transition: all var(--transition-smooth);
    }

    .stat-box:hover {
      transform: translateY(-4px);
      border-color: var(--border-active);
      background: var(--surface-card-hover);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 24px rgba(99, 102, 241, 0.2);
    }

    .stat-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .icon-purple { background: rgba(168, 85, 247, 0.2); color: #d8b4fe; }
    .icon-blue { background: rgba(99, 102, 241, 0.2); color: #a5b4fc; }
    .icon-pink { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
    .icon-green { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; }

    .stat-data h3 {
      font-size: 30px;
      font-weight: 800;
      line-height: 1.1;
      color: #ffffff;
    }

    .stat-data span {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* ── LUXURY COMMAND SEARCH & FILTER BAR ── */
    .command-bar-wrapper {
      background: var(--surface-glass);
      backdrop-filter: blur(24px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-lg);
      padding: 20px 24px;
      margin-bottom: 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .search-command-box {
      display: flex;
      align-items: center;
      background: var(--surface-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 6px 14px;
      transition: all var(--transition-fast);
      position: relative;
    }

    .search-command-box:focus-within {
      border-color: var(--border-active);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25), 0 6px 20px rgba(0, 0, 0, 0.35);
      background: rgba(14, 20, 36, 0.95);
    }

    .search-icon-orb {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-indigo);
      font-size: 15px;
      margin-right: 8px;
    }

    .search-command-input {
      flex: 1;
      background: transparent;
      border: none;
      color: #ffffff;
      font-size: 14px;
      font-family: inherit;
      outline: none;
      padding: 8px 0;
    }

    .search-command-input::placeholder {
      color: var(--text-dim);
      font-size: 13.5px;
    }

    .search-actions-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .search-clear-pill {
      background: rgba(255, 255, 255, 0.08);
      border: none;
      color: var(--text-dim);
      font-size: 11.5px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all var(--transition-fast);
    }
    .search-clear-pill:hover {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
    }

    .kbd-shortcut-chip {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
      color: var(--text-dim);
      user-select: none;
    }

    .command-bar-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }

    /* PILL FILTER CHIPS */
    .filter-pills-row {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding: 2px 0;
    }

    .filter-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      font-size: 12.5px;
      font-weight: 600;
      font-family: inherit;
      padding: 7px 16px;
      border-radius: var(--radius-pill);
      cursor: pointer;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
    }

    .filter-chip:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .filter-chip.active {
      background: var(--accent-grad);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
    }

    .chip-count {
      font-size: 11px;
      padding: 1px 6px;
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.25);
      font-family: 'JetBrains Mono', monospace;
    }

    .items-counter-chip {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      gap: 7px;
    }

    /* ── ITEMS GRID ── */
    .admin-items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    .admin-card {
      background: var(--surface-card);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all var(--transition-smooth);
    }

    .admin-card:hover {
      border-color: var(--border-active);
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45), 0 0 24px rgba(99, 102, 241, 0.2);
      transform: translateY(-4px);
    }

    .admin-card-thumb {
      width: 100%;
      height: 190px;
      background: #080c14;
      overflow: hidden;
      position: relative;
    }

    .admin-card-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s var(--ease-fluid);
    }

    .admin-card:hover .admin-card-thumb img {
      transform: scale(1.05);
    }

    .card-top-badges {
      position: absolute;
      top: 12px;
      left: 12px;
      display: flex;
      gap: 6px;
      z-index: 2;
    }

    .card-cat-pill {
      background: rgba(11, 16, 29, 0.88);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(168, 85, 247, 0.4);
      color: #d8b4fe;
      font-size: 10.5px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .card-star-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(11, 16, 29, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--text-dim);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 13px;
      transition: all var(--transition-fast);
      z-index: 2;
    }
    .card-star-btn:hover {
      transform: scale(1.15);
      color: #ffffff;
    }
    .card-star-btn.is-active {
      color: var(--accent-amber);
      border-color: var(--accent-amber);
      background: rgba(245, 158, 11, 0.25);
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.35);
    }

    .admin-card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .admin-card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 6px;
      line-height: 1.35;
    }

    .admin-card-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 18px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
    }

    .admin-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border-subtle);
    }

    .card-order-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-dim);
      background: rgba(255, 255, 255, 0.05);
      padding: 4px 9px;
      border-radius: 6px;
    }

    .card-actions { display: flex; gap: 8px; }

    .btn-sm-edit {
      background: rgba(99, 102, 241, 0.16);
      color: #c7d2fe;
      border: 1px solid rgba(99, 102, 241, 0.35);
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
    }
    .btn-sm-edit:hover {
      background: var(--accent-indigo);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .btn-sm-delete {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 6px 11px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .btn-sm-delete:hover {
      background: #ef4444;
      color: #ffffff;
      transform: translateY(-1px);
    }

    /* ── FORMS & BUTTONS ── */
    .form-group { margin-bottom: 18px; }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 7px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      background: var(--surface-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 11px 15px;
      color: #ffffff;
      font-size: 13.5px;
      font-family: inherit;
      transition: all var(--transition-fast);
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--border-active);
      background: rgba(18, 26, 44, 0.95);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }

    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .req { color: #f87171; }
    .form-hint { display: block; font-size: 12px; color: var(--text-dim); margin-top: 6px; }

    .btn-primary-admin {
      background: var(--accent-grad);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-sm);
      padding: 11px 22px;
      font-size: 13.5px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all var(--transition-fast);
      box-shadow: 0 4px 16px rgba(168, 85, 247, 0.35);
    }
    .btn-primary-admin:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 22px rgba(168, 85, 247, 0.5);
    }

    .btn-ghost-admin {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: #ffffff;
      border-radius: var(--radius-sm);
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all var(--transition-fast);
    }
    .btn-ghost-admin:hover {
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-1px);
    }

    .btn-danger-admin {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      border-radius: var(--radius-sm);
      padding: 10px 18px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: all var(--transition-fast);
    }
    .btn-danger-admin:hover { background: rgba(239, 68, 68, 0.25); }

    /* ── 3. UNIVERSAL MODAL WITH SPLIT LIVE PREVIEW ── */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(8, 12, 20, 0.85);
      backdrop-filter: blur(16px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      z-index: 1000;
    }

    .modal-box {
      width: 100%;
      max-width: 960px;
      max-height: 92vh;
      background: rgba(18, 26, 44, 0.96);
      backdrop-filter: blur(32px);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-lg);
      overflow-y: auto;
      box-shadow: 0 35px 90px rgba(0, 0, 0, 0.8), 0 0 40px rgba(99, 102, 241, 0.22);
      display: flex;
      flex-direction: column;
      animation: modalPop 0.35s var(--ease-fluid);
    }

    @keyframes modalPop {
      from { opacity: 0; transform: scale(0.96) translateY(14px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-header {
      padding: 22px 30px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: rgba(18, 26, 44, 0.98);
      z-index: 10;
    }
    .modal-header h3 { font-size: 20px; font-weight: 700; color: #ffffff; }
    .modal-close-btn { background: transparent; border: none; color: var(--text-dim); font-size: 20px; cursor: pointer; }
    .modal-close-btn:hover { color: #ffffff; }

    .modal-split-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 28px;
      padding: 26px 30px;
    }

    .modal-form-col { display: flex; flex-direction: column; }
    .modal-preview-col {
      display: flex;
      flex-direction: column;
      border-left: 1px solid var(--border-subtle);
      padding-left: 28px;
    }

    .preview-col-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-indigo);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    /* DROPZONE IMAGE UPLOADER */
    .dropzone-container {
      border: 2px dashed var(--border-card);
      border-radius: var(--radius-md);
      padding: 20px;
      text-align: center;
      background: rgba(11, 16, 28, 0.6);
      cursor: pointer;
      transition: all var(--transition-fast);
      position: relative;
    }
    .dropzone-container:hover, .dropzone-container.drag-over {
      border-color: var(--accent-indigo);
      background: rgba(99, 102, 241, 0.08);
    }
    .dropzone-icon {
      font-size: 28px;
      color: var(--accent-indigo);
      margin-bottom: 8px;
    }
    .dropzone-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 4px;
    }
    .dropzone-hint {
      font-size: 11.5px;
      color: var(--text-dim);
    }

    .image-preview-box {
      position: relative;
      width: 100%;
      height: 180px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      margin-top: 12px;
      background: #080c14;
      border: 1px solid var(--border-subtle);
    }
    .image-preview-box img { width: 100%; height: 100%; object-fit: cover; }
    
    .remove-img-btn {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(239, 68, 68, 0.9);
      color: #ffffff;
      border: none;
      border-radius: 6px;
      padding: 5px 11px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
    }

    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      padding: 18px 30px;
      border-top: 1px solid var(--border-subtle);
      background: rgba(18, 26, 44, 0.98);
      position: sticky;
      bottom: 0;
      z-index: 10;
    }

    /* TOAST */
    .toast-box {
      position: fixed;
      bottom: 28px;
      right: 28px;
      background: rgba(18, 26, 44, 0.96);
      border: 1px solid var(--border-active);
      color: #ffffff;
      padding: 14px 24px;
      border-radius: var(--radius-md);
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
      display: none;
      z-index: 2000;
      animation: toastIn 0.3s var(--ease-fluid);
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .toast-box.toast-success { border-color: rgba(16, 185, 129, 0.5); background: rgba(6, 78, 59, 0.95); color: #a7f3d0; }
    .toast-box.toast-error { border-color: rgba(239, 68, 68, 0.5); background: rgba(127, 29, 29, 0.95); color: #fecaca; }

    @media (max-width: 960px) {
      .modal-split-grid { grid-template-columns: 1fr; }
      .modal-preview-col { border-left: none; padding-left: 0; border-top: 1px solid var(--border-subtle); padding-top: 24px; }
      .admin-body { flex-direction: column; }
      .admin-sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border-subtle); }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .admin-content { padding: 24px 18px; }
    }

    @media (max-width: 600px) {
      .stats-grid { grid-template-columns: 1fr; }
      .form-grid-2 { grid-template-columns: 1fr; }
    }
  </style>
</head>
