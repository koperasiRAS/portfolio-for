---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { getWebsites } from "../utils/content.js";

const websites = getWebsites();
const categories = [...new Set(websites.map(w => w.category).filter(Boolean))];
const totalWebsites = websites.length;

const heroFeature = websites.find(w => w.featuredHome) || websites[0];
const heroSrc = heroFeature?.thumbnailPath || '/assets/thumbnails/thumbnail_portfolio.png';
---

<BaseLayout
  title="Web Development & Digital Experiences | FRAME OF RANGGA"
  description="High-performance interactive websites, bespoke digital experiences, and web architecture engineered by Rangga Danuarta."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/website"
>
  <Navbar slot="navbar" activePage="website" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- ============================================================
           SECTION 1: HEADER & DISCIPLINE IDENTITY
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-space-xl pb-space-lg">
        <div class="flex flex-col gap-space-sm max-w-4xl">
          <div class="flex items-center gap-space-xs text-tertiary">
            <span class="w-2 h-2 rounded-full bg-primary shadow-[0_0_12px_primary]"></span>
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary">DISCIPLINE 06 / 06 • DIGITAL PRODUCTS &amp; ARCHITECTURE</span>
          </div>
          <div class="flex items-baseline gap-space-md">
            <h1 class="font-display-xl text-display-xl text-on-surface tracking-tighter" data-i18n="web.title">Web.</h1>
            <span class="font-label-md text-label-md text-outline font-normal">[ {totalWebsites} BUILDS CATALOGUED ]</span>
          </div>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed" data-i18n="web.heroSub">
            Interactive websites, digital experiences, and bespoke web architecture engineered for tactile visual impact. Merging physical darkroom rigor with low-latency WebGL orchestration.
          </p>
        </div>

        <!-- Glass Filter Capsule (dynamic from CMS) -->
        {totalWebsites > 0 && (
        <div class="mt-space-xl flex flex-wrap items-center gap-space-xs p-space-xs rounded-full bg-surface-container-low/60 backdrop-blur-xl shadow-lg border border-outline-variant/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] w-fit" id="web-filter-bar">
          <button class="filter-btn active flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md transition-all bg-primary-container text-on-primary-container shadow-md border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] cursor-pointer" data-filter="all">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span>ALL BUILDS</span>
          </button>
          {categories.map(cat => (
            <button class="filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 border border-transparent hover:border-outline-variant/20 cursor-pointer" data-filter={cat.toLowerCase()}>
              <span class="uppercase">{cat}</span>
            </button>
          ))}
        </div>
        )}
      </section>


      <!-- ============================================================
           SECTION 2: FEATURED DIGITAL FLAGSHIP (from CMS)
           ============================================================ -->
      {heroFeature ? (
      <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto my-space-xl">
        <div class="relative rounded-lg bg-surface-container-lowest p-space-lg md:p-space-2xl overflow-hidden shadow-2xl">
          <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-primary/10 blur-[120px] pointer-events-none"></div>
          <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-tertiary/10 blur-[140px] pointer-events-none"></div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-space-lg gap-space-sm">
            <div class="flex items-center gap-space-sm">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
              </span>
              <span class="font-label-md text-label-md uppercase tracking-wider text-on-surface">LIVE PRODUCTION REEL</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center pt-space-md">
            <!-- Desktop Screen Mockup Frame -->
            <div class="lg:col-span-8 relative group">
              <div class="rounded bg-surface-container-high/70 p-space-xs shadow-2xl backdrop-blur-sm transition-transform duration-500 hover:scale-[1.005]">
                <div class="flex items-center justify-between px-space-sm py-space-xs bg-surface-container-lowest/80 rounded-t-sm">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]/80"></span>
                  </div>
                  <div class="bg-surface-container-high/40 px-space-lg py-0.5 rounded-full text-center">
                    <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                      <span class="material-symbols-outlined text-[11px] text-primary">lock</span>
                      {heroFeature.liveUrl?.replace(/^https?:\/\//, '') || 'frameofrangga.com'}
                    </span>
                  </div>
                  <div class="flex items-center gap-space-xs text-outline">
                    <span class="material-symbols-outlined text-[14px]">tune</span>
                  </div>
                </div>
                <div class="relative aspect-[16/10] overflow-hidden rounded-b-sm bg-surface-container-lowest">
                  <img
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    src={heroSrc}
                    alt={heroFeature.title}
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-60"></div>
                </div>
              </div>
            </div>

            <!-- Meta Specification Column -->
            <div class="lg:col-span-4 flex flex-col justify-between h-full gap-space-md">
              <div class="space-y-space-sm">
                <span class="font-label-sm text-label-sm text-tertiary uppercase tracking-widest font-semibold">Flagship Implementation</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">{heroFeature.title}</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  {heroFeature.description}
                </p>
              </div>

              {heroFeature.techStack && (
              <div class="space-y-space-xs">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Technology Architecture</span>
                <div class="flex flex-wrap gap-1.5">
                  {heroFeature.techStack.split(',').map(t => (
                    <span class="font-label-sm text-label-sm px-space-sm py-1 rounded bg-surface-container-high text-secondary">{t.trim()}</span>
                  ))}
                </div>
              </div>
              )}

              <div class="flex items-center gap-space-sm pt-space-xs">
                <a
                  class="px-space-lg py-space-sm rounded-full bg-primary text-on-primary font-headline-sm text-[14px] font-semibold transition-all hover:scale-105 hover:shadow-[0_0_24px_rgba(180,197,255,0.4)] flex items-center gap-1.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] border border-outline-variant/30"
                  href={heroFeature.liveUrl || waLink('web')}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Explore Live</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      ) : null}


      <!-- ============================================================
           SECTION 3: RECENT BUILDS INDEX (dynamic from CMS)
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto my-space-2xl">
        {totalWebsites > 1 && (
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-space-xl gap-space-sm">
          <div class="space-y-space-xs">
            <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Selected Commissions &amp; Works</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Interactive Index</h2>
          </div>
          <div class="flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm">
            <span class="material-symbols-outlined text-[16px] text-primary">data_object</span>
            <span>{totalWebsites} PRODUCTION EXPERIENCES CATALOGUED</span>
          </div>
        </div>
        )}

        {totalWebsites === 0 ? (
        <div class="w-full p-space-xl rounded-lg bg-surface-container-low/60 text-center">
          <p class="font-body-md text-on-surface-variant">No websites published yet. Manage your builds in the CMS portal.</p>
        </div>
        ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg" id="web-projects-grid">
          {websites.map((item) => (
          <article class="project-card group relative rounded-lg bg-surface-container-low overflow-hidden transition-all duration-500 hover:shadow-2xl flex flex-col justify-between" data-category={item.category?.toLowerCase() || ''}>
            <div class="relative aspect-[16/10] overflow-hidden bg-surface-container-lowest">
              <img
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src={item.thumbnailPath || '/assets/thumbnails/thumbnail_landing_page.png'}
                alt={item.title}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent opacity-80"></div>
              <div class="absolute top-space-sm left-space-sm flex items-center gap-space-xs">
                <span class="font-label-sm text-label-sm px-space-sm py-0.5 rounded-full bg-surface-container-lowest/80 text-on-surface backdrop-blur-md">{item.year || ''}</span>
                {item.category && (
                <span class="font-label-sm text-label-sm px-space-sm py-0.5 rounded-full bg-primary/20 text-primary backdrop-blur-md uppercase">{item.category}</span>
                )}
              </div>
              <a
                class="absolute top-space-sm right-space-sm w-9 h-9 rounded-full bg-surface-container-lowest/80 text-on-surface flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-md hover:bg-primary hover:text-on-primary"
                href={item.liveUrl || waLink('web')}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Discuss the ${item.title} build`}
              >
                <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
              </a>
            </div>
            <div class="p-space-lg space-y-space-md flex-1 flex flex-col justify-between">
              <div class="space-y-space-xs">
                <div class="flex items-center justify-between">
                  <h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">{item.title}</h3>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  {item.description}
                </p>
              </div>
              {item.techStack && (
              <div class="space-y-space-sm pt-space-xs">
                <div class="flex flex-wrap gap-1.5">
                  {item.techStack.split(',').map(t => (
                    <span class="font-label-sm text-label-sm px-space-sm py-0.5 rounded bg-surface-container text-secondary">{t.trim()}</span>
                  ))}
                </div>
              </div>
              )}
            </div>
          </article>
          ))}
        </div>
        )}
      </section>


      <!-- ============================================================
           SECTION 4: CALL TO ACTION BANNER
           ============================================================ -->
      <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto mb-space-2xl">
        <div class="relative rounded-lg bg-surface-container-high/60 backdrop-blur-xl p-space-xl md:p-space-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-space-xl">
          <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-primary/20 blur-[100px] pointer-events-none"></div>
          <div class="space-y-space-sm max-w-xl z-10">
            <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest font-mono" data-i18n="web.ctaLabel">NEW COMMISSIONS</span>
            <h3 class="font-headline-lg text-headline-lg text-on-surface tracking-tight" data-i18n="web.ctaTitle">
              Ready to build a bespoke digital experience?
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant" data-i18n="web.ctaSub">
              Available for international design systems, custom WebGL narrative productions, and high-performance interactive flagships.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-space-sm z-10 w-full md:w-auto">
            <a
              class="w-full sm:w-auto px-space-xl py-space-sm rounded-full bg-primary text-on-primary font-headline-sm text-[15px] font-semibold text-center hover:scale-105 transition-all shadow-[0_0_24px_rgba(180,197,255,0.4)] shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] border border-outline-variant/30"
              href={waLink('web')}
              target="_blank"
              rel="noopener noreferrer"
            >
              Get in Touch
            </a>
            <a
              class="w-full sm:w-auto px-space-lg py-space-sm rounded-full bg-surface-container text-on-surface font-body-sm text-body-sm text-center hover:bg-surface-container-highest transition-colors border border-outline-variant/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]"
              href="/"
            >
              Return to Index
            </a>
          </div>
        </div>
      </section>

    </div>

    <!-- Filter Script -->
    <script is:inline>
      function initWebFilters() {
        if (window.__webFiltersInit) return;
        window.__webFiltersInit = true;

        const filterButtons = document.querySelectorAll('.filter-btn');
        const projectCards = document.querySelectorAll('.project-card');

        filterButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            filterButtons.forEach(b => {
              b.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-md', 'active');
              b.classList.add('text-on-surface-variant');
            });
            btn.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-md', 'active');
            btn.classList.remove('text-on-surface-variant');

            const filter = btn.getAttribute('data-filter');
            projectCards.forEach(card => {
              const categories = card.getAttribute('data-category') || '';
              card.style.display = (filter === 'all' || categories.includes(filter)) ? 'flex' : 'none';
            });
          });
        });
      }

      document.addEventListener('astro:page-load', initWebFilters);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWebFilters);
      } else {
        initWebFilters();
      }
    </script>
  </main>

  <!-- Monolithic Footer -->
  <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/20 pt-space-3xl pb-space-2xl mt-space-3xl">
    <div class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto flex flex-col gap-space-2xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-space-xl">
        <div class="md:col-span-5 flex flex-col gap-space-md">
          <span class="font-headline-md text-headline-md uppercase tracking-tight text-on-surface">FRAME OF RANGGA</span>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Multi-disciplinary visual storyteller &amp; director operating across photography, cinematic direction, graphic systems, and spatial web experiences.
          </p>
          <div class="flex flex-wrap gap-space-xs pt-space-xs">
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Photography</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Film Direction</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Visual Identity</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Web Experiences</span>
          </div>
        </div>
        <div class="md:col-span-3 md:col-start-7 flex flex-col gap-space-sm">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Index</span>
          <div class="flex flex-col gap-space-xs">
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/">Home</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/about">About Monograph</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/foto">Photo Archive</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/video">Video &amp; Film Reel</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/design">Design Identities</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="/website">Interactive Web</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">Inquiries &amp; Booking</a>
          </div>
        </div>
        <div class="md:col-span-3 flex flex-col gap-space-sm">
          <span class="font-label-md text-label-md uppercase tracking-wider text-outline">Dispatches</span>
          <div class="flex flex-col gap-space-xs">
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer">Instagram (@rggadnrt)</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="https://tiktok.com/@madebyrangga" target="_blank" rel="noopener noreferrer">TikTok (@madebyrangga)</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href={waLink('general')} target="_blank" rel="noopener noreferrer">WhatsApp Direct</a>
            <a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" href="mailto:frameofrangga@gmail.com">frameofrangga@gmail.com</a>
          </div>
          <div class="mt-space-md p-space-md rounded bg-surface-container-low/70 border border-outline-variant/20">
            <p class="font-headline-sm text-headline-sm text-primary">Create. Capture. Inspire.</p>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-space-xs">Curated cinematic showcase edition 2026</p>
          </div>
        </div>
      </div>
      <div class="pt-space-lg border-t border-outline-variant/10 flex flex-col md:flex-row items-center justify-between gap-space-md">
        <span class="font-label-sm text-label-sm text-outline">© {new Date().getFullYear()} FRAME OF RANGGA. All rights reserved.</span>
        <div class="flex items-center gap-space-lg font-label-sm text-label-sm text-outline">
          <span>Jakarta, Indonesia (WIB GMT+7)</span>
          <span>Cinematic Darkroom Specification</span>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
