    <script is:inline>
      function initWebFilters() {
        if (window.__webFiltersInit) return;
        window.__webFiltersInit = true;

        const filterButtons = document.querySelectorAll('.filter-btn');
        const projectCards = document.querySelectorAll('.project-card');

        filterButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            filterButtons.forEach(b => {
              b.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-md', 'active');
              b.classList.add('text-on-surface-variant');
            });
            btn.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-md', 'active');
            btn.classList.remove('text-on-surface-variant');

            const filter = btn.getAttribute('data-filter');
            projectCards.forEach(card => {
              const categories = card.getAttribute('data-category') || '';
              card.style.display = (filter === 'all' || categories.includes(filter)) ? 'flex' : 'none';
            });
          });
        });

        // Toggle audit terminal
        const specsBtn = document.getElementById('toggleSpecsBtn');
        const specsPanel = document.getElementById('specsPanel');
        if (specsBtn && specsPanel) {
          specsBtn.addEventListener('click', () => {
            specsPanel.classList.toggle('hidden');
          });
        }
      }

      document.addEventListener('astro:page-load', initWebFilters);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWebFilters);
      } else {
        initWebFilters();
      }
    </script>
