---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getWebsites } from '../utils/content.js';

const websites = getWebsites();
---

<BaseLayout
  title="Web Development | Frame Of Rangga"
  description="Jasa pembuatan website profesional portfolio, landing page, company profile, dan web app yang responsive, fast, dan berorientasi pada pengalaman pengguna."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-website.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/website"
  hasGlightbox={true}
>
  <Navbar slot="navbar" activePage="website" />

  <!-- ====== STITCH HERO ====== -->
  <section class="web-stitch-hero" transition:animate="fade">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="web-stitch-hero-inner">
      <!-- Heading -->
      <h1 class="web-stitch-title">
        High-Performance<br />
        <span class="web-stitch-title-accent"><em>Digital Ecosystems</em></span>
      </h1>
      <!-- Description -->
      <p class="web-stitch-hero-sub">
        Jasa pembuatan website profesional portfolio, landing page, company profile, dan web app yang responsif, cepat, dan berorientasi pada pengalaman pengguna.
      </p>
    </div>
  </section>

  <!-- ====== PROJECTS Stitch Browser Frame Layout ====== -->
  <section class="web-projects" id="projects" transition:animate="fade">

    <!-- Filter Bar -->
    <div class="filter-bar fade-up" aria-label="Filter by category">
      <button class="filter-btn active" data-filter="all">Semua</button>
      <button class="filter-btn" data-filter="portfolio">Portfolio</button>
      <button class="filter-btn" data-filter="landing">Landing Page</button>
      <button class="filter-btn" data-filter="sistem">Sistem Sederhana</button>
      <button class="filter-btn" data-filter="company">Company Profile</button>
    </div>

    {websites.map((item, index) => {
      const isInverse = index % 2 !== 0;
      const imgSrc = item.thumbnail || item.thumbnailPath;
      const cat = item.category ? item.category.toLowerCase() : 'all';
      const badgeColor = 
        cat.includes('portfolio') ? 'purple' :
        cat.includes('landing') ? 'blue' :
        cat.includes('sistem') ? 'green' : 'amber';
      const badgeLabel = 
        cat.includes('portfolio') ? 'Portfolio Website' :
        cat.includes('landing') ? 'Landing Page' :
        cat.includes('sistem') ? 'Sistem Sederhana' : 'Company Profile';
      
      const domainDisplay = item.liveUrl ? item.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : 'preview.local';

      return (
        <div class={`web-project-row ${isInverse ? 'web-project-row-inverse' : 'web-project-row-normal'}`} data-category={cat}>
          {!isInverse && (
            <div class="web-project-browser-wrap">
              <div class="web-project-browser-frame">
                <div class="web-browser-chrome">
                  <div class="web-browser-dots">
                    <span class="web-browser-dot web-browser-dot-red"></span>
                    <span class="web-browser-dot web-browser-dot-yellow"></span>
                    <span class="web-browser-dot web-browser-dot-green"></span>
                  </div>
                  <div class="web-browser-url-bar">{domainDisplay}</div>
                </div>
                <a class="glightbox web-screenshot-link"
                   href={imgSrc}
                   data-gallery="web-gallery"
                   data-title={item.title}>
                  <img src={imgSrc} alt={item.title} loading="lazy" />
                </a>
              </div>
            </div>
          )}

          <div class="web-project-info">
            <span class={`web-project-badge web-project-badge-${badgeColor}`}>{badgeLabel}</span>
            <h2 class="web-project-title">{item.title}</h2>
            {item.description && (
              <p class="web-project-desc">{item.description}</p>
            )}
            <div class={`web-project-links ${isInverse ? 'web-project-links-right' : ''}`}>
              {item.liveUrl && item.liveUrl !== '#' && (
                <a href={item.liveUrl} target="_blank" rel="noopener noreferrer" class="web-project-link web-project-link-primary">
                  <i class="fas fa-external-link-alt"></i> Kunjungi Website
                </a>
              )}
              <a href={`https://wa.me/6287779560264?text=${encodeURIComponent('Halo Rangga, saya tertarik dengan project ' + item.title)}`} target="_blank" rel="noopener noreferrer" class="web-project-link web-project-link-ghost">
                <i class="fab fa-whatsapp"></i> Tanya Project
              </a>
            </div>
          </div>

          {isInverse && (
            <div class="web-project-browser-wrap">
              <div class="web-project-browser-frame">
                <div class="web-browser-chrome">
                  <div class="web-browser-dots">
                    <span class="web-browser-dot web-browser-dot-red"></span>
                    <span class="web-browser-dot web-browser-dot-yellow"></span>
                    <span class="web-browser-dot web-browser-dot-green"></span>
                  </div>
                  <div class="web-browser-url-bar">{domainDisplay}</div>
                </div>
                <a class="glightbox web-screenshot-link"
                   href={imgSrc}
                   data-gallery="web-gallery"
                   data-title={item.title}>
                  <img src={imgSrc} alt={item.title} loading="lazy" />
                </a>
              </div>
            </div>
          )}
        </div>
      );
    })}

  </section>

  <Footer slot="footer" variant="minimal" />
</BaseLayout>

<style>
  /* =============================================
     STITCH WEB PAGE Scoped styles
     ============================================= */

  .web-stitch-hero {
    position: relative;
    padding: 160px 48px 100px;
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }

  .web-stitch-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
  }

  .web-stitch-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .web-stitch-title-accent {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: normal;
  }

  .web-stitch-hero-sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 36px;
  }

  /* Filter Bar */
  .filter-bar {
    padding: 0 48px;
    margin-bottom: 48px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.08);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 22px;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: var(--surface-bright);
    color: var(--accent-primary);
    border-color: rgba(163, 166, 255, 0.15);
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: var(--accent-secondary-container);
    border-color: rgba(193, 128, 255, 0.3);
    color: #e9cdff;
  }

  /* Projects */
  .web-projects {
    padding: 0 48px 120px;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .web-project-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    transition: opacity 0.3s ease;
  }

  .web-project-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .web-project-badge {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 9999px;
    width: fit-content;
  }

  .web-project-badge-purple {
    background: rgba(163, 166, 255, 0.15);
    color: var(--accent-primary);
    border: 1px solid rgba(163, 166, 255, 0.25);
  }

  .web-project-badge-blue {
    background: rgba(100, 180, 255, 0.15);
    color: #64b4ff;
    border: 1px solid rgba(100, 180, 255, 0.25);
  }

  .web-project-badge-green {
    background: rgba(80, 220, 160, 0.15);
    color: #50dca0;
    border: 1px solid rgba(80, 220, 160, 0.25);
  }

  .web-project-badge-amber {
    background: rgba(255, 180, 80, 0.15);
    color: #ffb450;
    border: 1px solid rgba(255, 180, 80, 0.25);
  }

  .web-project-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .web-project-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .web-project-links {
    display: flex;
    gap: 16px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .web-project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .web-project-link-primary {
    background: var(--accent-primary);
    color: var(--surface-base);
  }

  .web-project-link-primary:hover {
    background: #ffffff;
    transform: translateY(-2px);
  }

  .web-project-link-ghost {
    background: var(--surface-container-highest);
    color: var(--text-primary);
    border: 1px solid rgba(163, 166, 255, 0.12);
  }

  .web-project-link-ghost:hover {
    background: var(--surface-bright);
    color: var(--accent-primary);
    transform: translateY(-2px);
  }

  /* Browser Frame */
  .web-project-browser-frame {
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s ease, border-color 0.4s ease;
  }

  .web-project-browser-frame:hover {
    transform: translateY(-6px);
    border-color: rgba(163, 166, 255, 0.25);
  }

  .web-browser-chrome {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(163, 166, 255, 0.08);
    gap: 16px;
  }

  .web-browser-dots {
    display: flex;
    gap: 6px;
  }

  .web-browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .web-browser-dot-red { background: #ff5f56; }
  .web-browser-dot-yellow { background: #ffbd2e; }
  .web-browser-dot-green { background: #27c93f; }

  .web-browser-url-bar {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    padding: 4px 12px;
    font-family: monospace;
    font-size: 11px;
    color: var(--text-tertiary);
    text-align: center;
  }

  .web-screenshot-link {
    display: block;
    overflow: hidden;
  }

  .web-screenshot-link img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .web-project-browser-frame:hover .web-screenshot-link img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .web-project-row {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .web-project-row-inverse .web-project-info {
      order: 2;
    }
    .web-project-row-inverse .web-project-browser-wrap {
      order: 1;
    }
  }

  @media (max-width: 600px) {
    .web-stitch-hero {
      padding: 120px 24px 60px;
    }
    .web-projects {
      padding: 0 24px 80px;
      gap: 60px;
    }
    .filter-bar {
      padding: 0 20px;
      gap: 8px;
    }
  }
</style>

<script is:inline>
  // ---------- GLIGHTBOX INITIALIZATION ----------
  function initWebLightbox() {
    if (typeof GLightbox !== 'undefined') {
      GLightbox({
        selector: '.glightbox',
        touchNavigation: true,
        loop: true,
      });
    } else {
      setTimeout(initWebLightbox, 100);
    }
  }

  // ---------- WEB PROJECTS FILTER ----------
  function initWebFilter() {
    const filterBar = document.querySelector('.filter-bar');
    if (!filterBar) return;

    const btns = filterBar.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('.web-project-row');

    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const selectedFilter = btn.getAttribute('data-filter') ? btn.getAttribute('data-filter').toLowerCase() : 'all';

        // Update active button
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter project rows
        rows.forEach(row => {
          const cat = row.getAttribute('data-category') ? row.getAttribute('data-category').toLowerCase() : '';
          if (selectedFilter === 'all' || cat.includes(selectedFilter) || selectedFilter.includes(cat)) {
            row.style.display = 'grid';
            row.style.opacity = '1';
          } else {
            row.style.display = 'none';
            row.style.opacity = '0';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initWebLightbox();
    initWebFilter();
  });

  document.addEventListener('astro:page-load', () => {
    initWebLightbox();
    initWebFilter();
  });
</script>
