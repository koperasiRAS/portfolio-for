---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";
import { getPhotos } from "../utils/content.js";

const photos = getPhotos();
const categories = [...new Set(photos.map(p => p.category).filter(Boolean))];
const totalPhotos = photos.length;

const heroFeature = photos.find(p => p.featuredHome) || photos[0];
const heroSrc = heroFeature?.imagePath || '/assets/foto/cover-hero.png';

function layoutClass(item) {
  if (item.layout === 'portrait') return 'aspect-[4/5]';
  if (item.layout === 'wide') return 'aspect-[16/9]';
  return 'aspect-square';
}

function colSpan(item, index) {
  if (item.layout === 'portrait') return 'md:col-span-5';
  if (item.layout === 'wide') return 'md:col-span-8';
  return 'md:col-span-4';
}
---

<BaseLayout
  title="Photo Archive | FRAME OF RANGGA"
  description="Curated photography archive of Rangga Danuarta. Analog 35mm, medium format film, and cinema sensor collections."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/foto"
  bodyClass="bg-background text-on-surface antialiased"
  hasGlightbox={true}
  hasSwiper={true}
>
  <Navbar slot="navbar" activePage="foto" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- Atmospheric Glow Scrim -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-primary/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
        <div class="absolute top-96 right-10 w-[420px] h-[420px] bg-tertiary-container/15 rounded-full blur-[160px] pointer-events-none -z-10"></div>

        <!-- ============================================================
             01. HERO SECTION
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-space-xl pb-space-lg flex flex-col gap-space-lg">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="flex flex-col gap-space-xs">
              <div class="flex items-center gap-space-xs text-primary font-label-sm text-label-sm uppercase tracking-widest">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
                <span>Archive 03 • Curated Works</span>
              </div>
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface" data-i18n="photo.title">Photo.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl" data-i18n="photo.heroSub">
                Curation of documentary and editorial frames across portraiture, landscape, and visual study.
              </p>
            </div>

            <!-- Technical Telemetry Pill -->
            <div class="flex items-center gap-space-md p-space-sm px-space-md rounded-full bg-surface-container-low/70 backdrop-blur-md self-start md:self-auto">
              <div class="flex items-center gap-space-xs">
                <span class="material-symbols-outlined text-[16px] text-primary">shutter_speed</span>
                <span class="font-label-sm text-label-sm text-on-surface">LEICA M6 • HASSELBLAD 503CX</span>
              </div>
              <span class="w-1 h-3 rounded-full bg-outline-variant/40"></span>
              <span class="font-label-sm text-label-sm text-secondary">24 EXP • KODAK PORTRA 400</span>
            </div>
          </div>

          <!-- 02. FEATURED HERO COMPOSITION -->
          {heroFeature ? (
          <div class="relative w-full rounded-lg overflow-hidden group bg-surface-container-lowest">
            <div class="aspect-[16/9] md:aspect-[21/9] w-full relative overflow-hidden">
              <img
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                src={heroSrc}
                alt={heroFeature.title}
                id="hero-feature-img"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-surface-container-lowest/80 via-transparent to-transparent"></div>

              <div class="absolute inset-x-0 bottom-0 p-space-md md:p-space-xl flex flex-col md:flex-row md:items-end justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs max-w-xl">
                  <div class="flex items-center gap-space-xs">
                    <span class="px-space-xs py-0.5 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase">{heroFeature.category || 'Featured'}</span>
                    <span class="font-label-sm text-label-sm text-secondary-fixed">{heroFeature.year ? String(heroFeature.year) : ''}</span>
                  </div>
                  <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">{heroFeature.title}</h2>
                  <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 md:line-clamp-none">
                    {heroFeature.description}
                  </p>
                </div>

                <div class="flex items-center gap-space-sm shrink-0">
                  <button
                    type="button"
                    class="lightbox-trigger flex items-center gap-space-xs px-space-md py-space-sm rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/30 text-on-surface font-headline-sm text-headline-sm hover:scale-[1.03] hover:bg-surface-container-high transition-all shadow-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] cursor-pointer"
                    data-title={heroFeature.title}
                    data-desc={heroFeature.description || ''}
                    data-cat={heroFeature.category || ''}
                    data-year={heroFeature.year ? String(heroFeature.year) : ''}
                    data-gear={heroFeature.client || ''}
                    data-img={heroSrc}
                  >
                    <span>View Study</span>
                    <span class="material-symbols-outlined text-[18px]">north_east</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          ) : (
          <div class="relative w-full rounded-lg overflow-hidden bg-surface-container-lowest flex items-center justify-center">
            <div class="aspect-[16/9] md:aspect-[21/9] w-full flex items-center justify-center">
              <p class="font-body-md text-on-surface-variant">Gallery empty. Publish photos from the CMS portal.</p>
            </div>
          </div>
          )}
        </section>


        <!-- ============================================================
             03. CATEGORY FILTERS (dynamic from CMS)
             ============================================================ -->
        {totalPhotos > 0 && (
        <section class="sticky top-20 z-40 w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-xs">
          <div class="w-full flex items-center justify-between gap-space-sm p-space-xs rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/20 shadow-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] overflow-x-auto no-scrollbar">
            <div class="flex items-center gap-space-xs shrink-0" id="filter-pill-container">
              <button class="photo-filter-btn active flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider bg-surface-container-highest text-on-surface border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all cursor-pointer" data-filter="all">
                <span class="w-1.5 h-1.5 rounded-full bg-on-surface"></span>
                <span>All Works ({totalPhotos})</span>
              </button>
              {categories.map(cat => (
                <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter={cat.toLowerCase()}>
                  <span>{cat}</span>
                </button>
              ))}
            </div>
            <div class="hidden md:flex items-center gap-space-sm pr-space-md text-outline font-label-sm text-label-sm">
              <span class="material-symbols-outlined text-[16px]">tune</span>
              <span id="gallery-count-badge">Showing {totalPhotos} Selected Frames</span>
            </div>
          </div>
        </section>
        )}


        <!-- ============================================================
             04. CURATED MASONRY / ASYMMETRIC GALLERY GRID
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-xl">
          {totalPhotos === 0 ? (
          <div class="w-full p-space-xl rounded-lg bg-surface-container-low/60 text-center">
            <p class="font-body-md text-on-surface-variant">No photos published yet. Manage your archive in the CMS portal.</p>
          </div>
          ) : (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter" id="photo-grid">
            {photos.map((item, index) => {
              const imgSrc = item.imagePath || '/assets/foto/placeholder.jpg';
              const cats = item.category ? item.category.toLowerCase() : '';
              return (
            <article
              class={`photo-gallery-item ${colSpan(item, index)} flex flex-col gap-space-xs group cursor-pointer`}
              data-category={cats}
              data-title={item.title}
              data-desc={item.description || ''}
              data-cat={item.category || ''}
              data-year={item.year ? String(item.year) : ''}
              data-gear={item.client || ''}
              data-img={imgSrc}
            >
              <div class={`relative w-full ${layoutClass(item)} rounded-DEFAULT overflow-hidden bg-surface-container-high`}>
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src={imgSrc}
                  alt={item.title}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">{item.category || ''}</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface">{item.title}</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">{item.description || ''}</p>
                </div>
                <div class="absolute top-space-sm right-space-sm w-9 h-9 rounded-full bg-surface-container-lowest/70 backdrop-blur-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all">
                  <span class="material-symbols-outlined text-[18px] text-on-surface">fullscreen</span>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">{item.title}</span>
                <span class="text-outline">{item.year ? String(item.year) : ''}{item.client ? ' • ' + item.client : ''}</span>
              </div>
            </article>
              );
            })}
          </div>
          )}
        </section>


        <!-- ============================================================
             05. ANALOG CURATION & PROCESS MONOGRAPH
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-xl">
          <div class="w-full p-space-lg md:p-space-2xl rounded-lg bg-surface-container-low/60 backdrop-blur-xl flex flex-col md:flex-row gap-space-xl items-center justify-between">
            <div class="flex flex-col gap-space-md max-w-xl">
              <div class="flex items-center gap-space-xs">
                <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary">Technical Methodology</span>
                <span class="text-outline-variant">•</span>
                <span class="font-label-sm text-label-sm text-secondary">The Negative Process</span>
              </div>
              <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                Preserving imperfect light through silver halide emulsions.
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Every collection is developed and hand-scanned to retain grain architecture, lens aberrations, and organic highlight roll-off. No automated AI denoising, no composite replacements — pure frame fidelity.
              </p>
              <div class="grid grid-cols-3 gap-space-md pt-space-sm">
                <div class="flex flex-col">
                  <span class="font-display-lg text-display-lg text-primary">400</span>
                  <span class="font-label-sm text-label-sm text-outline">Base ISO Index</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-display-lg text-display-lg text-on-surface">120</span>
                  <span class="font-label-sm text-label-sm text-outline">Medium Format (mm)</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-display-lg text-display-lg text-secondary">100%</span>
                  <span class="font-label-sm text-label-sm text-outline">Optical Capture</span>
                </div>
              </div>
            </div>

            <!-- Film Strip Graphic Visual -->
            <div class="w-full md:w-80 flex flex-col gap-space-xs p-space-md rounded-DEFAULT bg-surface-container-lowest">
              <div class="flex items-center justify-between font-label-sm text-label-sm text-outline">
                <span>FILM LOG • RANGGA-ARCHIVE</span>
                <span class="text-primary font-bold">BATCH 24/C</span>
              </div>
              <div class="flex gap-space-xs my-space-xs overflow-hidden">
                <div class="w-full h-24 rounded bg-surface-container flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined text-[32px] opacity-40">filter_drama</span>
                </div>
                <div class="w-full h-24 rounded bg-surface-container flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined text-[32px] opacity-40">waves</span>
                </div>
                <div class="w-full h-24 rounded bg-surface-container flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined text-[32px] opacity-40">park</span>
                </div>
              </div>
              <div class="flex justify-between items-center text-outline font-label-sm text-label-sm">
                <span>EXP 14A</span>
                <span>EASTMAN KODAK CO.</span>
                <span>15</span>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             06. BOTTOM CALL TO ACTION
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-space-lg pb-space-2xl">
          <div class="w-full p-space-xl md:p-space-3xl rounded-xl bg-gradient-to-b from-surface-container-high/80 to-surface-container-lowest text-center flex flex-col items-center gap-space-md relative overflow-hidden shadow-2xl">
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
            <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary" data-i18n="photo.ctaLabel">Limited Editions • Commercial Assignments</span>
            <h2 class="font-display-lg text-display-lg text-on-surface max-w-2xl tracking-tight" data-i18n="photo.ctaTitle">
              Curate a bespoke photo series with Rangga.
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl" data-i18n="photo.ctaSub">
              Available for commercial visual campaigns, editorial commissions, fine art print inquiries, and location expeditions worldwide.
            </p>
            <div class="flex flex-col sm:flex-row items-center gap-space-md pt-space-sm z-10">
              <a
                class="flex items-center gap-space-xs px-space-xl py-space-md rounded-full bg-surface-container-highest/80 backdrop-blur-xl border border-outline-variant/30 text-on-surface font-headline-sm text-headline-sm hover:scale-[1.03] hover:bg-surface-bright transition-all shadow-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]"
                href={waLink('foto_general')}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-i18n="photo.ctaButton">Inquire for Commissions</span>
                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
              </a>
              <a
                class="flex items-center gap-space-xs px-space-lg py-space-md rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/20 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all font-body-sm text-body-sm shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]"
                href="/about"
              >
                <span class="material-symbols-outlined text-[18px]">download</span>
                <span>About Rangga</span>
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>

    <!-- LIGHTBOX MODAL (Tier 3 Elevation) -->
    <div
      id="lightbox-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-space-md md:p-space-xl bg-surface-container-lowest/90 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-300"
      aria-hidden="true"
    >
      <div class="relative w-full max-w-5xl rounded-lg bg-surface-container-lowest p-space-md md:p-space-lg shadow-[0_24px_64px_-12px_rgba(0,0,0,0.8)] flex flex-col gap-space-md max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-space-xs">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary" id="modal-category"></span>
          </div>
          <button
            type="button"
            id="close-lightbox-btn"
            class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface hover:bg-surface-container-highest transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>

        <div class="w-full aspect-[16/10] max-h-[60vh] rounded-DEFAULT overflow-hidden bg-surface-container-high">
          <img class="w-full h-full object-cover" id="modal-img" src="" alt="Full view" />
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pt-space-xs">
          <div class="flex flex-col gap-space-xs max-w-2xl">
            <h3 class="font-headline-lg text-headline-lg text-on-surface" id="modal-title"></h3>
            <p class="font-body-md text-body-md text-on-surface-variant" id="modal-desc"></p>
          </div>
          <div class="flex flex-col items-start md:items-end gap-space-xs shrink-0 font-label-sm text-label-sm text-outline">
            <span id="modal-gear"></span>
            <span id="modal-year"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Lightbox & Filter Script -->
    <script is:inline>
      function initPhotoGallery() {
        const filterButtons = document.querySelectorAll('.photo-filter-btn');
        const galleryItems = document.querySelectorAll('.photo-gallery-item');
        const badge = document.getElementById('gallery-count-badge');
        const modal = document.getElementById('lightbox-modal');
        const closeBtn = document.getElementById('close-lightbox-btn');
        const modalTitle = document.getElementById('modal-title');
        const modalDesc = document.getElementById('modal-desc');
        const modalCat = document.getElementById('modal-category');
        const modalYear = document.getElementById('modal-year');
        const modalGear = document.getElementById('modal-gear');
        const modalImg = document.getElementById('modal-img');

        // Filter Logic
        filterButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            filterButtons.forEach(b => {
              b.classList.remove('active', 'bg-surface-container-highest', 'text-on-surface', 'border', 'border-outline-variant/30');
              b.classList.add('text-on-surface-variant');
              const dot = b.querySelector('.bg-primary, .bg-on-surface');
              if (dot) dot.remove();
            });

            btn.classList.add('active', 'bg-surface-container-highest', 'text-on-surface', 'border', 'border-outline-variant/30');
            btn.classList.remove('text-on-surface-variant');

            const dot = document.createElement('span');
            dot.className = 'w-1.5 h-1.5 rounded-full bg-primary';
            btn.prepend(dot);

            const category = btn.getAttribute('data-filter');
            let count = 0;

            galleryItems.forEach(item => {
              const itemCats = item.getAttribute('data-category') || '';
              if (category === 'all' || itemCats.includes(category)) {
                item.style.display = 'flex';
                count++;
              } else {
                item.style.display = 'none';
              }
            });

            if (badge) {
              badge.textContent = `Showing ${count} Selected Frames`;
            }
          });
        });

        // Lightbox open function
        function openBox(title, desc, cat, year, gear, img) {
          if (!modal) return;
          modalTitle.textContent = title || '';
          modalDesc.textContent = desc || '';
          modalCat.textContent = cat || '';
          modalYear.textContent = 'RELEASE ' + (year || '');
          modalGear.textContent = gear || '';
          modalImg.src = img || '';

          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = 'hidden';
        }

        function closeBox() {
          if (!modal) return;
          modal.classList.add('opacity-0', 'pointer-events-none');
          modal.classList.remove('opacity-100', 'pointer-events-auto');
          document.body.style.overflow = '';
        }

        // Attach triggers
        galleryItems.forEach(item => {
          item.addEventListener('click', () => {
            const title = item.getAttribute('data-title');
            const desc = item.getAttribute('data-desc');
            const cat = item.getAttribute('data-cat');
            const year = item.getAttribute('data-year');
            const gear = item.getAttribute('data-gear');
            const img = item.getAttribute('data-img');
            openBox(title, desc, cat, year, gear, img);
          });
        });

        const heroTrigger = document.querySelector('.lightbox-trigger');
        if (heroTrigger) {
          heroTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const title = heroTrigger.getAttribute('data-title');
            const desc = heroTrigger.getAttribute('data-desc');
            const cat = heroTrigger.getAttribute('data-cat');
            const year = heroTrigger.getAttribute('data-year');
            const gear = heroTrigger.getAttribute('data-gear');
            const img = heroTrigger.getAttribute('data-img');
            openBox(title, desc, cat, year, gear, img);
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', closeBox);
        }

        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target.id === 'lightbox-modal') closeBox();
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeBox();
        });
      }

      document.addEventListener('astro:page-load', initPhotoGallery);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPhotoGallery);
      } else {
        initPhotoGallery();
      }
    </script>
  </main>

  <!-- Monolithic Footer -->
  <footer slot="footer" class="w-full bg-surface-container-lowest border-t border-outline-variant/20 pt-space-3xl pb-space-2xl mt-space-3xl">
    <div class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto flex flex-col gap-space-2xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-space-xl">
        <div class="md:col-span-5 flex flex-col gap-space-md">
          <span class="font-headline-md text-headline-md uppercase tracking-tight text-on-surface">FRAME OF RANGGA</span>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-md">
            Multi-disciplinary visual storyteller &amp; director operating across photography, cinematic direction, graphic systems, and spatial web experiences.
          </p>
          <div class="flex flex-wrap gap-space-xs pt-space-xs">
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Photography</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Film Direction</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Visual Identity</span>
            <span class="font-label-sm text-label-sm text-secondary bg-surface-container-low px-space-sm py-space-xs rounded-full">Web Experiences</span>
          </div>
