---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getPhotos } from "../utils/content.js";

const photos = getPhotos();
---

<BaseLayout
  title="Photography Portfolio | Frame Of Rangga"
  description="Portofolio fotografi Rangga Danuarta wedding, birthday party, event, komersial, wisuda, lifestyle, dan brand photography dengan pendekatan visual storytelling."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-foto.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/foto"
  hasGlightbox={true}
>
  <Navbar slot="navbar" activePage="foto" />

  <!-- PAGE HERO Stitch Reference -->
  <section class="page-hero stitch-hero" transition:animate="fade">
    <div class="page-hero-bg-glow" aria-hidden="true"></div>
    <div class="page-hero-inner stitch-hero-inner">
      <!-- Label badge -->
      <div class="stitch-badge">
        <i class="fas fa-camera"></i>
        <span>Portfolio</span>
      </div>
      <!-- Heading -->
      <h1 class="stitch-hero-title">Photography</h1>
      <!-- Subtitle -->
      <p class="stitch-hero-sub">
        Momen-momen yang diabadikan dengan sentuhan visual yang kuat dan
        storytelling yang autentik. Dari perayaan ulang tahun hingga konten
        brand, setiap frame bercerita.
      </p>
    </div>
  </section>

  <!-- FILTER + GALLERY Stitch Bento Grid -->
  <section class="gallery-section" transition:animate="fade">
    <!-- Filter Bar Stitch pill style -->
    <div class="filter-bar fade-up" aria-label="Filter by category">
      <button class="filter-btn active" data-filter="all">Semua</button>
      <button class="filter-btn" data-filter="wedding">Wedding</button>
      <button class="filter-btn" data-filter="birthday">Birthday Party</button>
      <button class="filter-btn" data-filter="komersial">Komersial</button>
      <button class="filter-btn" data-filter="graduation">Graduation</button>
      <button class="filter-btn" data-filter="lifestyle">Lifestyle</button>
      <button class="filter-btn" data-filter="yearbook">Yearbook</button>
      <button class="filter-btn" data-filter="fotografi">Fotografi</button>
    </div>

    <!-- Bento Grid Gallery Masonry layout -->
    <div class="stitch-bento-grid fade-up">
      {photos.map((item) => {
        const isFeatured = item.layout === 'featured';
        const imgWrapClass = 
          item.layout === 'square' ? 'stitch-card-img-square' :
          item.layout === 'portrait' ? 'stitch-card-img-portrait' :
          item.layout === 'landscape' ? 'stitch-card-img-landscape' : 'stitch-card-img-natural';
        const imgSrc = item.image || item.imagePath;

        return (
          <a
            class={`stitch-card ${isFeatured ? 'stitch-card-featured' : ''} glightbox`}
            href={imgSrc}
            data-gallery="portfolio-gallery"
            data-title={item.title}
            data-description={item.description || ''}
            data-category={item.category ? item.category.toLowerCase() : 'all'}
          >
            <div class={`stitch-card-img-wrap ${imgWrapClass}`}>
              <img
                src={imgSrc}
                alt={item.title}
                loading="lazy"
              />
            </div>
            <div class="stitch-card-overlay">
              <span class="stitch-card-cat">{item.category}</span>
              <h3 class="stitch-card-title">{item.title}</h3>
              {item.description && (
                <p class="stitch-card-desc">{item.description}</p>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <Footer slot="footer" variant="minimal" />
</BaseLayout>

<style>
  /* =============================================
     STITCH FOTO PAGE Scoped styles
     ============================================= */

  /* Hero Stitch style */
  .stitch-hero {
    padding: 140px 48px 80px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .stitch-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.15);
    color: var(--accent-primary);
    font-family: "Manrope", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .stitch-badge i {
    font-size: 12px;
  }

  .stitch-hero-title {
    font-family: "Manrope", sans-serif;
    font-size: clamp(52px, 7vw, 96px);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .stitch-hero-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 580px;
  }

  /* Filter Bar pill buttons, centered */
  .filter-bar {
    padding: 0 48px;
    margin-bottom: 48px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--surface-container-highest);
    border: 1px solid rgba(163, 166, 255, 0.08);
    color: var(--text-secondary);
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 22px;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: var(--surface-bright);
    color: var(--accent-primary);
    border-color: rgba(163, 166, 255, 0.15);
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: var(--accent-secondary-container);
    border-color: rgba(193, 128, 255, 0.3);
    color: #e9cdff;
  }

  /* Bento Grid Masonry layout to prevent empty gaps & cropping */
  .stitch-bento-grid {
    column-count: 3;
    column-gap: 24px;
    padding: 0 48px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Stitch Card */
  .stitch-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-container);
    border: 1px solid rgba(163, 166, 255, 0.06);
    cursor: pointer;
    display: block;
    width: 100%;
    margin-bottom: 24px;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease,
                opacity 0.3s ease;
  }

  .stitch-card:hover {
    transform: translateY(-6px);
    border-color: rgba(163, 166, 255, 0.25);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
  }

  /* Image containers - Uncropped & Natural */
  .stitch-card-img-wrap {
    width: 100%;
    overflow: hidden;
    display: block;
    position: relative;
  }

  .stitch-card-img-natural img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-card-img-square {
    aspect-ratio: 1 / 1;
  }
  .stitch-card-img-square img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-card-img-portrait {
    aspect-ratio: 4 / 5;
  }
  .stitch-card-img-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-card-img-landscape {
    aspect-ratio: 16 / 10;
  }
  .stitch-card-img-landscape img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .stitch-card:hover .stitch-card-img-wrap img {
    transform: scale(1.05);
  }

  /* Overlay Stitch style, bottom gradient + text */
  .stitch-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(6, 14, 32, 0.95) 0%,
      rgba(6, 14, 32, 0.4) 40%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  .stitch-card:hover .stitch-card-overlay {
    opacity: 1;
  }

  .stitch-card-cat {
    font-family: "Inter", sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(163, 166, 255, 0.2);
    color: var(--accent-primary);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-block;
    width: fit-content;
    margin-bottom: 10px;
  }

  .stitch-card-title {
    font-family: "Manrope", sans-serif;
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 6px;
  }

  .stitch-card-desc {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .stitch-bento-grid {
      column-count: 2;
      column-gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .stitch-hero {
      padding: 120px 24px 40px;
    }
    .filter-bar {
      padding: 0 20px;
      gap: 8px;
    }
    .stitch-bento-grid {
      column-count: 1;
      padding: 0 20px;
    }
  }
</style>

<script is:inline>
  // ---------- GLIGHTBOX INITIALIZATION ----------
  function initGalleryLightbox() {
    if (typeof GLightbox !== 'undefined') {
      GLightbox({
        selector: '.glightbox',
        touchNavigation: true,
        loop: true,
        autoplayVideos: true,
      });
    } else {
      setTimeout(initGalleryLightbox, 100);
    }
  }

  // ---------- CATEGORY FILTERING ----------
  function initPhotoFilter() {
    const filterBar = document.querySelector('.filter-bar');
    if (!filterBar) return;

    const filterBtns = filterBar.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.stitch-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const selectedCat = btn.getAttribute('data-filter') ? btn.getAttribute('data-filter').toLowerCase() : 'all';

        // Update active class on buttons
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter cards with smooth display
        cards.forEach(card => {
          const itemCat = card.getAttribute('data-category') ? card.getAttribute('data-category').toLowerCase() : '';
          if (selectedCat === 'all' || itemCat.includes(selectedCat) || selectedCat.includes(itemCat)) {
            card.style.display = 'block';
            card.style.opacity = '1';
          } else {
            card.style.display = 'none';
            card.style.opacity = '0';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initGalleryLightbox();
    initPhotoFilter();
  });

  document.addEventListener('astro:page-load', () => {
    initGalleryLightbox();
    initPhotoFilter();
  });
</script>
