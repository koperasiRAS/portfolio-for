---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { waLink } from "../utils/whatsapp.js";

// Local images from the Vercel asset store (for-portfolio-mu.vercel.app/assets/foto/).
// These are plain public-path strings so they type-check in both <img src> and data-*
// attributes — the existing pages already reference the same /assets/foto/ paths.
const heroFeature = 'https://for-portfolio-mu.vercel.app/assets/foto/cover-hero.png';
const fotoAutomotive = 'https://for-portfolio-mu.vercel.app/assets/foto/fotografer/fotografi mobil.jpg';
const fotoPortrait = 'https://for-portfolio-mu.vercel.app/assets/foto/fashion/foto baju coklat.jpg';
---

<BaseLayout
  title="Photo Archive | FRAME OF RANGGA"
  description="Curated photography archive of Rangga Danuarta. Analog 35mm, medium format film, and cinema sensor collections."
  ogImage="https://for-portfolio-mu.vercel.app/assets/og/og-default.jpg"
  ogUrl="https://for-portfolio-mu.vercel.app/foto"
  bodyClass="bg-background text-on-surface antialiased"
  hasGlightbox={true}
  hasSwiper={true}
>
  <Navbar slot="navbar" activePage="foto" />

  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- Atmospheric Glow Scrim -->
      <div class="relative w-full overflow-hidden">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-primary/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
        <div class="absolute top-96 right-10 w-[420px] h-[420px] bg-tertiary-container/15 rounded-full blur-[160px] pointer-events-none -z-10"></div>

        <!-- ============================================================
             01. HERO SECTION
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto pt-space-xl pb-space-lg flex flex-col gap-space-lg">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="flex flex-col gap-space-xs">
              <div class="flex items-center gap-space-xs text-primary font-label-sm text-label-sm uppercase tracking-widest">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
                <span>Archive 03 • Curated Works</span>
              </div>
              <h1 class="font-display-xl text-display-xl tracking-tight text-on-surface">Photo.</h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
                Moments, people, and places seen from different perspectives — documented through 35mm film, medium format analog, and cinema sensors.
              </p>
            </div>

            <!-- Technical Telemetry Pill -->
            <div class="flex items-center gap-space-md p-space-sm px-space-md rounded-full bg-surface-container-low/70 backdrop-blur-md self-start md:self-auto">
              <div class="flex items-center gap-space-xs">
                <span class="material-symbols-outlined text-[16px] text-primary">shutter_speed</span>
                <span class="font-label-sm text-label-sm text-on-surface">LEICA M6 • HASSELBLAD 503CX</span>
              </div>
              <span class="w-1 h-3 rounded-full bg-outline-variant/40"></span>
              <span class="font-label-sm text-label-sm text-secondary">24 EXP • KODAK PORTRA 400</span>
            </div>
          </div>

          <!-- 02. FEATURED HERO COMPOSITION: The Ocean Series -->
          <div class="relative w-full rounded-lg overflow-hidden group bg-surface-container-lowest">
            <div class="aspect-[16/9] md:aspect-[21/9] w-full relative overflow-hidden">
              <img
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                src={heroFeature}
                alt="Cinematic coastal photography on Bali cliffs at sunset"
                id="hero-feature-img"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent"></div>
              <div class="absolute inset-0 bg-gradient-to-r from-surface-container-lowest/80 via-transparent to-transparent"></div>

              <!-- Feature Overlay Content -->
              <div class="absolute inset-x-0 bottom-0 p-space-md md:p-space-xl flex flex-col md:flex-row md:items-end justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs max-w-xl">
                  <div class="flex items-center gap-space-xs">
                    <span class="px-space-xs py-0.5 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase">Selected Monograph</span>
                    <span class="font-label-sm text-label-sm text-secondary-fixed">01 — 06 • 2026 Edition</span>
                  </div>
                  <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">The Ocean Series</h2>
                  <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 md:line-clamp-none">
                    Coastal solitude along the southern Indonesian shoreline. An introspective investigation into the weight of tides, twilight haze, and human presence on the rim of the Indian Ocean.
                  </p>
                </div>

                <!-- Interactive Action Pill & Spec -->
                <div class="flex items-center gap-space-sm shrink-0">
                  <div class="hidden sm:flex flex-col text-right font-label-sm text-label-sm text-outline">
                    <span>LOC: ULUWATU &amp; SUMBA</span>
                    <span class="text-on-surface">50MM • F/1.4 • 1/250S</span>
                  </div>
                  <button
                    type="button"
                    class="lightbox-trigger flex items-center gap-space-xs px-space-md py-space-sm rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/30 text-on-surface font-headline-sm text-headline-sm hover:scale-[1.03] hover:bg-surface-container-high transition-all shadow-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] cursor-pointer"
                    data-title="The Ocean Series"
                    data-desc="Coastal serenity and human introspection on volcanic sea cliffs. Shot on Kodak Portra 400 across Uluwatu and Sumba."
                    data-cat="Landscape / Monograph"
                    data-year="2026"
                    data-gear="Summilux 50mm f/1.4"
                    data-img={heroFeature}
                  >
                    <span>View Study</span>
                    <span class="material-symbols-outlined text-[18px]">north_east</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- ============================================================
             03. CATEGORY FILTERS (Floating Capsule Style)
             ============================================================ -->
        <section class="sticky top-20 z-40 w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-xs">
          <div class="w-full flex items-center justify-between gap-space-sm p-space-xs rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/20 shadow-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] overflow-x-auto no-scrollbar">
            <div class="flex items-center gap-space-xs shrink-0" id="filter-pill-container">
              <button class="photo-filter-btn active flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider bg-surface-container-highest text-on-surface border border-outline-variant/30 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition-all cursor-pointer" data-filter="all">
                <span class="w-1.5 h-1.5 rounded-full bg-on-surface"></span>
                <span>All Works (7)</span>
              </button>
              <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter="landscape">
                <span>Landscape</span>
              </button>
              <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter="portrait">
                <span>Portrait</span>
              </button>
              <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter="street">
                <span>Street</span>
              </button>
              <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter="travel">
                <span>Travel</span>
              </button>
              <button class="photo-filter-btn flex items-center gap-space-xs px-space-md py-space-xs rounded-full font-label-md text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high/60 transition-all cursor-pointer" data-filter="nature">
                <span>Nature</span>
              </button>
            </div>
            <div class="hidden md:flex items-center gap-space-sm pr-space-md text-outline font-label-sm text-label-sm">
              <span class="material-symbols-outlined text-[16px]">tune</span>
              <span id="gallery-count-badge">Showing 7 Selected Frames</span>
            </div>
          </div>
        </section>


        <!-- ============================================================
             04. CURATED MASONRY / ASYMMETRIC GALLERY GRID
             ============================================================ -->
        <section class="w-full px-margin-mobile md:px-margin max-w-7xl mx-auto py-space-xl">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter" id="photo-grid">

            <!-- Item 1: Silent Peaks (Landscape 16:10 - 7 Cols) -->
            <article
              class="photo-gallery-item md:col-span-7 flex flex-col gap-space-xs group cursor-pointer"
              data-category="landscape nature"
              data-title="Silent Peaks"
              data-desc="Volcanic mist rising above the Bromo-Tengger caldera during civil dawn. An exploration of negative air space and atmospheric layering."
              data-cat="Landscape • East Java"
              data-year="2025"
              data-gear="Carl Zeiss 85mm f/1.4"
              data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuCBhHva70-wS5Y6JleRc_EgsXgKQlMW8DbfAJqPCW15aESkt_U_-OJ4Dj1s9cSmdteZ7KciPWxJ3yG2ZYFCkF-0TvBMEAGZ_DX-yHkrz8in7eD_g1uSo03E9cifZsEzDYz4JarzAvIlhSe9sKPwflWaexnkEHQo_4wKch8x5XVCA2tRzVMnTqgWXfkiT4QwPhVjRAeRJFrSj3e6VwvyYT8yEMcHuo8cQC0NlGLJvejih_iDyYH9SCUJ"
            >
              <div class="relative w-full aspect-[16/10] rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBhHva70-wS5Y6JleRc_EgsXgKQlMW8DbfAJqPCW15aESkt_U_-OJ4Dj1s9cSmdteZ7KciPWxJ3yG2ZYFCkF-0TvBMEAGZ_DX-yHkrz8in7eD_g1uSo03E9cifZsEzDYz4JarzAvIlhSe9sKPwflWaexnkEHQo_4wKch8x5XVCA2tRzVMnTqgWXfkiT4QwPhVjRAeRJFrSj3e6VwvyYT8yEMcHuo8cQC0NlGLJvejih_iDyYH9SCUJ"
                  alt="Ethereal landscape of volcanic mist at dawn"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">Landscape • East Java</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface">Silent Peaks</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Caldera mist at 05:14 AM • Medium Format</p>
                </div>
                <div class="absolute top-space-sm right-space-sm w-9 h-9 rounded-full bg-surface-container-lowest/70 backdrop-blur-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all">
                  <span class="material-symbols-outlined text-[18px] text-on-surface">fullscreen</span>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">Silent Peaks — East Java</span>
                <span class="text-outline">2025 • 85mm</span>
              </div>
            </article>

            <!-- Item 2: Urban Solitude (Portrait 4:5 - 5 Cols) -->
            <article
              class="photo-gallery-item md:col-span-5 flex flex-col gap-space-xs group cursor-pointer"
              data-category="portrait street"
              data-title="Urban Solitude"
              data-desc="A quiet, contemplative portrait captured under the neon-lit overpasses of downtown Jakarta. High-contrast monochromatic grading emphasizing emotional texture."
              data-cat="Portrait • Monograph"
              data-year="2025"
              data-gear="Leica 35mm f/1.4"
              data-img={fotoPortrait}
            >
              <div class="relative w-full aspect-[4/5] rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src={fotoPortrait}
                  alt="High contrast black and white portrait"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">Portrait • Monograph</span>
                  <h3 class="font-headline-md text-headline-md text-on-surface">Urban Solitude</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Metro underpass study • Tri-X 400</p>
                </div>
                <div class="absolute top-space-sm right-space-sm w-9 h-9 rounded-full bg-surface-container-lowest/70 backdrop-blur-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all">
                  <span class="material-symbols-outlined text-[18px] text-on-surface">fullscreen</span>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">Urban Solitude — Jakarta</span>
                <span class="text-outline">2025 • 35mm Tri-X</span>
              </div>
            </article>

            <!-- Item 3: Banyuwangi Twilight (Square 1:1 - 4 Cols) -->
            <article
              class="photo-gallery-item md:col-span-4 flex flex-col gap-space-xs group cursor-pointer"
              data-category="travel nature"
              data-title="Banyuwangi Twilight"
              data-desc="Sulfur smoke and ambient moonlight mixing on the rim of Mount Ijen at the edge of blue hour."
              data-cat="Nature • Geothermal"
              data-year="2024"
              data-gear="Voigtländer 28mm f/2"
              data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuB88C5PhBePgzmLrUFRpt6IQEZdzFbarcdoJkIp4V44nC8LndViq-YUqDei1TOPs00f9KfO-YowC58CP73UiOBBBclwLcyBboQ5oLaoYIa52h9Cs3ZXSjGeJcdAF6IXRx5TCsmuBsvfJ92u29z2S1MaQQ_EvjJvhRwXSRnApv0zR-aBR3SFHk-C95Qxs3Ndazds_FylsonraSvyDaDCbVWsUG6ZHuYSWAtkwqYrNx1owYYl2y3PIfbv"
            >
              <div class="relative w-full aspect-square rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB88C5PhBePgzmLrUFRpt6IQEZdzFbarcdoJkIp4V44nC8LndViq-YUqDei1TOPs00f9KfO-YowC58CP73UiOBBBclwLcyBboQ5oLaoYIa52h9Cs3ZXSjGeJcdAF6IXRx5TCsmuBsvfJ92u29z2S1MaQQ_EvjJvhRwXSRnApv0zR-aBR3SFHk-C95Qxs3Ndazds_FylsonraSvyDaDCbVWsUG6ZHuYSWAtkwqYrNx1owYYl2y3PIfbv"
                  alt="Geothermal crater lake with sulfur smoke"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">Nature • Geothermal</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface">Banyuwangi Twilight</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Mount Ijen crater ridge • 28mm</p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">Banyuwangi Twilight</span>
                <span class="text-outline">2024 • 28mm</span>
              </div>
            </article>

            <!-- Item 4: Forest Solitude (Square 1:1 - 4 Cols) -->
            <article
              class="photo-gallery-item md:col-span-4 flex flex-col gap-space-xs group cursor-pointer"
              data-category="nature landscape"
              data-title="Forest Solitude"
              data-desc="Dappled emerald rain drops sliding across elephant ear flora in the highland cloud forests of West Java."
              data-cat="Nature • Macro"
              data-year="2025"
              data-gear="Micro-Nikkor 55mm f/2.8"
              data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuBVPQ0SxnZHz4KMlzOr5iLBcOnZdcYv5Iz8nIUchHUhkvmFi4Gb94sfeeODaTdJnVlUmp1aBL18XufKluo8s-SXjhNC9frpwMN4VaKNap6rEapB4D8EFfaCJoD2rw9qiVc9KNs--Pu_Ms3n1K7aSESCh-uMBXMDw9SVxml7MXTtSviNNq_DO8XOkStQXPC7_WglZ3jMLW09gSHASZuHyftrg5oKgIjPdJoEabFFeBCbIETep3Zk_UKF"
            >
              <div class="relative w-full aspect-square rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBVPQ0SxnZHz4KMlzOr5iLBcOnZdcYv5Iz8nIUchHUhkvmFi4Gb94sfeeODaTdJnVlUmp1aBL18XufKluo8s-SXjhNC9frpwMN4VaKNap6rEapB4D8EFfaCJoD2rw9qiVc9KNs--Pu_Ms3n1K7aSESCh-uMBXMDw9SVxml7MXTtSviNNq_DO8XOkStQXPC7_WglZ3jMLW09gSHASZuHyftrg5oKgIjPdJoEabFFeBCbIETep3Zk_UKF"
                  alt="Emerald macro rain forest foliage"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">Nature • Macro</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface">Forest Solitude</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Mount Gede highlands • 55mm Macro</p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">Forest Solitude</span>
                <span class="text-outline">2025 • 55mm</span>
              </div>
            </article>

            <!-- Item 5: Morning Mist (Square 1:1 - 4 Cols) -->
            <article
              class="photo-gallery-item md:col-span-4 flex flex-col gap-space-xs group cursor-pointer"
              data-category="landscape travel"
              data-title="Morning Mist"
              data-desc="Layers of pine forest canopy draped in cold mountain haze along the ridge of Dieng Plateau."
              data-cat="Landscape • Dieng"
              data-year="2024"
              data-gear="Sonnar 90mm f/2.8"
              data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuCTPCBdYw_A4AePoNN9FxqpkY_WgW7PdTQ3sESRTgwcJPVQ2IJCTXKpyxqeAsefHGPBQNCea5LV5Ie8TwYGaD9d2KUpfRwVY-RbKkruJ0pBanK5e-eJL5t6PGauB5jzo7t2Nh7sdn2t8CKM3Hs8uG0IATclswJrSxLjD5JamcKnhIlqMaDEdAsczPZ-ZGyFuREia0FyhthLTWU4-Ld2e9hz4MIxaKWYVYdgJnAHchb2-MMQmbyf51cH"
            >
              <div class="relative w-full aspect-square rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTPCBdYw_A4AePoNN9FxqpkY_WgW7PdTQ3sESRTgwcJPVQ2IJCTXKpyxqeAsefHGPBQNCea5LV5Ie8TwYGaD9d2KUpfRwVY-RbKkruJ0pBanK5e-eJL5t6PGauB5jzo7t2Nh7sdn2t8CKM3Hs8uG0IATclswJrSxLjD5JamcKnhIlqMaDEdAsczPZ-ZGyFuREia0FyhthLTWU4-Ld2e9hz4MIxaKWYVYdgJnAHchb2-MMQmbyf51cH"
                  alt="Pine forest canopy in morning fog"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-surface-container-lowest/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-space-md flex flex-col justify-end">
                  <span class="font-label-sm text-label-sm text-primary uppercase">Landscape • Dieng</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface">Morning Mist</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">Plateau elevation 2,100m • 90mm</p>
                </div>
              </div>
              <div class="flex items-center justify-between pt-space-xs font-label-sm text-label-sm">
                <span class="text-on-surface font-medium">Morning Mist — Dieng</span>
                <span class="text-outline">2024 • 90mm</span>
              </div>
            </article>

            <!-- Item 6: The Glass Conservatory (Architectural 16:9 - 8 Cols) -->
            <article
              class="photo-gallery-item md:col-span-8 flex flex-col gap-space-xs group cursor-pointer"
              data-category="street travel"
              data-title="The Glass Conservatory"
              data-desc="Minimalist modernist botanical architecture interacting with midday tropical sun shafts."
              data-cat="Architecture • Jakarta"
              data-year="2025"
              data-gear="Leica Super-Elmar 21mm f/3.4"
              data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuDzByIIireKhLAqOBi_J4lrwG9MQfdfSmzI4voo14QDmF7ylKgOMIO99kloCkgFNF7LNZi8GQbPPb4kmjDePPRnRK3WVXncHdg3VKWIkNmjoPP75TyWvXrQ6NLVLhCkTUN5qtBvb1pq-EnMyYzSvR4Etm_yNPBnniSmDfN8C0xI3e7si24TP5Kvij-lw82J1qi5pJ9HTYZN5IkzYsTcmVevWqbGbP9jWeBWTDwdxhyY_uD0QXN3mB0I"
            >
              <div class="relative w-full aspect-[16/9] rounded-DEFAULT overflow-hidden bg-surface-container-high">
                <img
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
