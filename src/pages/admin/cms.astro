---
// Studio Curation Engine & Archival Index (/admin/cms)
// Exact match to PRD 5.2 B and Frame of Rangga - CMS Content Manager.png
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CMS Content Manager & Archival Index | Frame Of Rangga</title>
  <meta name="robots" content="noindex, nofollow" />

  <!-- Modernist Typography & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            obsidian: "#0e0e10",
            charcoal: "#131315",
            card: "#19191d",
            "card-hover": "#212126",
            "border-subtle": "rgba(255, 255, 255, 0.07)",
            "border-highlight": "rgba(255, 255, 255, 0.12)",
            "accent-blue": "#2563eb",
            "accent-cyan": "#38bdf8",
          },
          fontFamily: {
            display: ["Hanken Grotesk", "sans-serif"],
            body: ["Inter", "sans-serif"],
            mono: ["JetBrains Mono", "monospace"],
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #0e0e10;
      color: #f3f4f6;
      font-family: 'Inter', sans-serif;
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0e0e10;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f46;
    }
    .custom-switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }
    .custom-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #27272a;
      transition: .3s;
      border-radius: 24px;
    }
    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }
    input:checked + .slider {
      background-color: #2563eb;
    }
    input:checked + .slider:before {
      transform: translateX(20px);
    }
  </style>
</head>

<body class="w-full min-h-screen bg-[#0e0e10] text-[#f3f4f6] flex flex-col antialiased selection:bg-blue-600 selection:text-white">

  <!-- Application Shell (Flex container) -->
  <div class="flex-grow flex w-full h-screen overflow-hidden">

    <!-- ==============================================================
         1. LEFT SIDEBAR (Studio Curation Engine Nav)
         ============================================================== -->
    <aside class="w-64 bg-[#111114] border-r border-white/5 flex flex-col justify-between shrink-0 h-full select-none z-20">
      
      <!-- Top Branding & Navigation -->
      <div class="p-5 flex flex-col gap-6 overflow-y-auto">
        
        <!-- Studio Engine Header -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            <span class="font-display font-bold tracking-tight text-white text-sm uppercase">FRAME OF RANGGA</span>
          </div>
          <span class="font-mono text-[9.5px] text-gray-500 tracking-wider uppercase">STUDIO CURATION ENGINE — V4.2</span>
        </div>

        <!-- + New Entry Action -->
        <button
          type="button"
          onclick="openCreateDrawer()"
          class="w-full py-2.5 px-4 rounded-full bg-[#f3f4f6] hover:bg-white text-[#0e0e10] font-display font-semibold text-xs transition-all flex items-center justify-center gap-1.5 shadow-md active:scale-95 cursor-pointer"
        >
          <span class="material-symbols-outlined text-[16px]">add</span>
          <span>+ New Entry</span>
        </button>

        <!-- Catalog Categories -->
        <div class="flex flex-col gap-5 pt-1">
          
          <!-- Works Catalog Group -->
          <div class="flex flex-col gap-1.5">
            <span class="font-mono text-[9px] uppercase tracking-widest text-gray-500 px-3">WORKS CATALOG</span>
            
            <button
              type="button"
              onclick="setCatalogFilter('all')"
              id="nav-overview"
              class="sidebar-nav-item active flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-white bg-white/10 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px] text-gray-400">grid_view</span>
              <span>Overview</span>
            </button>

            <button
              type="button"
              onclick="setCatalogFilter('photo')"
              id="nav-photo"
              class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">photo_camera</span>
              <span>Photography</span>
            </button>

            <button
              type="button"
              onclick="setCatalogFilter('video')"
              id="nav-video"
              class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">videocam</span>
              <span>Motion &amp; Video</span>
            </button>

            <button
              type="button"
              onclick="setCatalogFilter('design')"
              id="nav-design"
              class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
              <span>Art Direction &amp; Design</span>
            </button>

            <button
              type="button"
              onclick="setCatalogFilter('web')"
              id="nav-web"
              class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">web</span>
              <span>Interactive &amp; Web</span>
            </button>
          </div>

          <!-- Archival & Storage Group -->
          <div class="flex flex-col gap-1.5 pt-2">
            <span class="font-mono text-[9px] uppercase tracking-widest text-gray-500 px-3">ARCHIVAL &amp; STORAGE</span>
            
            <a
              href="/about"
              target="_blank"
              class="flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
            >
              <span class="material-symbols-outlined text-[18px]">menu_book</span>
              <span>Monograph &amp; Journal</span>
            </a>

            <button
              type="button"
              onclick="showVaultInfo()"
              class="flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">folder</span>
              <span>Asset Vault</span>
            </button>
          </div>

          <!-- Configuration Group -->
          <div class="flex flex-col gap-1.5 pt-2">
            <span class="font-mono text-[9px] uppercase tracking-widest text-gray-500 px-3">CONFIGURATION</span>
            
            <button
              type="button"
              onclick="showStudioPreferences()"
              class="flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors w-full text-left"
            >
              <span class="material-symbols-outlined text-[18px]">tune</span>
              <span>Studio Preferences</span>
            </button>
          </div>

        </div>

      </div>

      <!-- Bottom User Profile & Sign Out -->
      <div class="p-4 border-t border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-blue-600/30 border border-blue-500/40 text-blue-400 flex items-center justify-center font-bold text-xs">
            RP
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-semibold text-white">Rangga Permadi</span>
            <span class="font-mono text-[10px] text-gray-500">Principal Admin</span>
          </div>
        </div>

        <button
          type="button"
          onclick="handleLogout()"
          title="Sign Out of Studio Workspace"
          class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">logout</span>
        </button>
      </div>

    </aside>


    <!-- ==============================================================
         2. MAIN WORKSPACE VIEWPORT
         ============================================================== -->
    <main class="flex-grow flex flex-col h-full overflow-hidden bg-[#0e0e10] relative">
      
      <!-- Top Navigation & Edge Status Bar -->
      <header class="h-14 border-b border-white/5 px-6 flex items-center justify-between bg-[#111114]/50 backdrop-blur-md shrink-0">
        
        <!-- Left Breadcrumbs -->
        <div class="flex items-center gap-6">
          <a
            href="/"
            class="text-xs text-gray-400 hover:text-white transition-colors flex items-center gap-1.5"
          >
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>View Live Portfolio</span>
          </a>

          <!-- Tokyo Edge Node Sync Indicator -->
          <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/30 border border-emerald-500/20 text-emerald-400 font-mono text-[10px]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Synchronized • Tokyo Ed. Node 01</span>
          </div>
        </div>

        <!-- Right Quick Search & Profile -->
        <div class="flex items-center gap-3">
          <div class="relative w-64 hidden sm:block">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-[16px] text-gray-500">search</span>
            <input
              type="text"
              id="top-filter-input"
              oninput="handleQuickSearch(event)"
              placeholder="Filter entries, lenses, tags..."
              class="w-full bg-[#18181c] border border-white/5 rounded-full pl-9 pr-3 py-1.5 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500 font-mono"
            />
          </div>

          <button class="p-1.5 rounded-full text-gray-400 hover:text-white hover:bg-white/5 transition-colors" title="Filter Options">
            <span class="material-symbols-outlined text-[18px]">tune</span>
          </button>
          
          <button class="p-1.5 rounded-full text-gray-400 hover:text-white hover:bg-white/5 transition-colors relative" title="Notifications">
            <span class="material-symbols-outlined text-[18px]">notifications</span>
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 absolute top-1.5 right-1.5"></span>
          </button>

          <div class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center text-[11px] font-bold text-white shadow-sm">
            RP
          </div>
        </div>

      </header>

      <!-- Scrollable Workspace Body -->
      <div class="flex-grow overflow-y-auto px-6 py-6 flex flex-col gap-6">

        <!-- Title & Subtitle Cluster -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-gray-400">STUDIO CURATION SYSTEM — PRODUCTION LEVEL 04</span>
            </div>
            <h1 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-white">
              Content Management &amp; Archival Index
            </h1>
            <p class="font-body text-xs text-gray-400 max-w-2xl leading-relaxed">
              Curate, publish, edit, and orchestrate case studies across Photography, Film, Brand Identity, and Digital Architecture.
            </p>
          </div>

          <!-- Counter Stat Badges -->
          <div class="flex flex-wrap items-center gap-2 font-mono text-[10.5px]">
            <span class="px-2.5 py-1 rounded-full bg-blue-950/40 border border-blue-500/20 text-blue-300 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
              <span>42 Published Artifacts</span>
            </span>
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-white/5 text-gray-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
              <span>03 Pending Drafts</span>
            </span>
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-white/5 text-gray-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span>02 Scheduled</span>
            </span>
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-white/5 text-gray-400 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[13px]">hard_drive</span>
              <span>Vault: 14.8 GB / 100 GB</span>
            </span>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 pt-1">
          
          <!-- Search Box -->
          <div class="relative w-full max-w-md">
            <span class="material-symbols-outlined absolute left-3.5 top-2.5 text-[16px] text-gray-500">search</span>
            <input
              type="text"
              id="main-search-input"
              oninput="filterWorksTable()"
              placeholder="Search works by title, client, discipline..."
              class="w-full bg-[#141417] border border-white/5 rounded-full pl-10 pr-4 py-2 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500 font-mono shadow-inner"
            />
          </div>

          <!-- Category Segmented Filters -->
          <div class="flex flex-wrap items-center gap-1 bg-[#141417] p-1 rounded-full border border-white/5 font-mono text-[10.5px]">
            <button
              onclick="setDisciplineTab('all', this)"
              class="disc-tab active px-3.5 py-1 rounded-full bg-white/10 text-white font-medium transition-colors"
            >
              ALL WORKS (42)
            </button>
            <button
              onclick="setDisciplineTab('photo', this)"
              class="disc-tab px-3 py-1 rounded-full text-gray-400 hover:text-white transition-colors"
            >
              PHOTO (12)
            </button>
            <button
              onclick="setDisciplineTab('video', this)"
              class="disc-tab px-3 py-1 rounded-full text-gray-400 hover:text-white transition-colors"
            >
              VIDEO (8)
            </button>
            <button
              onclick="setDisciplineTab('design', this)"
              class="disc-tab px-3 py-1 rounded-full text-gray-400 hover:text-white transition-colors"
            >
              DESIGN (14)
            </button>
            <button
              onclick="setDisciplineTab('web', this)"
              class="disc-tab px-3 py-1 rounded-full text-gray-400 hover:text-white transition-colors"
            >
              WEB (8)
            </button>
          </div>

          <!-- Right Action Buttons -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="toggleBatchSort()"
              class="px-3.5 py-2 rounded-full bg-[#18181c] hover:bg-[#202026] text-gray-300 font-mono text-[11px] border border-white/10 transition-colors flex items-center gap-1.5 cursor-pointer"
            >
              <span class="material-symbols-outlined text-[15px]">swap_vert</span>
              <span>Batch Reorder &amp; Sort</span>
            </button>

            <button
              type="button"
              onclick="openCreateDrawer()"
              class="px-4 py-2 rounded-full bg-[#2563eb] hover:bg-blue-600 text-white font-display font-medium text-xs shadow-lg shadow-blue-600/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
            >
              <span class="material-symbols-outlined text-[16px]">add</span>
              <span>Create New Entry</span>
            </button>
          </div>

        </div>

        <!-- Studio Metrics Cards Row (4 Metrics) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
          
          <!-- Metric 1: Active Exposure -->
          <div class="bg-[#141417] border border-white/5 rounded-2xl p-4 flex flex-col justify-between shadow-sm">
            <span class="font-mono text-[10px] text-gray-500 uppercase tracking-wider">ACTIVE EXPOSURE</span>
            <div class="flex items-baseline gap-2 py-1">
              <span class="font-display text-2xl font-bold text-white tracking-tight">143.0k</span>
              <span class="font-mono text-[10.5px] text-emerald-400 font-medium">+18.4%</span>
            </div>
            <span class="font-mono text-[10px] text-gray-400">DCI-P3 High Res Hits</span>
          </div>

          <!-- Metric 2: Featured Awards -->
          <div class="bg-[#141417] border border-white/5 rounded-2xl p-4 flex flex-col justify-between shadow-sm">
            <span class="font-mono text-[10px] text-gray-500 uppercase tracking-wider">FEATURED AWARDS</span>
            <div class="flex items-baseline gap-2 py-1">
              <span class="font-display text-2xl font-bold text-white tracking-tight">11</span>
              <span class="font-mono text-[10px] text-gray-400">Awwwards / Red Dot</span>
            </div>
            <span class="font-mono text-[10px] text-gray-400">International juries</span>
          </div>

          <!-- Metric 3: Media Resolution -->
          <div class="bg-[#141417] border border-white/5 rounded-2xl p-4 flex flex-col justify-between shadow-sm">
            <span class="font-mono text-[10px] text-gray-500 uppercase tracking-wider">MEDIA RESOLUTION</span>
            <div class="flex items-baseline gap-2 py-1">
              <span class="font-display text-2xl font-bold text-white tracking-tight">4K DCI</span>
              <span class="font-mono text-[10px] text-blue-400 bg-blue-950/50 px-1.5 py-0.5 rounded">ProRes 4444</span>
            </div>
            <span class="font-mono text-[10px] text-gray-400">Cinematic Standard</span>
          </div>

          <!-- Metric 4: Sync Health -->
          <div class="bg-[#141417] border border-white/5 rounded-2xl p-4 flex flex-col justify-between shadow-sm">
            <span class="font-mono text-[10px] text-gray-500 uppercase tracking-wider">SYNC HEALTH</span>
            <div class="flex items-baseline gap-2 py-1">
              <span class="material-symbols-outlined text-blue-400 text-[18px]">cloud_done</span>
              <span class="font-display text-2xl font-bold text-white tracking-tight">99.98%</span>
            </div>
            <span class="font-mono text-[10px] text-gray-400">Global Edge CDN</span>
          </div>

        </div>

        <!-- Curated Works List Table / Cards -->
        <div class="flex flex-col gap-2.5" id="works-list-container">
          <!-- Dynamic Items Injected Here -->
        </div>

        <!-- Pagination Bar -->
        <div class="border-t border-white/5 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-[10.5px] text-gray-500 pb-10">
          <span id="pagination-status">Showing 06 of 42 cataloged exhibits</span>
          <div class="flex items-center gap-3">
            <button class="hover:text-white transition-colors" onclick="changePage(-1)">Previous Frame</button>
            <span class="px-2 py-1 rounded bg-[#18181c] text-gray-300">1 / 7</span>
            <button class="hover:text-white transition-colors" onclick="changePage(1)">Next Frame</button>
          </div>
        </div>

      </div>

      <!-- Static Bottom Telemetry Bar -->
      <footer class="h-8 border-t border-white/5 px-6 flex items-center justify-between bg-[#0e0e10] shrink-0 font-mono text-[9.5px] text-gray-500 tracking-wider">
        <div class="flex items-center gap-4">
          <span>© FRAME OF RANGGA STUDIO</span>
          <span class="hidden md:inline">LOC: 35.6762° N, 139.6503° E</span>
          <span class="hidden lg:inline">COLOR PROFILE: DCI-P3 6500K</span>
        </div>
        <div class="flex items-center gap-4">
          <span>ENGINE LATENCY: 14MS</span>
          <span class="text-emerald-400">SECURE RESTRICTED ACCESS</span>
        </div>
      </footer>

    </main>


    <!-- ==============================================================
         3. ACTIVE INSPECTOR (RIGHT DRAWER)
         ============================================================== -->
    <aside
      id="inspector-drawer"
      class="w-96 bg-[#131316] border-l border-white/5 h-full flex flex-col justify-between shrink-0 overflow-hidden transition-all duration-300 transform translate-x-full fixed right-0 top-0 bottom-0 z-30 shadow-2xl"
    >
      
      <!-- Drawer Header -->
      <div class="p-5 border-b border-white/5 flex items-center justify-between shrink-0">
        <div class="flex flex-col">
          <span class="font-mono text-[9px] uppercase tracking-widest text-gray-500">ACTIVE INSPECTOR</span>
          <h2 class="font-display text-base font-bold text-white tracking-tight" id="inspector-title">Curate Work Detail</h2>
        </div>
        <button
          type="button"
          onclick="closeInspectorDrawer()"
          class="p-1 rounded-full text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <!-- Drawer Form Body (Scrollable) -->
      <div class="flex-grow overflow-y-auto p-5 flex flex-col gap-4 font-mono text-xs">
        
        <!-- Hidden Item Identifiers -->
        <input type="hidden" id="edit-id" />
        <input type="hidden" id="edit-type" value="photo" />

        <!-- Project Exhibition Title -->
        <div class="flex flex-col gap-1.5">
          <label class="text-[10px] text-gray-400 tracking-wider uppercase">PROJECT EXHIBITION TITLE</label>
          <input
            type="text"
            id="edit-title"
            value="The Ocean Series"
            class="w-full bg-[#0d0d0f] border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500"
          />
        </div>

        <!-- Discipline Pillar Selector -->
        <div class="flex flex-col gap-1.5">
          <label class="text-[10px] text-gray-400 tracking-wider uppercase">DISCIPLINE PILLAR</label>
          <div class="grid grid-cols-4 gap-1 bg-[#0d0d0f] p-1 rounded-xl border border-white/10 text-center">
            <button type="button" onclick="selectPillar('photo')" id="pillar-photo" class="pillar-btn active py-1.5 rounded-lg bg-white text-[#0e0e10] font-bold text-[10px]">PHOTO</button>
            <button type="button" onclick="selectPillar('video')" id="pillar-video" class="pillar-btn py-1.5 rounded-lg text-gray-400 hover:text-white font-medium text-[10px]">VIDEO</button>
            <button type="button" onclick="selectPillar('design')" id="pillar-design" class="pillar-btn py-1.5 rounded-lg text-gray-400 hover:text-white font-medium text-[10px]">DESIGN</button>
            <button type="button" onclick="selectPillar('web')" id="pillar-web" class="pillar-btn py-1.5 rounded-lg text-gray-400 hover:text-white font-medium text-[10px]">WEB</button>
          </div>
