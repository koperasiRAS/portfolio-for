    // Filter Handlers
    function setDisciplineTab(discipline, btn) {
      currentFilter = discipline;
      document.querySelectorAll('.disc-tab').forEach(b => {
        b.classList.remove('active', 'bg-white/10', 'text-white');
        b.classList.add('text-gray-400');
      });
      if (btn) {
        btn.classList.add('active', 'bg-white/10', 'text-white');
        btn.classList.remove('text-gray-400');
      }
      renderWorksList();
    }

    function setCatalogFilter(cat) {
      document.querySelectorAll('.sidebar-nav-item').forEach(b => {
        b.classList.remove('active', 'bg-white/10', 'text-white');
        b.classList.add('text-gray-400');
      });
      const activeBtn = document.getElementById(`nav-${cat}`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-white/10', 'text-white');
        activeBtn.classList.remove('text-gray-400');
      }
      currentFilter = cat;
      renderWorksList();
    }

    function filterWorksTable() {
      searchQuery = document.getElementById('main-search-input').value.toLowerCase().trim();
      renderWorksList();
    }

    function handleQuickSearch(e) {
      searchQuery = e.target.value.toLowerCase().trim();
      document.getElementById('main-search-input').value = searchQuery;
      renderWorksList();
    }

    // Drawer Management (Active Inspector)
    function openEditDrawer(id) {
      const item = catalogItems.find(i => i.id === id);
      if (!item) return;

      document.getElementById('edit-id').value = item.id;
      document.getElementById('edit-type').value = item.discipline;
      document.getElementById('inspector-title').textContent = 'Curate Work Detail';
      document.getElementById('edit-title').value = item.title;
      document.getElementById('edit-client').value = item.client;
      document.getElementById('edit-year').value = item.year;
      document.getElementById('edit-statement').value = item.statement;
      document.getElementById('current-asset-label').textContent = `Current: ${item.asset}`;
      document.getElementById('edit-visibility').checked = item.status === 'published';

      selectPillar(item.discipline);
      renderTags(item.tags || []);

      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.remove('translate-x-full');
    }

    function openCreateDrawer() {
      document.getElementById('edit-id').value = '';
      document.getElementById('edit-type').value = 'photo';
      document.getElementById('inspector-title').textContent = 'New Archival Entry';
      document.getElementById('edit-title').value = '';
      document.getElementById('edit-client').value = '';
      document.getElementById('edit-year').value = new Date().getFullYear().toString();
      document.getElementById('edit-statement').value = '';
      document.getElementById('current-asset-label').textContent = 'No asset attached';
      document.getElementById('edit-visibility').checked = true;

      selectPillar('photo');
      renderTags(['Leica M6', '35mm Film']);

      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.remove('translate-x-full');
    }

    function closeInspectorDrawer() {
      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.add('translate-x-full');
    }

    function selectPillar(pillar) {
      document.getElementById('edit-type').value = pillar;
      document.querySelectorAll('.pillar-btn').forEach(btn => {
        btn.classList.remove('bg-white', 'text-[#0e0e10]', 'font-bold');
        btn.classList.add('text-gray-400', 'font-medium');
      });
      const activeBtn = document.getElementById(`pillar-${pillar}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'text-[#0e0e10]', 'font-bold');
        activeBtn.classList.remove('text-gray-400', 'font-medium');
      }
    }

    function renderTags(tags) {
      const container = document.getElementById('tags-container');
      container.innerHTML = tags.map(tag => `
        <span class="px-2 py-1 rounded bg-[#1e1e24] text-gray-300 text-[10px] flex items-center gap-1">
          ${tag}
          <button type="button" onclick="removeTag(this)" class="hover:text-red-400">&times;</button>
        </span>
      `).join('') + `
        <button
          type="button"
          onclick="addTagPrompt()"
          class="px-2 py-1 rounded border border-dashed border-white/20 text-gray-400 hover:text-white text-[10px]"
        >
          + Tag
        </button>
      `;
    }

    function removeTag(btn) {
      btn.parentElement.remove();
    }

    function addTagPrompt() {
      const newTag = prompt('Masukkan nama tag teknis (contoh: 50mm Summilux, DaVinci):');
      if (newTag && newTag.trim()) {
        const container = document.getElementById('tags-container');
        const tagSpan = document.createElement('span');
        tagSpan.className = 'px-2 py-1 rounded bg-[#1e1e24] text-gray-300 text-[10px] flex items-center gap-1';
        tagSpan.innerHTML = `${newTag.trim()} <button type="button" onclick="removeTag(this)" class="hover:text-red-400">&times;</button>`;
        container.insertBefore(tagSpan, container.lastElementChild);
      }
    }

    function handleFileChange(e) {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        document.getElementById('current-asset-label').textContent = `Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        showToast(`Asset '${file.name}' di-buffer untuk upload`);
      }
    }

    function updateAndSyncLive() {
      const id = document.getElementById('edit-id').value;
      const title = document.getElementById('edit-title').value.trim();
      const discipline = document.getElementById('edit-type').value;
      const client = document.getElementById('edit-client').value.trim();
      const year = document.getElementById('edit-year').value.trim();
      const statement = document.getElementById('edit-statement').value.trim();
      const isVisible = document.getElementById('edit-visibility').checked;

      if (!title) {
        alert('Silakan isi judul pameran / proyek.');
        return;
      }

      if (id) {
        const item = catalogItems.find(i => i.id === id);
        if (item) {
          item.title = title;
          item.discipline = discipline;
          item.client = client;
          item.year = year;
          item.statement = statement;
          item.status = isVisible ? 'published' : 'draft';
        }
      } else {
        const newId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        catalogItems.unshift({
          id: newId,
          badge: discipline.toUpperCase(),
          discipline: discipline,
          disciplineLabel: `${discipline.toUpperCase()} • Curated Entry`,
          title: title,
          subtext: `${client || 'Studio Commission'} • ${year}`,
          client: client,
          year: year,
          status: isVisible ? 'published' : 'draft',
          views: '0 views',
          asset: 'master_upload.raw',
          image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCLUmgq8ihNYNNLzO10X4Fi1Ng3GBBBovXTJ7Bsd6tIsPtyUVmZB5LfEFaZ7AZwga9UKqnvmCPyxy2qnxnNFmyqQZPpaH4fnhYAK3gCutU8eZr2DGUFiyA4nAf7ImlPqH1FlnQi7OjcCbZDwVMCithWVdMYOYB9OzMz_U1ubX3s_ysCGddStb91qOU3x5bGPAlK_2BqrCVoJf8LvqDIRy6HxjLztTwnmbYUZk5of-XF0rZIylsIbeun',
          statement: statement,
          tags: ['Studio', discipline]
        });
      }

      showToast(`'${title}' berhasil disinkronkan ke Tokyo Ed. Node 01`);
      closeInspectorDrawer();
      renderWorksList();
    }

    function saveArchivalDraft() {
      document.getElementById('edit-visibility').checked = false;
      updateAndSyncLive();
    }

    function deleteArchivalRecord() {
      const id = document.getElementById('edit-id').value;
      if (!id) return;
      if (confirm('Hapus permanen arsip karya ini dari cloud vault?')) {
        catalogItems = catalogItems.filter(i => i.id !== id);
        closeInspectorDrawer();
        renderWorksList();
        showToast('Arsip karya dihapus dari sistem');
      }
    }

    function publishDraftDirectly(id) {
      const item = catalogItems.find(i => i.id === id);
      if (item) {
        item.status = 'published';
        renderWorksList();
        showToast(`'${item.title}' kini live di pameran global`);
      }
    }

    function duplicateWorkItem(id) {
      const item = catalogItems.find(i => i.id === id);
      if (!item) return;
      const copy = { ...item, id: item.id + '-copy', title: item.title + ' (Copy)', status: 'draft' };
      catalogItems.unshift(copy);
      renderWorksList();
      showToast(`Duplikasi karya berhasil dibuat`);
    }

    function previewWorkItem(discipline) {
      const routeMap = {
        photo: '/foto',
        video: '/video',
        design: '/design',
        web: '/website'
      };
      window.open(routeMap[discipline] || '/', '_blank');
    }

    function deleteWorkItem(id) {
      if (confirm('Hapus arsip ini?')) {
        catalogItems = catalogItems.filter(i => i.id !== id);
        renderWorksList();
        showToast('Karya dihapus dari katalog');
      }
    }

    function toggleBatchSort() {
      catalogItems.reverse();
      renderWorksList();
      showToast('Urutan katalog diperbarui');
    }

    function changePage(delta) {
      showToast(`Berpindah ke Frame halaman`);
    }

    function showVaultInfo() {
      alert('Asset Vault: 14.8 GB terpakai dari 100 GB Cloudflare R2 / S3 archival tier.');
    }

    function showStudioPreferences() {
      alert('Studio Preferences: Tokyo Ed. Node 01 • DCI-P3 6500K Calibration • Edge Cache: 99.98% Healthy');
    }

    function handleLogout() {
      if (confirm('Keluar dari Studio Curation Engine?')) {
        localStorage.removeItem('for_studio_token');
        localStorage.removeItem('for_studio_token_time');
        window.location.href = '/admin/login';
      }
    }

    function showToast(message) {
      const toast = document.getElementById('cms-toast');
      const text = document.getElementById('toast-message');
      text.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }
  </script>
</body>
</html>
