  <!-- ==============================================================
       CLIENT-SIDE SCRIPTING & SYNCHRONIZATION
       ============================================================== -->
  <script is:inline>
    // Authentication Validation
    const token = localStorage.getItem('for_studio_token');
    if (!token) {
      // If not logged in, redirect to login
      window.location.href = '/admin/login';
    }

    // --- API-backed catalog ---
    let catalogItems = [];
    let profileData = {};
    let activeTab = 'all'; // 'all' | 'photos' | 'videos' | 'designs' | 'websites' | 'profile'

    const disciplineMap = { photo: 'photos', video: 'videos', design: 'designs', web: 'websites' };
    const badgeMap = {
      photos: 'RAW', videos: '16MM', designs: 'ID', websites: 'WEBGL',
      photo: 'RAW', video: '16MM', design: 'ID', web: 'WEBGL'
    };

    function mapApiItem(item, discipline, index) {
      const dKey = disciplineMap[discipline] || discipline;
      return {
        id: item.slug || (discipline + '_' + index),
        badge: badgeMap[discipline] || (discipline || '').toUpperCase().slice(0,4),
        discipline: discipline,
        disciplineLabel: discipline.toUpperCase() + ' • Studio Entry',
        title: item.title || item.name || '(untitled)',
        subtext: item.client || item.category ? `${item.client || item.category} • ${item.year || new Date().getFullYear()}` : String(item.year || ''),
        client: item.client || '',
        year: String(item.year || new Date().getFullYear()),
        status: item.isFeatured || item.featuredHome ? 'published' : 'draft',
        views: item.views || '—',
        asset: item.slug ? item.slug + '.json' : '',
        image: item.imagePath || item.thumbnailPath || '',
        statement: item.description || '',
        tags: (item.tags || []).slice(0, 3),
        _raw: item  // keep full original data for saving back
      };
    }

    function authHeaders(extra = {}) {
      const t = localStorage.getItem('for_studio_token');
      const h = { 'Authorization': 'Bearer ' + (t || ''), ...extra };
      return h;
    }

    async function loadCatalog() {
      try {
        const res = await fetch('/api/admin/data', { headers: authHeaders() });
        if (res.status === 401) { window.location.href = '/admin/login'; return; }
        const json = await res.json();
        if (!json.success) throw new Error(json.error);
        const { photos, videos, designs, websites, profile } = json.data;
        profileData = profile;
        catalogItems = [];
        (photos || []).forEach((item, i) => catalogItems.push(mapApiItem(item, 'photo', i)));
        (videos || []).forEach((item, i) => catalogItems.push(mapApiItem(item, 'video', i)));
        (designs || []).forEach((item, i) => catalogItems.push(mapApiItem(item, 'design', i)));
        (websites || []).forEach((item, i) => catalogItems.push(mapApiItem(item, 'web', i)));
      } catch (e) {
        console.warn('API fetch failed, using empty catalog', e);
      }
      updateMetrics();
    }

    async function saveToApi(item) {
      const discipline = item.discipline || 'photo';
      const type = disciplineMap[discipline] || discipline;
      const payload = {
        type: type,
        action: item._isNew ? 'create' : 'update',
        slug: item.id,
        data: {
          ...item._raw,
          title: item.title,
          description: item.statement,
          client: item.client,
          year: item.year,
          isFeatured: item.status === 'published',
        }
      };
      const res = await fetch('/api/admin/save', {
        method: 'POST',
        headers: authHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify(payload)
      });
      if (res.status === 401) { window.location.href = '/admin/login'; return res.json(); }
      return res.json();
    }

    async function deleteFromApi(item) {
      const discipline = item.discipline || 'photo';
      const type = disciplineMap[discipline] || discipline;
      const res = await fetch('/api/admin/save', {
        method: 'POST',
        headers: authHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({ type, action: 'delete', slug: item.id, data: {} })
      });
      if (res.status === 401) { window.location.href = '/admin/login'; return res.json(); }
      return res.json();
    }

    function updateMetrics() {
      const el = document.getElementById('metrics-live');
      if (!el) return;
      const byDiscipline = (d) => catalogItems.filter(i => i.discipline === d).length;
      el.innerHTML =
        `<div class="flex items-center gap-2 p-2.5 rounded-lg bg-[#0d0d0f] border border-white/5 flex-1 min-w-0">` +
          `<span class="material-symbols-outlined text-[18px] text-blue-400 shrink-0">photo_camera</span>` +
          `<div class="flex flex-col"><span class="text-sm font-mono font-bold text-white">${byDiscipline('photo')}</span><span class="text-[9px] text-gray-500 uppercase tracking-wider">Photos</span></div>` +
        `</div>` +
        `<div class="flex items-center gap-2 p-2.5 rounded-lg bg-[#0d0d0f] border border-white/5 flex-1 min-w-0">` +
          `<span class="material-symbols-outlined text-[18px] text-emerald-400 shrink-0">movie</span>` +
          `<div class="flex flex-col"><span class="text-sm font-mono font-bold text-white">${byDiscipline('video')}</span><span class="text-[9px] text-gray-500 uppercase tracking-wider">Videos</span></div>` +
        `</div>` +
        `<div class="flex items-center gap-2 p-2.5 rounded-lg bg-[#0d0d0f] border border-white/5 flex-1 min-w-0">` +
          `<span class="material-symbols-outlined text-[18px] text-amber-400 shrink-0">palette</span>` +
          `<div class="flex flex-col"><span class="text-sm font-mono font-bold text-white">${byDiscipline('design')}</span><span class="text-[9px] text-gray-500 uppercase tracking-wider">Design</span></div>` +
        `</div>` +
        `<div class="flex items-center gap-2 p-2.5 rounded-lg bg-[#0d0d0f] border border-white/5 flex-1 min-w-0">` +
          `<span class="material-symbols-outlined text-[18px] text-cyan-400 shrink-0">web</span>` +
          `<div class="flex flex-col"><span class="text-sm font-mono font-bold text-white">${byDiscipline('web')}</span><span class="text-[9px] text-gray-500 uppercase tracking-wider">Web</span></div>` +
        `</div>`;
    }

    let currentFilter = 'all';
    let searchQuery = '';

    // Initialize View
    document.addEventListener('DOMContentLoaded', async () => {
      await loadCatalog();
      renderWorksList();
    });

    function renderWorksList() {
      const container = document.getElementById('works-list-container');
      const filtered = catalogItems.filter(item => {
        const matchesCategory = currentFilter === 'all' || item.discipline === currentFilter;
        const matchesSearch = !searchQuery || 
          item.title.toLowerCase().includes(searchQuery) ||
          item.subtext.toLowerCase().includes(searchQuery) ||
          item.client.toLowerCase().includes(searchQuery);
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="p-12 text-center flex flex-col items-center justify-center gap-2 border border-white/5 rounded-2xl bg-[#141417]">
            <span class="material-symbols-outlined text-gray-500 text-[36px]">filter_list_off</span>
            <p class="font-mono text-xs text-gray-400">Tidak ada karya yang sesuai dengan filter '${searchQuery || currentFilter}'</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(item => `
        <div class="bg-[#141417] hover:bg-[#18181c] border border-white/5 rounded-2xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 transition-colors group">
          
          <!-- Left: Thumbnail & Core Metadata -->
          <div class="flex items-center gap-4 min-w-0">
            <div class="relative w-16 h-12 rounded-xl overflow-hidden bg-black/60 shrink-0 border border-white/10">
              <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
              <span class="absolute bottom-1 right-1 font-mono text-[8px] bg-black/80 px-1 py-0.2 rounded text-gray-300 uppercase">${item.badge}</span>
            </div>

            <div class="flex flex-col min-w-0">
              <span class="font-mono text-[9.5px] uppercase tracking-wider text-gray-400 truncate">${item.disciplineLabel}</span>
              <h3 class="font-display text-sm font-bold text-white tracking-tight truncate">${item.title}</h3>
              <p class="font-mono text-[10.5px] text-gray-500 truncate">${item.subtext}</p>
            </div>
          </div>

          <!-- Right: Status, Views, Inline Actions -->
          <div class="flex items-center gap-4 shrink-0 self-end md:self-center">
            
            ${item.status === 'published' ? `
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-full bg-cyan-950/40 border border-cyan-500/20 text-cyan-300 font-mono text-[10px] flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                  Published
                </span>
                <span class="font-mono text-[10px] text-gray-500">${item.views}</span>
              </div>
            ` : `
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-full bg-zinc-900 border border-white/10 text-gray-400 font-mono text-[10px]">
                  Draft In-Review
                </span>
                <button
                  type="button"
                  onclick="publishDraftDirectly('${item.id}')"
                  class="px-3 py-1 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-mono text-[10px] font-semibold transition-all shadow-sm"
                >
                  PUBLISH NOW
                </button>
              </div>
            `}

            <!-- Inline Icon Actions -->
            <div class="flex items-center gap-1 border-l border-white/10 pl-3">
              <button
                type="button"
                onclick="openEditDrawer('${item.id}')"
                title="Edit Work"
                class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <span class="material-symbols-outlined text-[17px]">edit</span>
              </button>

              <button
                type="button"
                onclick="previewWorkItem('${item.discipline}')"
                title="Live Preview"
                class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <span class="material-symbols-outlined text-[17px]">visibility</span>
              </button>

              <button
                type="button"
                onclick="duplicateWorkItem('${item.id}')"
                title="Duplicate Entry"
                class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors"
              >
                <span class="material-symbols-outlined text-[17px]">content_copy</span>
              </button>

              <button
                type="button"
                onclick="deleteWorkItem('${item.id}')"
                title="Delete Entry"
                class="p-1.5 rounded-lg text-gray-400 hover:text-red-400 hover:bg-red-950/20 transition-colors"
              >
                <span class="material-symbols-outlined text-[17px]">delete</span>
              </button>
            </div>

          </div>

        </div>
      `).join('');
    }

    // Filter Handlers
    function setDisciplineTab(discipline, btn) {
      currentFilter = discipline;
      document.querySelectorAll('.disc-tab').forEach(b => {
        b.classList.remove('active', 'bg-white/10', 'text-white');
        b.classList.add('text-gray-400');
      });
      if (btn) {
        btn.classList.add('active', 'bg-white/10', 'text-white');
        btn.classList.remove('text-gray-400');
      }
      renderWorksList();
    }

    function setCatalogFilter(cat) {
      document.querySelectorAll('.sidebar-nav-item').forEach(b => {
        b.classList.remove('active', 'bg-white/10', 'text-white');
        b.classList.add('text-gray-400');
      });
      const activeBtn = document.getElementById(`nav-${cat}`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-white/10', 'text-white');
        activeBtn.classList.remove('text-gray-400');
      }
      currentFilter = cat;
      renderWorksList();
    }

    function filterWorksTable() {
      searchQuery = document.getElementById('main-search-input').value.toLowerCase().trim();
      renderWorksList();
    }

    function handleQuickSearch(e) {
      searchQuery = e.target.value.toLowerCase().trim();
      document.getElementById('main-search-input').value = searchQuery;
      renderWorksList();
    }

    // Drawer Management (Active Inspector)
    function openEditDrawer(id) {
      const item = catalogItems.find(i => i.id === id);
      if (!item) return;

      document.getElementById('edit-id').value = item.id;
      document.getElementById('edit-type').value = item.discipline;
      document.getElementById('inspector-title').textContent = 'Curate Work Detail';
      document.getElementById('edit-title').value = item.title;
      document.getElementById('edit-client').value = item.client;
      document.getElementById('edit-year').value = item.year;
      document.getElementById('edit-statement').value = item.statement;
      document.getElementById('current-asset-label').textContent = `Current: ${item.asset}`;
      document.getElementById('edit-visibility').checked = item.status === 'published';

      selectPillar(item.discipline);
      renderTags(item.tags || []);

      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.remove('translate-x-full');
    }

    function openCreateDrawer() {
      document.getElementById('edit-id').value = '';
      document.getElementById('edit-type').value = 'photo';
      document.getElementById('inspector-title').textContent = 'New Archival Entry';
      document.getElementById('edit-title').value = '';
      document.getElementById('edit-client').value = '';
      document.getElementById('edit-year').value = new Date().getFullYear().toString();
      document.getElementById('edit-statement').value = '';
      document.getElementById('current-asset-label').textContent = 'No asset attached';
      document.getElementById('edit-visibility').checked = true;

      selectPillar('photo');
      renderTags(['Leica M6', '35mm Film']);

      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.remove('translate-x-full');
    }

    function closeInspectorDrawer() {
      const drawer = document.getElementById('inspector-drawer');
      drawer.classList.add('translate-x-full');
    }

    function selectPillar(pillar) {
      document.getElementById('edit-type').value = pillar;
      document.querySelectorAll('.pillar-btn').forEach(btn => {
        btn.classList.remove('bg-white', 'text-[#0e0e10]', 'font-bold');
        btn.classList.add('text-gray-400', 'font-medium');
      });
      const activeBtn = document.getElementById(`pillar-${pillar}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'text-[#0e0e10]', 'font-bold');
        activeBtn.classList.remove('text-gray-400', 'font-medium');
      }
    }

    function renderTags(tags) {
      const container = document.getElementById('tags-container');
      container.innerHTML = tags.map(tag => `
        <span class="px-2 py-1 rounded bg-[#1e1e24] text-gray-300 text-[10px] flex items-center gap-1">
          ${tag}
          <button type="button" onclick="removeTag(this)" class="hover:text-red-400">&times;</button>
        </span>
      `).join('') + `
        <button
          type="button"
          onclick="addTagPrompt()"
          class="px-2 py-1 rounded border border-dashed border-white/20 text-gray-400 hover:text-white text-[10px]"
        >
          + Tag
        </button>
      `;
    }

    function removeTag(btn) {
      btn.parentElement.remove();
    }

    function addTagPrompt() {
      const newTag = prompt('Masukkan nama tag teknis (contoh: 50mm Summilux, DaVinci):');
      if (newTag && newTag.trim()) {
        const container = document.getElementById('tags-container');
        const tagSpan = document.createElement('span');
        tagSpan.className = 'px-2 py-1 rounded bg-[#1e1e24] text-gray-300 text-[10px] flex items-center gap-1';
        tagSpan.innerHTML = `${newTag.trim()} <button type="button" onclick="removeTag(this)" class="hover:text-red-400">&times;</button>`;
        container.insertBefore(tagSpan, container.lastElementChild);
      }
    }

    function handleFileChange(e) {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        document.getElementById('current-asset-label').textContent = `Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        showToast(`Asset '${file.name}' di-buffer untuk upload`);
      }
    }

    function updateAndSyncLive() {
      const id = document.getElementById('edit-id').value;
      const title = document.getElementById('edit-title').value.trim();
      const discipline = document.getElementById('edit-type').value;
      const client = document.getElementById('edit-client').value.trim();
      const year = document.getElementById('edit-year').value.trim();
      const statement = document.getElementById('edit-statement').value.trim();
      const isVisible = document.getElementById('edit-visibility').checked;

      if (!title) {
        alert('Silakan isi judul pameran / proyek.');
        return;
      }

      if (id) {
        const item = catalogItems.find(i => i.id === id);
        if (item) {
          item.title = title;
          item.discipline = discipline;
          item.client = client;
          item.year = year;
          item.statement = statement;
          item.status = isVisible ? 'published' : 'draft';
          // Save to API
          saveToApi(item).then(res => {
            if (res.success) {
              showToast(`'${title}' tersimpan ke database`);
            } else {
              showToast('Gagal menyimpan: ' + (res.error || 'error'));
            }
          }).catch(() => showToast('Gagal terhubung ke server'));
        }
      } else {
        const newId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        const newItem = {
          id: newId,
          _isNew: true,
          _raw: { title, description: statement, client, year, isFeatured: isVisible },
          badge: (disciplineMap[discipline] || discipline).toUpperCase().slice(0, 4),
          discipline: discipline,
          disciplineLabel: `${discipline.toUpperCase()} • Curated Entry`,
          title: title,
          subtext: `${client || 'Studio Commission'} • ${year}`,
          client: client,
          year: year,
          status: isVisible ? 'published' : 'draft',
          views: '0 views',
          asset: '',
          image: '',
          statement: statement,
          tags: [discipline]
        };
        catalogItems.unshift(newItem);
        saveToApi(newItem).then(res => {
          if (res.success) {
            showToast(`'${title}' ditambahkan ke database`);
          } else {
            showToast('Gagal menambah: ' + (res.error || 'error'));
          }
        }).catch(() => showToast('Gagal terhubung ke server'));
      }

      closeInspectorDrawer();
      renderWorksList();
    }

    function saveArchivalDraft() {
      document.getElementById('edit-visibility').checked = false;
      updateAndSyncLive();
    }

    function deleteArchivalRecord() {
      const id = document.getElementById('edit-id').value;
      if (!id) return;
      const item = catalogItems.find(i => i.id === id);
      if (confirm(`Hapus '${item ? item.title : id}' dari arsip?`)) {
        deleteFromApi(item || { id, discipline: 'photo', _raw: {} }).then(res => {
          if (res.success) {
            catalogItems = catalogItems.filter(i => i.id !== id);
            showToast(`Arsip dihapus`);
          } else {
            showToast('Gagal hapus: ' + (res.error || 'error'));
          }
          closeInspectorDrawer();
          renderWorksList();
        }).catch(() => showToast('Gagal terhubung ke server'));
      }
    }

    function publishDraftDirectly(id) {
      const item = catalogItems.find(i => i.id === id);
      if (item) {
        item.status = 'published';
        saveToApi(item).then(res => {
          showToast(res.success ? `'${item.title}' kini live` : 'Gagal publish');
        }).catch(() => showToast('Gagal terhubung'));
        renderWorksList();
      }
    }

    function duplicateWorkItem(id) {
      const item = catalogItems.find(i => i.id === id);
      if (!item) return;
      const newSlug = item.id + '-copy-' + Math.random().toString(36).slice(2, 5);
      const copy = {
        ...item,
        _raw: { ...item._raw, title: item.title + ' (Copy)', isFeatured: false },
        _isNew: true,
        id: newSlug,
        title: item.title + ' (Copy)',
        status: 'draft'
      };
      catalogItems.unshift(copy);
      saveToApi(copy).then(res => {
        showToast(res.success ? `Duplikasi berhasil` : 'Gagal duplikasi');
      }).catch(() => showToast('Gagal terhubung'));
      renderWorksList();
    }

    function previewWorkItem(discipline) {
      const routeMap = {
        photo: '/foto',
        video: '/video',
        design: '/design',
        web: '/website'
      };
      window.open(routeMap[discipline] || '/', '_blank');
    }

    function deleteWorkItem(id) {
      const item = catalogItems.find(i => i.id === id);
      if (confirm(`Hapus '${item ? item.title : id}'?`)) {
        deleteFromApi(item || { id, discipline: 'photo', _raw: {} }).then(res => {
          if (res.success) {
            catalogItems = catalogItems.filter(i => i.id !== id);
            showToast('Karya dihapus dari katalog');
          } else {
            showToast('Gagal hapus');
          }
          renderWorksList();
        }).catch(() => showToast('Gagal terhubung ke server'));
      }
    }

    function toggleBatchSort() {
      catalogItems.reverse();
      renderWorksList();
      showToast('Urutan katalog diperbarui');
    }

    function changePage(delta) {
      showToast(`Berpindah ke Frame halaman`);
    }

    function showVaultInfo() {
      alert('Asset Vault: 14.8 GB terpakai dari 100 GB Cloudflare R2 / S3 archival tier.');
    }

    function showStudioPreferences() {
      const panel = document.getElementById('studio-prefs-panel');
      if (!panel) return;
      panel.classList.remove('hidden');
      panel.classList.add('flex');
    }

    function closeStudioPreferences() {
      const panel = document.getElementById('studio-prefs-panel');
      if (!panel) return;
      panel.classList.add('hidden');
      panel.classList.remove('flex');
    }

    function handleLogout() {
      if (confirm('Keluar dari Studio Curation Engine?')) {
        localStorage.removeItem('for_studio_token');
        localStorage.removeItem('for_studio_token_time');
        window.location.href = '/admin/login';
      }
    }

    function showToast(message) {
      const toast = document.getElementById('cms-toast');
      const text = document.getElementById('toast-message');
      text.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }
  </script>
</body>
</html>
