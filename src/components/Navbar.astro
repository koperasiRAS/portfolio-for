---
import LanguageToggle from './LanguageToggle.astro';

export interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', labelKey: 'nav.home', page: 'home' },
  { href: '/about', label: 'About', labelKey: 'nav.about', page: 'about' },
  { href: '/foto', label: 'Photo', labelKey: 'nav.photo', page: 'foto' },
  { href: '/video', label: 'Video', labelKey: 'nav.video', page: 'video' },
  { href: '/design', label: 'Design', labelKey: 'nav.design', page: 'design' },
  { href: '/website', label: 'Web', labelKey: 'nav.web', page: 'website' },
];
---

<header class="fixed top-0 inset-x-0 z-50 flex items-center justify-center pointer-events-none px-margin-mobile md:px-margin pt-space-md">
  <div class="h-16 w-full max-w-7xl mx-auto flex items-center justify-between pointer-events-auto px-space-md md:px-space-lg rounded-full bg-surface-container-lowest/70 backdrop-blur-xl border border-outline-variant/30 shadow-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
    <div class="flex items-center gap-space-sm">
      <a class="flex items-center gap-space-sm group" href="/">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-headline-sm text-headline-sm uppercase tracking-wider text-on-surface group-hover:text-primary transition-colors">FRAME OF RANGGA</span>
      </a>
    </div>

    <nav class="hidden lg:flex items-center gap-space-xs p-space-xs rounded-full bg-surface-container-low/40">
      {navLinks.map((link) => {
        const isActive = activePage === link.page;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            data-i18n={link.labelKey}
            class={
              isActive
                ? 'px-space-md py-space-xs rounded-full transition-colors bg-surface-container-highest text-on-surface font-medium font-body-sm text-body-sm'
                : 'px-space-md py-space-xs rounded-full font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors'
            }
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-space-sm">
      <LanguageToggle />
      <a
        href="/#contact-cta"
        class="hidden sm:inline-flex px-space-md py-space-xs rounded-full font-body-sm text-body-sm text-on-surface bg-surface-container-high/60 hover:bg-surface-container-highest hover:text-primary transition-all shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] border border-outline-variant/30"
        data-i18n="nav.contact"
      >
        Contact
      </a>
      <a
        href="/admin"
        class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0 hover:brightness-110 transition-transform active:scale-95"
        title="Studio Portal"
        aria-label="Studio Admin Portal"
      >
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </a>
      <button
        type="button"
        id="navToggle"
        class="lg:hidden w-8 h-8 rounded-full bg-surface-container-low border border-outline-variant/30 flex flex-col items-center justify-center gap-1 text-on-surface focus:outline-none cursor-pointer"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <span class="w-3.5 h-0.5 bg-on-surface transition-transform duration-200" id="bar1"></span>
        <span class="w-3.5 h-0.5 bg-on-surface transition-opacity duration-200" id="bar2"></span>
        <span class="w-3.5 h-0.5 bg-on-surface transition-transform duration-200" id="bar3"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobileNavDrawer"
  class="fixed inset-0 z-40 bg-surface-container-lowest/95 backdrop-blur-2xl transition-all duration-300 pointer-events-none opacity-0 flex flex-col justify-center items-center px-6"
  aria-hidden="true"
>
  <div class="w-full max-w-sm flex flex-col gap-3 text-center">
    <div class="flex items-center justify-center gap-2 mb-2">
      <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
      <span class="font-label-sm text-label-sm text-tertiary uppercase tracking-widest">INDEX DIRECTORY</span>
    </div>
    {navLinks.map((link) => {
      const isActive = activePage === link.page;
      return (
        <a
          href={link.href}
          class={`mobile-nav-link text-lg font-headline-sm py-2.5 px-4 rounded-full transition-colors ${
            isActive
              ? 'bg-primary-container/20 text-primary font-semibold border border-primary-container/40'
              : 'text-on-surface hover:bg-surface-container-low'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4 mt-2 border-t border-outline-variant/20 flex flex-col gap-2">
      <a
        href="/#contact-cta"
        class="mobile-nav-link w-full py-3 rounded-full font-headline-sm font-medium text-sm bg-primary-container text-on-primary-container shadow-lg hover:brightness-110 transition-all"
      >
        Get in Touch
      </a>
    </div>
  </div>
</div>

<script is:inline>
  function initStitchNav() {
    const toggle = document.getElementById('navToggle');
    const drawer = document.getElementById('mobileNavDrawer');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');
    const links = document.querySelectorAll('.mobile-nav-link');
    if (!toggle || !drawer || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    let isOpen = false;
    function openMenu() {
      isOpen = true;
      toggle.setAttribute('aria-expanded', 'true');
      drawer.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      if (bar1 && bar2 && bar3) {
        bar1.style.transform = 'translateY(4.5px) rotate(45deg)';
        bar2.style.opacity = '0';
        bar3.style.transform = 'translateY(-4.5px) rotate(-45deg)';
      }
    }
    function closeMenu() {
      isOpen = false;
      toggle.setAttribute('aria-expanded', 'false');
      drawer.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      if (bar1 && bar2 && bar3) {
        bar1.style.transform = 'none';
        bar2.style.opacity = '1';
        bar3.style.transform = 'none';
      }
    }
    toggle.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()));
    links.forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });
  }
  // i18n: update text for all data-i18n elements when language changes
  const i18nScript = document.createElement('script');
  i18nScript.src = '/js/i18n.js';
  i18nScript.async = true;
  document.head.appendChild(i18nScript);

  document.addEventListener('astro:page-load', initStitchNav);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStitchNav);
  } else {
    initStitchNav();
  }
</script>
