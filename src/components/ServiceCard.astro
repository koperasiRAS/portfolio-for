---
export interface Props {
  icon: string;
  title: string;
  description: string;
  whatsappKey?: string;
}

const { icon, title, description, whatsappKey } = Astro.props;

import { waLink } from '../utils/whatsapp.js';
const waUrl = whatsappKey ? waLink(whatsappKey) : waLink('general');
---

<div class="svc-card fade-up">
  <div class="svc-icon-wrap">
    <div class="svc-icon">
      <i class={icon}></i>
    </div>
  </div>
  <h3 class="svc-title">{title}</h3>
  <p class="svc-desc">{description}</p>
  {whatsappKey && (
    <a href={waUrl} target="_blank" rel="noopener noreferrer" class="fx-layer fx-btn fx-glass fx-sun fx-btn--sm svc-wa-btn">
      <span class="fx-label">Tanya via WhatsApp</span>
      <span class="fx-icon"><i class="fab fa-whatsapp" aria-hidden="true"></i></span>
    </a>
  )}
  <div class="svc-arrow">
    <i class="fas fa-arrow-right"></i>
  </div>
</div>

<style>
  /* Layout hooks only — visual treatment now comes from the global glass
     button system (.fx-btn .fx-sun). Kept minimal to avoid overriding the
     neumorphic shadows / sheen. */
  .svc-wa-btn {
    margin-top: auto;
    align-self: center;
  }
</style>
