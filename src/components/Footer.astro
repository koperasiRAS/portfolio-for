---
export interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'minimal' } = Astro.props;

import { waLink } from '../utils/whatsapp.js';

const bizEmailParts = ['fr', 'ameo', 'fr', 'ang', 'ga@', 'gm', 'ail.', 'co', 'm'];
const bizEmailDisplay = bizEmailParts.join('');
const bizEmailHref = 'mailto:' + bizEmailParts.join('');

const adminEmailParts = ['danu', 'artar', 'angga', '02@', 'gm', 'ail.', 'co', 'm'];
const adminEmailDisplay = adminEmailParts.join('');
const adminEmailHref = 'mailto:' + adminEmailParts.join('');
---

<footer class="w-full bg-[surface-container-lowest] border-t border-[surface-container] text-[on-surface-variant] font-['Inter'] relative z-10">
  {variant === 'full' && (
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
      <!-- Col 1: Brand & Bio -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[primary] animate-pulse"></span>
          <span class="font-['Hanken_Grotesk'] text-lg font-bold uppercase tracking-wider text-[on-surface]">
            FRAME OF RANGGA
          </span>
        </div>
        <p class="text-sm text-[outline] leading-relaxed max-w-sm">
          A visual storytelling practice documenting human cultures, cinematic motion, bespoke design systems, and digital frontiers based in Indonesia.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[surface-container-low] hover:bg-[surface-container-high] hover:text-[primary] border border-[surface-container-highest] flex items-center justify-center transition-colors" aria-label="Instagram">
            <i class="fab fa-instagram text-sm"></i>
          </a>
          <a href="https://www.tiktok.com/@madebyrangga" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[surface-container-low] hover:bg-[surface-container-high] hover:text-[primary] border border-[surface-container-highest] flex items-center justify-center transition-colors" aria-label="TikTok">
            <i class="fab fa-tiktok text-sm"></i>
          </a>
          <a href={waLink('general')} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[surface-container-low] hover:bg-[surface-container-high] hover:text-[tertiary] border border-[surface-container-highest] flex items-center justify-center transition-colors" aria-label="WhatsApp">
            <i class="fab fa-whatsapp text-sm"></i>
          </a>
          <a href={bizEmailHref} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[surface-container-low] hover:bg-[surface-container-high] hover:text-white border border-[surface-container-highest] flex items-center justify-center transition-colors" aria-label="Email">
            <i class="fas fa-envelope text-sm"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <span class="font-['JetBrains_Mono'] text-xs text-[outline] uppercase tracking-widest font-medium">INDEX</span>
        <ul class="flex flex-col gap-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Monograph</a></li>
          <li><a href="/foto" class="hover:text-white transition-colors">Photography</a></li>
          <li><a href="/video" class="hover:text-white transition-colors">Motion & Reel</a></li>
          <li><a href="/design" class="hover:text-white transition-colors">Brand Identity</a></li>
          <li><a href="/website" class="hover:text-white transition-colors">Interactive Web</a></li>
        </ul>
      </div>

      <!-- Col 3: Disciplines -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <span class="font-['JetBrains_Mono'] text-xs text-[outline] uppercase tracking-widest font-medium">DISCIPLINES</span>
        <ul class="flex flex-col gap-2 text-sm text-[outline]">
          <li>Editorial 35mm & Medium Format</li>
          <li>Cinematic Direction & Color Grading</li>
          <li>Brand Identity Systems & Packaging</li>
          <li>Interactive WebGL & Next.js Builds</li>
          <li>High-Resolution Master Retouching</li>
        </ul>
      </div>

      <!-- Col 4: Contact & Node -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <span class="font-['JetBrains_Mono'] text-xs text-[outline] uppercase tracking-widest font-medium">STUDIO NODE</span>
        <div class="flex flex-col gap-2 text-sm">
          <a href={waLink('general')} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
            <i class="fab fa-whatsapp text-emerald-400"></i>
            <span>+62 877 795 602 64</span>
          </a>
          <a href={bizEmailHref} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
            <i class="fas fa-envelope text-blue-400"></i>
            <span class="truncate">{bizEmailDisplay}</span>
          </a>
          <div class="flex items-center gap-2 text-[outline] text-xs pt-1">
            <i class="fas fa-map-marker-alt text-red-400"></i>
            <span>DKI Jakarta & Depok, Indonesia</span>
          </div>
          <div class="pt-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[surface-container-low] border border-[surface-container-highest] font-['JetBrains_Mono'] text-[10px] text-[tertiary]">
              <span class="w-1.5 h-1.5 rounded-full bg-[tertiary] animate-pulse"></span>
              <span>Available for Q2/Q3 Commissions</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  )}

  {variant === 'minimal' && (
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[primary] animate-pulse"></span>
        <span class="font-['Hanken_Grotesk'] text-sm font-semibold uppercase tracking-wider text-[on-surface]">
          FRAME OF RANGGA
        </span>
      </div>
      <div class="flex items-center gap-4 text-xs font-['JetBrains_Mono'] text-[outline]">
        <a href="https://instagram.com/rggadnrt" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
        <span>•</span>
        <a href="https://www.tiktok.com/@madebyrangga" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">TikTok</a>
        <span>•</span>
        <a href="https://wa.me/6287779560264" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp</a>
        <span>•</span>
        <a href="/admin/login" class="hover:text-[primary] transition-colors">Portal</a>
      </div>
    </div>
  )}

  <div class="border-t border-[surface-container] py-6 px-6 text-center text-xs font-['JetBrains_Mono'] text-[outline]">
    <p>&copy; {new Date().getFullYear()} FRAME OF RANGGA • ALL RIGHTS RESERVED • MONOGRAPH v4.2</p>
  </div>
</footer>
