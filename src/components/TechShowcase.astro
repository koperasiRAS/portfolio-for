---
import { Image } from "astro:assets";
import webThumbnail from "../assets/thumbnails/web2.png";
---

<section class="tech-section" id="engineering">
  <div class="tech-inner">
    <div class="tech-header fade-up">
      <span class="tech-badge">CREATIVE ENGINEERING & CODE</span>
      <h2 class="tech-title">High-Performance Web & Digital Experiences</h2>
      <p class="tech-subtitle">
        Bridging the gap between cinematic visual aesthetics and rock-solid software architecture. Fast, responsive, and SEO-optimized.
      </p>
    </div>

    <div class="tech-grid">
      <!-- Left: Interactive Browser Mockup -->
      <div class="browser-mockup fade-up">
        <div class="browser-bar">
          <div class="browser-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="browser-address">
            <span class="browser-lock">🔒</span> https://frameofrangga.com
          </div>
          <div class="browser-badge">Astro v4.x</div>
        </div>
        <div class="browser-screen">
          <Image 
            src={webThumbnail} 
            alt="Web Development Showcase" 
            class="browser-img" 
            loading="lazy" 
          />
          <div class="browser-overlay">
            <a href="/website" class="browser-cta">
              <span>View Full Web Projects</span>
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Engineering Metrics & Tech Stack -->
      <div class="tech-details fade-up">
        <!-- Metric Cards -->
        <div class="metric-grid">
          <div class="metric-card">
            <div class="metric-score">100<span class="metric-unit">%</span></div>
            <div class="metric-label">Lighthouse Performance</div>
            <p class="metric-desc">Sub-second TTFB, zero layout shift (CLS), optimized Core Web Vitals.</p>
          </div>
          <div class="metric-card">
            <div class="metric-score">100<span class="metric-unit">%</span></div>
            <div class="metric-label">SEO & Accessibility</div>
            <p class="metric-desc">Semantic HTML5, OpenGraph metadata, structured JSON-LD data.</p>
          </div>
        </div>

        <!-- Tech Stack Pill Box -->
        <div class="stack-box">
          <h4 class="stack-title">Core Technologies & Stack</h4>
          <div class="stack-pills">
            <span class="pill"><i class="fab fa-js"></i> TypeScript / JS</span>
            <span class="pill"><i class="fas fa-rocket"></i> Astro Islands</span>
            <span class="pill"><i class="fab fa-react"></i> React / Next.js</span>
            <span class="pill"><i class="fab fa-css3-alt"></i> Modern CSS / Tokens</span>
            <span class="pill"><i class="fab fa-node-js"></i> Node.js & APIs</span>
            <span class="pill"><i class="fab fa-git-alt"></i> Git & CI/CD</span>
          </div>
        </div>

        <!-- Architecture Principles -->
        <div class="principles-box">
          <div class="principle-item">
            <span class="principle-icon">⚡</span>
            <div>
              <strong>Zero-Slop Architecture:</strong> Lightweight, modular components without bloated libraries.
            </div>
          </div>
          <div class="principle-item">
            <span class="principle-icon">📱</span>
            <div>
              <strong>Fluid Adaptability:</strong> Bespoke responsiveness crafted for mobile, tablet, & desktop.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-section {
    padding: 80px 24px;
    position: relative;
    background: var(--color-paper);
  }

  .tech-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .tech-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 3.5rem auto;
  }

  .tech-badge {
    display: inline-block;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ultramarine);
    background: rgba(36, 56, 240, 0.08);
    border: 1px solid rgba(36, 56, 240, 0.2);
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .tech-title {
    font-family: "Manrope", sans-serif;
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 800;
    color: var(--color-ink);
    line-height: 1.2;
    margin-bottom: 14px;
    letter-spacing: -1px;
  }

  .tech-subtitle {
    font-size: 15px;
    color: var(--color-mute);
    line-height: 1.7;
    margin: 0;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .tech-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Browser Mockup */
  .browser-mockup {
    background: #12161C;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(18, 22, 28, 0.12);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .browser-mockup:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px rgba(18, 22, 28, 0.18);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #1A2028;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .browser-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #E5322D; }
  .dot-yellow { background: #F4C542; }
  .dot-green { background: #22A55B; }

  .browser-address {
    font-family: monospace;
    font-size: 12px;
    color: #B8C0C8;
    background: rgba(0, 0, 0, 0.35);
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .browser-badge {
    font-size: 11px;
    font-weight: 700;
    color: #F4C542;
    background: rgba(244, 197, 66, 0.15);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .browser-screen {
    position: relative;
    overflow: hidden;
    height: 380px;
  }

  .browser-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s ease;
  }

  .browser-mockup:hover .browser-img {
    transform: scale(1.03);
  }

  .browser-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18, 22, 28, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .browser-mockup:hover .browser-overlay {
    opacity: 1;
  }

  .browser-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--color-sun);
    color: var(--color-ink);
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    transform: translateY(10px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }

  .browser-mockup:hover .browser-cta {
    transform: translateY(0);
  }

  .browser-cta:hover {
    background: #f2bd2c;
  }

  /* Metric Cards */
  .metric-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }

  .metric-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 20px;
    box-shadow: 0 2px 8px rgba(18, 22, 28, 0.03);
    transition: transform var(--transition-spring), border-color var(--transition-smooth);
  }

  .metric-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-ultramarine);
  }

  .metric-score {
    font-family: "Manrope", sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: var(--color-ink);
    line-height: 1;
    margin-bottom: 6px;
  }

  .metric-unit {
    font-size: 18px;
    color: var(--color-ultramarine);
  }

  .metric-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .metric-desc {
    font-size: 12px;
    color: var(--color-mute);
    margin: 0;
    line-height: 1.5;
  }

  /* Stack Box */
  .stack-box {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(18, 22, 28, 0.03);
  }

  .stack-title {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-mute);
    margin: 0 0 12px 0;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .pill:hover {
    background: rgba(36, 56, 240, 0.06);
    border-color: var(--color-ultramarine);
    color: var(--color-ultramarine);
  }

  /* Principles */
  .principles-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .principle-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 13.5px;
    color: var(--color-mute);
    line-height: 1.6;
  }

  .principle-item strong {
    color: var(--color-ink);
  }

  .principle-icon {
    font-size: 16px;
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
